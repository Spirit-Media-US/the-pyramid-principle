---
// The Pyramid Principle — site layout.
// Implements all 8 perf-gate traits structurally:
//   Trait 2: <slot name="head"> carries the per-page hero preload
//   Trait 4: 3 brand fonts self-hosted from R2, 2 preloaded here, font-display: optional
//   Trait 5: deferred GA pattern stays commented until GTM ID is wired
//   Trait 6: astro.config inlineStylesheets:'auto' + async-css postbuild
//   Trait 7: header here is structural; hero markup on each page must omit data-aos / reveal wrappers
//   Trait 8: <img> elements always have width / height
import HundredClubBadge from '../components/HundredClubBadge.astro';
import { srcW } from '../lib/img';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  noindex?: boolean;
}
const {
  title,
  description = 'The Pyramid Principle — a heart-gripping true story of championship resilience, based on the life of Hall-of-Famer John Vallely.',
  ogImage = 'https://cdn.sanity.io/images/uenxsjdw/production/8a986bc4ecba2ae393ae209bd73681179fdb14f8-1024x502.png',
  noindex = false,
} = Astro.props;

const SITE_NAME = 'The Pyramid Principle';
const LOGO_URL = 'https://cdn.sanity.io/images/uenxsjdw/production/8a986bc4ecba2ae393ae209bd73681179fdb14f8-1024x502.png';

const currentYear = new Date().getFullYear();
const siteOrigin = (Astro.site && Astro.site.toString().replace(/\/$/, '')) || '';
const canonicalURL = siteOrigin ? new URL(Astro.url.pathname, siteOrigin).href : Astro.url.pathname;

// Nav active-state: normalize trailing slash for comparison.
const currentPath = Astro.url.pathname.replace(/\/+$/, '') + '/';
const isActive = (href: string) => href.replace(/\/+$/, '') + '/' === currentPath;

const PRIMARY_NAV = [
  {
    label: 'About', href: '/john-vallely/',
    sub: [
      { label: 'John Vallely', href: '/john-vallely/' },
      { label: 'Paul Weissenstein', href: '/paul-weissenstein/' },
      { label: 'Coach John Wooden', href: '/coach-john-wooden/' },
    ],
  },
  { label: 'Retailers', href: '/retailers/' },
  { label: 'The Pyramid Success', href: '/the-pyramid-success/' },
  { label: 'Give Courage', href: '/give-courage/' },
];

const SOCIAL = [
  { name: 'Instagram', href: 'https://www.instagram.com/thepyramidprinciple/', icon: 'M7 2a5 5 0 00-5 5v10a5 5 0 005 5h10a5 5 0 005-5V7a5 5 0 00-5-5H7zm10 2a3 3 0 013 3v10a3 3 0 01-3 3H7a3 3 0 01-3-3V7a3 3 0 013-3h10zm-5 3a5 5 0 100 10 5 5 0 000-10zm0 2a3 3 0 110 6 3 3 0 010-6zm5.5-2.5a1 1 0 100 2 1 1 0 000-2z' },
  { name: 'Facebook', href: 'https://www.facebook.com/people/The-Pyramid-Principle/61567865841471/', icon: 'M22 12a10 10 0 10-11.56 9.88v-7H8v-2.88h2.44V9.84c0-2.41 1.43-3.74 3.62-3.74 1.05 0 2.15.19 2.15.19v2.36h-1.21c-1.19 0-1.56.74-1.56 1.5v1.8h2.66l-.43 2.88h-2.23v7A10 10 0 0022 12z' },
  { name: 'X', href: 'https://x.com/tppbook', icon: 'M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z' },
  { name: 'LinkedIn', href: 'http://www.linkedin.com/company/the-pyramid-principle', icon: 'M20.5 2h-17A1.5 1.5 0 002 3.5v17A1.5 1.5 0 003.5 22h17a1.5 1.5 0 001.5-1.5v-17A1.5 1.5 0 0020.5 2zM8 19H5v-9h3zM6.5 8.25A1.75 1.75 0 118.3 6.5a1.75 1.75 0 01-1.8 1.75zM19 19h-3v-4.74c0-1.42-.6-1.93-1.38-1.93A1.74 1.74 0 0013 14.19V19h-3v-9h2.9v1.3a3.11 3.11 0 012.7-1.4c1.55 0 3.36.86 3.36 3.66z' },
  { name: 'TikTok', href: 'https://www.tiktok.com/@thepyramidprinciple', icon: 'M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-5.2 1.74 2.89 2.89 0 012.31-4.64 2.93 2.93 0 01.88.13V9.4a6.84 6.84 0 00-1-.06A6.33 6.33 0 005.8 20.1a6.34 6.34 0 0010.86-4.43V8.94a8.16 8.16 0 004.77 1.52V7a4.85 4.85 0 01-1.84-.31z' },
  { name: 'YouTube', href: 'https://www.youtube.com/@ThePyramidPrinciple', icon: 'M23.5 6.2a3 3 0 00-2.1-2.1C19.6 3.5 12 3.5 12 3.5s-7.6 0-9.4.6A3 3 0 00.5 6.2C0 8 0 12 0 12s0 4 .5 5.8a3 3 0 002.1 2.1c1.8.6 9.4.6 9.4.6s7.6 0 9.4-.6a3 3 0 002.1-2.1C24 16 24 12 24 12s0-4-.5-5.8zM9.6 15.6V8.4l6.4 3.6z' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <title>{title}</title>
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <link rel="preload" as="font" type="font/woff2" href="https://assets.spiritmediapublishing.com/fonts/bebas-neue/bebas-neue-400.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="https://assets.spiritmediapublishing.com/fonts/dm-sans/dm-sans-700.woff2" crossorigin />

    <link rel="preconnect" href="https://cdn.sanity.io" crossorigin />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Book",
      "name": "The Pyramid Principle",
      "author": [
        { "@type": "Person", "name": "John Vallely" },
        { "@type": "Person", "name": "Paul Weissenstein" }
      ],
      "publisher": { "@type": "Organization", "name": "Spirit Media", "url": "https://spiritmediapublishing.com" },
      "image": ogImage,
      "url": canonicalURL,
      "description": description,
    })}></script>

    <slot name="head" />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to main content</a>

    <!-- Header — single row on bg #F5F5F5; no yellow tagline bar above.
         Logo (left) · Social icons (center, plain glyphs) · Nav (right, ABOUT
         dropdown). Verified against the live DOM at /tpp/ on 2026-05-11. -->
    <header id="site-header">
      <div class="header-row">
        <a href="/" aria-label="The Pyramid Principle home" class="header-logo">
          <img src={LOGO_URL} alt="The Pyramid Principle" width="190" height="93" />
        </a>

        <ul class="header-social" aria-label="Social media">
          {SOCIAL.map(s => (
            <li>
              <a href={s.href} target="_blank" rel="noopener noreferrer" aria-label={s.name}>
                <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={s.icon} /></svg>
              </a>
            </li>
          ))}
        </ul>

        <nav class="primary-nav" aria-label="Primary">
          {PRIMARY_NAV.map(item => {
            const subActive = item.sub && item.sub.some(s => isActive(s.href));
            const itemActive = !item.sub && isActive(item.href);
            return item.sub ? (
              <div class={`nav-item nav-dropdown${subActive ? ' is-active' : ''}`}>
                <button type="button" class="nav-link">{item.label} <span class="caret" aria-hidden="true">▾</span></button>
                <ul class="nav-submenu">
                  {item.sub.map(s => (
                    <li>
                      <a href={s.href}
                         class={isActive(s.href) ? 'is-active' : ''}
                         aria-current={isActive(s.href) ? 'page' : undefined}>{s.label}</a>
                    </li>
                  ))}
                </ul>
              </div>
            ) : (
              <a href={item.href}
                 class={`nav-link${itemActive ? ' is-active' : ''}`}
                 aria-current={itemActive ? 'page' : undefined}>{item.label}</a>
            );
          })}
        </nav>

        <button type="button" id="mobile-menu-btn" class="mobile-menu-btn" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M4 6h16M4 12h16M4 18h16" /></svg>
        </button>
      </div>

      <nav id="mobile-menu" class="mobile-menu" aria-label="Mobile">
        {PRIMARY_NAV.map(item => {
          const subActive = item.sub && item.sub.some(s => isActive(s.href));
          const itemActive = !item.sub && isActive(item.href);
          return item.sub ? (
            <details class={`mobile-nav-item${subActive ? ' is-active' : ''}`} open={subActive}>
              <summary>{item.label} <span aria-hidden="true">▾</span></summary>
              <ul>
                {item.sub.map(s => (
                  <li>
                    <a href={s.href}
                       class={isActive(s.href) ? 'is-active' : ''}
                       aria-current={isActive(s.href) ? 'page' : undefined}>{s.label}</a>
                  </li>
                ))}
              </ul>
            </details>
          ) : (
            <a href={item.href}
               class={`mobile-nav-link${itemActive ? ' is-active' : ''}`}
               aria-current={itemActive ? 'page' : undefined}>{item.label}</a>
          );
        })}
        <ul class="mobile-social" aria-label="Social media">
          {SOCIAL.map(s => (
            <li>
              <a href={s.href} target="_blank" rel="noopener noreferrer" aria-label={s.name}>
                <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={s.icon} /></svg>
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </header>

    <slot />

    <!-- Site footer — verified DOM walk of #brx-footer:
         Top section #brxe-mkbdep: bg #F7F7F7, padding 40px 0, 3 columns
           Col 1: TPP logo wordmark + tagline
           Col 2: Publisher block (SMP logo + address + Contact Spirit Media)
                  [In the News/BLOGS/SOCIAL FEEDS H3+H6s present in source but
                  display:none — not rendered. Logged for Phase 5 CAR.]
           Col 3: Give Courage banner image + H3 + PINK pill button
         Bottom section #brxe-fghmmc: bg #F7F7F7, padding 20px 0
           H6 copyright (year switched to dynamic per user direction; source
           hardcoded 2024)
           H6 "Design by Spirit Media" with link -->
    <footer id="site-footer" class="site-footer">
      <section class="footer-top">
        <div class="footer-top-grid">
          <div class="footer-col footer-col-logo">
            <img src={LOGO_URL} alt="The Pyramid Principle" width="190" height="115" loading="lazy" decoding="async" class="footer-logo" />
            <p class="footer-tagline">A Battle Tested Hall-of-Famer and his Daughter Discover Coach Wooden's Meaning of Success</p>
          </div>

          <div class="footer-col footer-col-publisher">
            <p class="footer-published-line">Published Worldwide by:</p>
            <a href="https://spiritmediapublishing.com/" class="footer-smp-logo" aria-label="Spirit Media Publishing">
              <img src={srcW('image-2-2.png', 300)}
                   width="182" height="28"
                   alt="Spirit Media Publishing"
                   loading="lazy" decoding="async" />
            </a>
            <address class="footer-address">
              8045 Arco Corporate Dr STE 130<br />
              Raleigh, NC 27617<br />
              <a href="tel:+18888003744">1 (888) 800-3744</a>
            </address>
            <a class="footer-contact-link" href="https://spiritmediapublishing.com/request-a-call/">Contact Spirit Media</a>
          </div>

          <div class="footer-col footer-col-courage">
            <a href="/give-courage/" class="footer-banner-link" aria-label="Give the Gift of Courage to 400,000 families fighting cancer">
              <img src={srcW('Banner-THE-GIFT-OF-COURAGE-1024x258.jpg', 600)}
                   width="300" height="86"
                   alt="A Gift of Courage Banner"
                   loading="lazy" decoding="async" />
            </a>
            <h3 class="footer-courage-h3">GIVE THE GIFT OF COURAGE TO 400,000 Families fighting CAncer…</h3>
            <a class="footer-courage-cta" href="/give-courage/">Give Courage</a>
          </div>
        </div>
      </section>

      <section class="footer-bottom">
        <div class="footer-bottom-row">
          <p class="footer-copy-line">© {currentYear} {SITE_NAME}. All rights reserved. · Powered by <a href="https://spiritmediapublishing.com/">Spirit Media</a> <HundredClubBadge /></p>
        </div>
      </section>
    </footer>

    <script is:inline>
      document.addEventListener('click', (e) => {
        const btn = e.target.closest('#mobile-menu-btn');
        if (!btn) return;
        const menu = document.getElementById('mobile-menu');
        const open = menu.classList.contains('open');
        menu.classList.toggle('open');
        btn.setAttribute('aria-expanded', String(!open));
      });
    </script>
  </body>
</html>

<style is:global>
  @layer base {
    .skip-link {
      position: absolute;
      left: -9999px;
      top: 0;
      padding: 8px 12px;
      background: var(--color-brand-yellow);
      color: var(--color-ink);
      z-index: 100;
    }
    .skip-link:focus { left: 0; }

    /* ── Site header — single row on bg #F5F5F5 ──────────────── */
    #site-header {
      background: var(--color-bg-section);
    }
    .header-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 24px;
      padding: 16px var(--section-padding-x-mobile);
      max-width: var(--container-max);
      margin-inline: auto;
    }
    @media (min-width: 768px) {
      .header-row { padding: 20px var(--section-padding-x-desktop); }
    }

    /* LEFT — logo */
    .header-logo { flex-shrink: 0; display: inline-block; }
    .header-logo img { height: 64px; width: auto; display: block; }
    @media (min-width: 1024px) {
      .header-logo img { height: 88px; }
    }

    /* CENTER — social icons (mobile: hide; desktop: between logo and nav) */
    .header-social {
      display: none;
      list-style: none;
      padding: 0;
      margin: 0;
      gap: 14px;
      align-items: center;
    }
    @media (min-width: 1024px) {
      .header-social { display: flex; }
    }
    .header-social a {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 28px;
      height: 28px;
      color: var(--color-ink-soft);
      transition: color 0.15s ease;
    }
    .header-social a:hover {
      color: var(--color-brand-yellow);
      text-decoration: none;
    }

    /* RIGHT — primary nav */
    .primary-nav {
      display: none;
      gap: 28px;
      align-items: center;
    }
    @media (min-width: 1024px) {
      .primary-nav { display: flex; }
    }

    .nav-link {
      font-family: var(--font-heading);
      font-weight: 400;
      color: var(--color-ink-soft);
      font-size: 18px;
      letter-spacing: 0;
      text-transform: uppercase;
      padding: 8px 0;
      background: none;
      border: none;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 4px;
    }
    .nav-link:hover { color: var(--color-brand-yellow); text-decoration: none; }
    .nav-link.is-active,
    .nav-dropdown.is-active > .nav-link { color: var(--color-author-blue, #2774AE); }
    .caret { font-size: 0.75em; }

    .nav-dropdown { position: relative; }
    .nav-submenu {
      position: absolute;
      top: 100%;
      left: 0;
      min-width: 220px;
      background: var(--color-bg-section);
      border: 1px solid var(--color-border);
      padding: 8px 0;
      list-style: none;
      margin: 0;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.15s;
      z-index: 50;
    }
    .nav-dropdown:hover .nav-submenu,
    .nav-dropdown:focus-within .nav-submenu {
      opacity: 1;
      pointer-events: auto;
    }
    .nav-submenu a {
      display: block;
      padding: 10px 20px;
      font-family: var(--font-heading);
      font-weight: 400;
      color: var(--color-ink-soft);
      font-size: 16px;
      text-transform: uppercase;
    }
    .nav-submenu a:hover { background: #fff; text-decoration: none; color: var(--color-brand-yellow); }
    .nav-submenu a.is-active { color: var(--color-author-blue, #2774AE); }

    /* Mobile menu */
    .mobile-menu-btn {
      display: inline-flex;
      background: none;
      border: none;
      padding: 8px;
      cursor: pointer;
      color: var(--color-ink-soft);
    }
    .mobile-menu {
      display: none;
      border-top: 1px solid var(--color-border);
      padding: 16px 20px 24px;
      background: var(--color-bg-section);
    }
    .mobile-menu.open { display: block; }
    @media (min-width: 1024px) {
      .mobile-menu-btn { display: none; }
      .mobile-menu { display: none !important; }
    }

    .mobile-menu details { margin-bottom: 8px; }
    .mobile-menu summary {
      font-family: var(--font-heading);
      font-weight: 400;
      color: var(--color-ink-soft);
      padding: 10px 0;
      cursor: pointer;
      list-style: none;
      text-transform: uppercase;
      letter-spacing: 0;
      font-size: 18px;
    }
    .mobile-menu summary::-webkit-details-marker { display: none; }
    .mobile-menu details ul {
      list-style: none;
      padding: 4px 0 8px 16px;
      margin: 0;
    }
    .mobile-menu details a,
    .mobile-menu .mobile-nav-link {
      display: block;
      padding: 8px 0;
      font-family: var(--font-heading);
      font-weight: 400;
      color: var(--color-ink-soft);
      font-size: 16px;
      text-transform: uppercase;
    }
    .mobile-menu .mobile-nav-link {
      padding: 10px 0;
      font-size: 18px;
    }
    .mobile-menu details a.is-active,
    .mobile-menu .mobile-nav-link.is-active { color: var(--color-author-blue, #2774AE); }
    .mobile-social {
      display: flex;
      list-style: none;
      padding: 16px 0 0;
      margin: 16px 0 0;
      gap: 16px;
      border-top: 1px solid var(--color-border);
    }
    .mobile-social a {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 28px;
      height: 28px;
      color: var(--color-ink-soft);
    }

    /* Footer social — keep the dark-circle treatment (footer is on dark bg) */
    .social-icon {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 40px;
      height: 40px;
      border: 1px solid #444;
      border-radius: 50%;
      transition: background 0.15s, color 0.15s, border-color 0.15s;
      color: #fff;
    }
    .social-icon:hover {
      background: var(--color-brand-yellow);
      color: var(--color-ink);
      border-color: var(--color-brand-yellow);
      text-decoration: none;
    }

    /* Site footer — verified live DOM (#brx-footer):
       Top section: bg #F7F7F7, padding 40px 0, 3-column grid
       Bottom section: bg #F7F7F7, padding 20px 0 */
    .site-footer { background: #F7F7F7; color: var(--color-text); }
    .footer-top { background: #F7F7F7; padding: 40px 20px; }
    @media (min-width: 768px) { .footer-top { padding: 40px var(--section-padding-x-desktop); } }
    .footer-top-grid {
      max-width: var(--container-max);
      margin-inline: auto;
      display: grid;
      grid-template-columns: 1fr;
      gap: 40px;
      align-items: start;
    }
    @media (min-width: 1024px) {
      .footer-top-grid { grid-template-columns: 1fr 1fr 1fr; gap: 24px; }
    }
    .footer-col { display: flex; flex-direction: column; gap: 16px; }
    .footer-col-logo { gap: 24px; }
    .footer-logo { width: 190px; height: auto; }
    .footer-tagline {
      margin: 0;
      font-family: var(--font-heading);
      font-size: 0.9375rem;
      line-height: 1.4;
      color: var(--color-text);
      max-width: 380px;
    }

    .footer-col-publisher { gap: 4px; }
    .footer-published-line {
      margin: 0;
      font-family: var(--font-heading);
      font-size: 0.95rem;
      color: var(--color-text);
    }
    .footer-smp-logo { display: inline-block; margin: 4px 0 8px; }
    .footer-smp-logo img { width: 182px; height: auto; display: block; }
    .footer-address {
      margin: 0 0 12px;
      font-style: normal;
      font-family: var(--font-heading);
      font-size: 0.95rem;
      line-height: 1.6;
      color: var(--color-text);
    }
    .footer-address a { color: var(--color-text); text-decoration: none; }
    .footer-address a:hover { color: var(--color-ink); }
    .footer-contact-link {
      align-self: flex-start;
      color: var(--color-publisher-gold); /* #CAA949 per DOM */
      font-family: var(--font-heading);
      font-size: 0.95rem;
      text-decoration: underline;
    }
    .footer-contact-link:hover { color: var(--color-ink); text-decoration: underline; }

    .footer-col-courage { gap: 14px; align-items: flex-start; }
    .footer-banner-link { display: block; }
    .footer-banner-link img {
      width: 100%;
      max-width: 300px;
      height: auto;
      display: block;
    }
    .footer-banner-link:hover { opacity: 0.92; text-decoration: none; }
    .footer-courage-h3 {
      margin: 0;
      font-family: var(--font-display); /* Bebas Neue per DOM */
      font-weight: 400;
      font-size: 1.5rem; /* 25px per live DOM */
      line-height: 1.15;
      color: var(--color-ink);
      text-transform: none;
    }
    /* Give Courage CTA — verified live DOM: bg PINK rgb(249,153,203),
       padding 8px 16px, 1px border rgba(33,33,33,.26), border-radius 10px */
    .footer-courage-cta {
      display: inline-flex;
      align-items: center;
      background: var(--color-cause-pink); /* #F999CB */
      color: var(--color-ink);
      font-family: var(--font-heading);
      font-weight: 700;
      font-size: 0.875rem;
      letter-spacing: 0.02em;
      padding: 8px 16px;
      border: 1px solid rgba(33, 33, 33, 0.26);
      border-radius: 10px;
