---
import Layout from '../layouts/Layout.astro';
import StructuredPage from '../components/StructuredPage.astro';
import { srcW, dims } from '../lib/img';
import data from '../data/pages/the-pyramid-success.json';

const HERO = 'Untitled-design-2.png';
const heroMobile = srcW(HERO, 500);
const heroDesktop = srcW(HERO, 800);
---
<Layout title={data.title} description={data.description} ogImage={heroDesktop}>
  <Fragment slot="head">
    <link rel="preload" as="image" href={heroDesktop} imagesrcset={`${heroMobile} 500w, ${heroDesktop} 800w`} imagesizes="(max-width: 640px) 500px, 800px" fetchpriority="high" />
  </Fragment>
  <article class="page-body">
    <StructuredPage blocks={data.blocks as any} heroFile={HERO} />
  </article>
</Layout>
