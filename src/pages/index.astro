    gap: 24px;
    align-items: flex-start;
    min-width: 0;
  }
  /* Photo + offset blue rectangle backdrop. Offsets sized so the composition
     stays contained inside the card padding (left ~40px, top ~40px) — no
     bleed past the card border. */
  .wooden-img-frame {
    position: relative;
    width: 100%;
    max-width: 480px;
    margin-top: 40px;
    margin-left: 40px;
  }
  @media (max-width: 768px) {
    .wooden-img-frame { margin-top: 24px; margin-left: 24px; max-width: 100%; }
  }
  .wooden-img-frame::before {
    content: "";
    position: absolute;
    top: -40px;
    left: -40px;
    width: 100%;
    height: 100%;
    background: var(--color-author-blue); /* UCLA blue rgb(39,116,174) */
    z-index: 0;
