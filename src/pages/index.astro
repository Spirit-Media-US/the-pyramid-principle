---
// Homepage — two-column hero matching the live /tpp/ first .brxe-section,
// then the rest of the page body (slice 23+) rendered by StructuredPage.
//
// Hero block mapping (indices in src/data/pages/home.json):
//   0  H2  "Global #1 Bestseller"  → blue ribbon-badge top-left
//   1  H1  "A Gift of Courage!"    → main display heading
//   2  P   Pyramid Principle / John Vallely intro
//   3  P   Join generous partners / cancer
//   4  H2  "Available Everywhere Books are Sold!"
//   5-10 IMG  6 retailer logos
//   11 P   Limited Time Only! + register-your-order text
//   12 CTA "The Pyramid Principle Audiobook or eBook"  (yellow button)
//   13-18 H3  PAGES / 238 pages / LANGUAGE / English / RATINGS / 5/5 ratings
//   19 H1  "A Gift of Courage!"   → mobile-only variant (display:none on desktop)
//   20 CTA "In The News"          → /media-center/  (yellow pill)
//   21 CTA "Reviews"              → /reviews/       (yellow pill)
//   22 IMG  3D-Book-1-886x1024.png → right-column hero, LCP element
import Layout from '../layouts/Layout.astro';
import StructuredPage from '../components/StructuredPage.astro';
import LogoCarousel from '../components/LogoCarousel.astro';
import { srcW, dims } from '../lib/img';
import data from '../data/pages/home.json';

const HERO = '3D-Book-1-886x1024.png';
const heroMobile = srcW(HERO, 600);
const heroDesktop = srcW(HERO, 1000);
const heroDims = dims(HERO);

// Retailer logos with destination links (same set the original uses)
const RETAILERS = [
  { file: 'amazon-logo-amazon-icon-transparent-free-png.webp',                                                  name: 'Amazon',          href: 'https://a.co/d/haMqgDu' },
  { file: 'Barnes-Noble-Logo-1-1024x576.png',                                                                   name: 'Barnes & Noble',  href: 'https://www.barnesandnoble.com/' },
  { file: 'Books-A-Million_logo.png',                                                                           name: 'Books-A-Million', href: 'https://www.booksamillion.com/' },
  { file: '66df2a7dd732dd581f52b748_Bookshop-Logo-Wide-removebg-preview-1024x154.png',                          name: 'Bookshop.org',    href: 'https://bookshop.org/' },
  { file: 'thriftbooks-logo_orig-removebg-preview-e1728065953313.png',                                          name: 'ThriftBooks',     href: 'https://www.thriftbooks.com/' },
  { file: 'Walmart-Logo.wine_-1024x683.png',                                                                    name: 'Walmart',         href: 'https://www.walmart.com/' },
];

// Hand-rendered blocks 0..70: hero (0-22), Heart-Gripping section (23-27),
// press-carousel (28), "The Story" two-column (29-32), "Based on the Life
// of John Vallely with Paul Weissenstein" three-column (33-39),
// "Free Resources + Cori Close endorsement" (40-48), "Highlights from
// The Book" three-column (49-67), Wooden quote two-column (68-70).
// StructuredPage takes 71+.
const CUSTOM_BLOCK_COUNT = 71;
const restBlocks = data.blocks.slice(CUSTOM_BLOCK_COUNT);

// Block 27 — Give Courage banner image (links to /give-courage/)
const GIVE_COURAGE_BANNER = 'Banner-THE-GIFT-OF-COURAGE-1024x258.jpg';

// Block 28 — press-carousel data (slides with file + href)
const pressCarousel = data.blocks[28] as { tag: string; ariaLabel?: string; slides: { file: string; href: string }[] };

// "The Story" section assets — block 29 (small graphic), block 30 (portrait),
// block 31 (H2 heading), block 32 (combined body text — Bricks renders as
// one block but splits into 3 paragraphs visually).
const STORY_GRAPHIC  = 'Untitled-design-3.png';
const STORY_PORTRAIT = 'Capture.jpg';
const STORY_H2 = data.blocks[31].text || 'The Story';
const STORY_PARAGRAPHS = [
  "A desperate father must revisit the timeless Pyramid Principles of his iconic coach, in order to confront the battles he and his nine-year-old daughter face with death and life.",
  "1969 and John Vallely is living his dream. He is chosen to play basketball on the number one college team in the country, with the number one player in the country, for the number one coach of all time! It doesn't get any better than that! What John doesn't realize is the lessons he is learning from Coach Wooden, one of the greatest teachers of all time, will carry him through the incredible trials and triumphs of his life. It's one thing to be a champion on the court, it's something else to be a champion at life.",
  "Fast forward 15 years and John is married to his college sweetheart, Karen, with two beautiful children, Eric, 13 and Erin, 9, and still living his dream as a successful businessman in his hometown of Newport Beach, California. The dream is suddenly shattered when the small bump on Erin's side turns out to be much more serious than just another soccer injury. Pediatric cancer, the hideous villain that has ravaged the lives of so many children before her, has now come for Erin. With his world suddenly torn apart, John turns to his lifelong mentor and friend, Coach Wooden to help him face the greatest trial of his life. By following the principles of Coach Wooden's legendary Pyramid of Success, John finds strength and a new purpose. With the grace of God, he builds a legacy by helping countless children conquer this horrific disease, through his involvement with The Pediatric Cancer Research Foundation, and “Dribble for Victory Over Cancer.”",
];

// Block 33 — H6 eyebrow text inside the blue ribbon band
const BASED_EYEBROW = data.blocks[33].text || 'A Heart-Gripping Story of Heroic Love and Legacy';
// Block 34 — H2 (left col)
const BASED_H2 = data.blocks[34].text || 'Based on the Life of John Vallely with Paul Weissenstein';
// Block 35 — H4 (center col)
const BASED_H4 = data.blocks[35].text || 'A Battle-Tested Hall-of-Famer Discovers UCLA Coach John Wooden’s True Meaning of Success';
// Block 36 — body P (center col)
const BASED_BODY = data.blocks[36].text || '';
// Blocks 37/38/39 — collage images (verified order from live DOM)
const BASED_IMG_TOP = 'valley_110.jpg';        // 875x700 source, top of collage
const BASED_IMG_BL  = 'wooden-large-retina.jpg'; // 720x720 source, bottom-left
const BASED_IMG_BR  = 'valley_109.jpg';         // 562x700 source, bottom-right

// ── Blocks 40-48 — Free Resources + Cori Close endorsement ──
const FREE_RES_H2  = data.blocks[40].text || 'Free Resources from The Pyramid Principle';
const PDF_SAMPLE   = data.blocks[41]; // CTA
const BOOK_CLUB    = data.blocks[42]; // CTA
const PYRAMID_LINK = data.blocks[43]; // CTA
// Block 44 — iframe (YouTube). Source wraps in <a href=pacdora.com> — DROPPED
// per Phase 3 'don't import broken patterns' direction. Flagged for Phase 5 CAR.
const CORI_H2          = data.blocks[45].text || "UCLA's Coach Cori Close Applauds The Pyramid Principle by John Vallely";
const CORI_QUOTE       = data.blocks[46].text || '';
const CORI_ATTRIBUTION = data.blocks[47].text || '— Coach Cori Close';
const ORDER_CTA        = data.blocks[48]; // CTA "Order Today!"

// ── Blocks 49-67 — "Highlights from The Book" three-column section ──
// Block 49: decorative book image (rendered in col 3)
// Block 50: H2 "Highlights from The Book"
// Blocks 51-57: 7 paragraphs (col 1)
// Block 58: CTA "Order Today!" (col 1 button)
// Blocks 59-66: 8 paragraphs (col 2)
// Block 67: CTA "Order Today!" (col 2 button — DOM has 0x0, but spec asks for it)
const HIGHLIGHTS_DECOR = 'image-e1726579729174.png';
const HIGHLIGHTS_H2 = data.blocks[50].text || 'Highlights from The Book';
const HIGHLIGHTS_COL1 = data.blocks.slice(51, 58).map(b => b.text);
const HIGHLIGHTS_COL1_CTA = data.blocks[58]; // CTA
const HIGHLIGHTS_COL2 = data.blocks.slice(59, 67).map(b => b.text);
const HIGHLIGHTS_COL2_CTA = data.blocks[67]; // CTA

// ── Blocks 68-70 — Wooden Quote two-column section ──
// Block 68: image 289468.0-1024x683.jpg (originally wrapped in pacdora.com
//   link in source — same broken link as the Free Resources YouTube; dropped)
// Block 69: blockquote text (was H2 in source; reclassified for semantic)
// Block 70: attribution (was H2 in source; reclassified to p+role:cite)
const WOODEN_IMG  = '289468.0-1024x683.jpg';
const WOODEN_QUOTE = data.blocks[69].text || '"Things turn out best for those who make the best of the way things turn out."';
const WOODEN_CITE  = data.blocks[70].text || '~ Coach John Wooden';
---
<Layout title={data.title} description={data.description} ogImage={heroDesktop}>
  <Fragment slot="head">
    <!-- T1/T2/T8: literal srcset widths the auditor can parse, fetchpriority high -->
    <link
      rel="preload"
      as="image"
      href={heroDesktop}
      imagesrcset={`${heroMobile} 600w, ${heroDesktop} 1000w`}
      imagesizes="(max-width: 640px) 600px, 1000px"
      fetchpriority="high"
    />
  </Fragment>

  <!-- ── HERO ── Two-column layout matching the original /tpp/ first .brxe-section.
       Background #F5F5F5 (same as header). No data-aos / reveal wrappers on this section. -->
  <section id="pre-order-now" class="home-hero">
    <div class="home-hero-grid">

      <!-- ── LEFT COLUMN ── -->
      <div class="hero-left">
        <!-- Blue ribbon badge (live DOM: rgb(39, 116, 174) — UCLA blue, NOT yellow) -->
        <div class="ribbon-badge">
          <h2>Global #1 Bestseller</h2>
        </div>

        <!-- Desktop H1; mobile H1 lives at the bottom of the right column -->
        <h1 class="hero-h1 hero-h1-desktop">"A Gift of Courage!"</h1>

        <p class="hero-p">The Pyramid Principle is based on the true and never before told story of Hall-of-Famer John Vallely.</p>
        <p class="hero-p">Join generous partners in sharing courage with families fighting cancer. Together, let's empower them with victory over cancer. Give Courage at aGiftofCourage.org All gifts tax deductible. Every contribution makes a real difference in lifting spirits, bringing courage, and empowering victory over cancer.</p>

        <h2 class="hero-h2">Available Everywhere Books are Sold!</h2>
        <div class="hero-retailer-grid">
          {RETAILERS.map(r => (
            <a href={r.href} target="_blank" rel="noopener noreferrer" aria-label={r.name} class="retailer-card">
              <img src={srcW(r.file, 240)} alt={r.name} width="240" height="80" loading="lazy" decoding="async" />
            </a>
          ))}
        </div>

        <p class="hero-ltm"><strong>Limited Time Only!</strong> Register your order number and receive a FREE copy of</p>
        <a class="yellow-cta" href="https://mail.spiritmediaone.com/widget/form/yCx08A8Jx9uM9cnwJP2c" target="_blank" rel="noopener noreferrer">The Pyramid Principle Audiobook or eBook</a>

        <!-- Three stat groups, each with an icon + 2 H3s (label + value) -->
        <div class="hero-stats">
          <div class="stat">
            <svg class="stat-icon" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M3 5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v2a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5zm0 6a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v2a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-2zm2 4a2 2 0 0 0-2 2v2a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-2a2 2 0 0 0-2-2H5z"/></svg>
            <div>
              <h3>PAGES</h3>
              <h3>238 pages</h3>
            </div>
          </div>
          <div class="stat">
            <svg class="stat-icon" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M4 2v20h2v-8h13l-2-4 2-4H6V2H4z"/></svg>
            <div>
              <h3>LANGUAGE</h3>
              <h3>English</h3>
            </div>
          </div>
          <div class="stat">
            <svg class="stat-icon" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2l2.39 7.36H22l-6.18 4.49L18.21 22 12 17.27 5.79 22l2.39-8.15L2 9.36h7.61L12 2z"/></svg>
            <div>
              <h3>RATINGS</h3>
              <h3>5/5 ratings</h3>
            </div>
          </div>
        </div>
      </div>

      <!-- ── RIGHT COLUMN ── -->
      <div class="hero-right">
        <!-- Two yellow pill buttons above the book image -->
        <div class="hero-pill-row">
          <a class="pill-cta" href="/media-center/">In The News</a>
          <a class="pill-cta" href="/reviews/">Reviews</a>
        </div>

        <!-- Mobile-only second H1 (display:none on desktop). Matches the live
             source which emits two H1s for responsive variants. Both must
             appear to satisfy the heading-parity contract. -->
        <h1 class="hero-h1 hero-h1-mobile">"A Gift of Courage!"</h1>

        <!-- LCP element. Trait 1 srcset (600w + 1000w, fm=webp); Trait 2 preload
             above in slot=head; Trait 8 explicit width/height. -->
        <img
          src={heroDesktop}
          srcset={`${heroMobile} 600w, ${heroDesktop} 1000w`}
          sizes="(max-width: 640px) 600px, 1000px"
          width={heroDims.width}
          height={heroDims.height}
          alt="The Pyramid Principle — 3D book cover"
          fetchpriority="high"
          loading="eager"
          decoding="async"
          class="hero-book-img"
        />
      </div>
    </div>
  </section>

  <!-- ── Section 2 — Heart-Gripping Story + 3 pill CTAs + Give Courage banner ──
       Matches the live second .brxe-section (post-hero). Bg is transparent
       (page body white shows through). Block indices 23..27 of home.json. -->
  <section class="hgs-section">
    <div class="hgs-container">
      <h2 class="hgs-heading">A Heart-Gripping Story of Championship Resilience in Life's Toughest Battles.</h2>

      <div class="hgs-pills">
        <a class="pill-cta" href="https://mail.spiritmediaone.com/widget/form/7w74pwgesuoL89IGH8BM" target="_blank" rel="noopener noreferrer">Request a Copy</a>
        <a class="pill-cta" href="/give-courage/">Sponsor Copies</a>
        <a class="pill-cta" href="https://docs.google.com/forms/d/e/1FAIpQLSdKQls4n_vob9RP2R9X787mAvLw0h5WCW_Q-O3Aeh-PHtkdeg/viewform" target="_blank" rel="noopener noreferrer">Review the Book</a>
      </div>

      <!-- Pre-designed banner image — wrapped in a link to /give-courage/.
           User direction: render this as the single image asset, do NOT
           compose from separate elements. -->
      <a href="/give-courage/" class="give-courage-banner-link" aria-label="Give the Gift of Courage to 400,000 families fighting cancer">
        <img src={srcW(GIVE_COURAGE_BANNER, 1200)}
             srcset={`${srcW(GIVE_COURAGE_BANNER, 600)} 600w, ${srcW(GIVE_COURAGE_BANNER, 1200)} 1200w`}
             sizes="(max-width: 640px) 600px, 1200px"
             width="1024" height="258"
             alt="Give the Gift of Courage to 400,000 families fighting cancer"
             loading="lazy" decoding="async" />
      </a>
    </div>
  </section>

  <!-- Block 28 — press-carousel via Splide.js (LogoCarousel). Section is
       full-bleed; component handles the 100vw breakout. -->
  <LogoCarousel slides={pressCarousel.slides} ariaLabel={pressCarousel.ariaLabel || 'Press coverage'} altPattern="Press coverage" fullBleed={true} />

  <!-- Blocks 29-32 — "The Story" two-column section.
       Left: stacked images (small graphic over portrait). Right: H2 + yellow
       100×2 divider + 3 body paragraphs. Bg #F5F5F5. Animations: fadeIn on
       the left block (1s, 0.5s delay), zoomIn on the portrait, fadeInRight
       on the right column. JS deferred until first user interaction. -->
  <section class="story-section">
    <div class="story-grid">
      <!-- Image composition: photo as the base + decorative L-corner ornament
           absolutely positioned over its top-left. NOT stacked vertically. -->
      <div class="story-images" data-anim="fadeIn" data-anim-delay="500">
        <img class="story-portrait"
             src={srcW(STORY_PORTRAIT, 600)}
             srcset={`${srcW(STORY_PORTRAIT, 400)} 400w, ${srcW(STORY_PORTRAIT, 700)} 700w`}
             sizes="(max-width: 768px) 100vw, 520px"
             width="611" height="936"
             alt="John Vallely and Karen on their sailboat"
             data-anim="zoomIn"
             loading="lazy" decoding="async" />
        <img class="story-graphic"
             src={srcW(STORY_GRAPHIC, 305)}
             width="305" height="85"
             alt="" aria-hidden="true"
             loading="lazy" decoding="async" />
      </div>
      <div class="story-content" data-anim="fadeInRight">
        <h2 class="story-heading">{STORY_H2}</h2>
        <div class="story-divider" aria-hidden="true"></div>
        {STORY_PARAGRAPHS.map(p => (<p class="story-p">{p}</p>))}
      </div>
    </div>
  </section>

  <!-- ── Blocks 33-39 — "Based on the Life of John Vallely with Paul
       Weissenstein" three-column section.
       Verified via Playwright DOM walk of #brxe-czxbbc on 2026-05-11:
       - Section bg #F5F5F5, padding 40px 0
       - Container 1: full-width UCLA-blue eyebrow band (padding 40px 8px)
         centered: [123×1 light-gray divider] + H6 light-gray on blue,
         Montserrat 20px 700 uppercase
       - Container 2: 3 horizontal columns
         · LEFT: H2 Bebas Neue 55px (fadeInDown)
         · CENTER: H4 Bebas Neue 26px 700 + body P DM Sans 18px gray (fadeInUp)
         · RIGHT: image collage — valley_110 on top, wooden BL + valley_109 BR (fadeInDown)
       - Image radii: 10px on valley_110/wooden, 22px on valley_109
       - Body P is wrapped in a bare <a> in the source — render as plain text. -->
  <section class="based-on-section">
    <div class="based-eyebrow-band">
      <div class="based-eyebrow-divider" aria-hidden="true"></div>
      <h6 class="based-eyebrow">{BASED_EYEBROW}</h6>
    </div>

    <div class="based-main">
      <div class="based-col based-col-h2" data-anim="fadeInDown">
        <h2 class="based-h2">{BASED_H2}</h2>
      </div>
      <div class="based-col based-col-text" data-anim="fadeInUp">
        <h4 class="based-h4">{BASED_H4}</h4>
        <p class="based-p">{BASED_BODY}</p>
      </div>
      <div class="based-col based-col-images" data-anim="fadeInDown">
        <div class="based-collage">
          <img class="based-img based-img-top"
               src={srcW(BASED_IMG_TOP, 700)}
               width="875" height="700"
               alt="John Vallely on the basketball court"
               loading="lazy" decoding="async" />
          <img class="based-img based-img-bl"
               src={srcW(BASED_IMG_BL, 400)}
               width="720" height="720"
               alt="Coach John Wooden"
               loading="lazy" decoding="async" />
          <img class="based-img based-img-br"
               src={srcW(BASED_IMG_BR, 350)}
               width="562" height="700"
               alt="John Vallely portrait"
               loading="lazy" decoding="async" />
        </div>
      </div>
    </div>
  </section>

  <!-- ── Blocks 40-48 — Free Resources banner + Cori Close endorsement.
       Verified via Playwright DOM walk of #brxe-ixofym + #brxe-tfbdjs +
       #brxe-dpfhqf on 2026-05-11:
       - Section bg transparent (page white shows through)
       - Container 1: yellow #FFD100 banner (padding 25px, gap 15px) with
         H2 + 3 GRAY pill buttons (not yellow — high-contrast variant)
       - Container 2: 2-column. Left has YouTube embed + a thin divider.
         Right has H2 + italic quote + cite + yellow Order Today CTA.

       Editorial corrections per user direction:
       - Source wraps Container 1's H2 in a bare <a> — rendered as plain heading.
       - Source wraps the YouTube iframe in <a href=pacdora.com> (misrouted
         packaging-design link, likely client error) — DROPPED, iframe direct.
       - Source marks "- Coach Cori Close" as H2 — reclassified to <p>+<cite>
         in home.json block 47 (Bricks editor quirk fix). -->
  <section class="resources-section">
    <div class="resources-banner-wrap">
      <div class="resources-banner" data-anim="zoomIn">
        <h2 class="resources-heading">{FREE_RES_H2}</h2>
        <div class="resources-pills">
          <a class="pill-cta-gray" href="/free-resources/">{PDF_SAMPLE.text}</a>
          <a class="pill-cta-gray" href="/free-resources/">{BOOK_CLUB.text}</a>
          <a class="pill-cta-gray" href="/the-pyramid-success/">{PYRAMID_LINK.text}</a>
        </div>
      </div>
    </div>

    <div class="cori-grid">
      <div class="cori-video-col" data-anim="slideInLeft">
        <div class="cori-video-wrap">
          <iframe
            src="https://www.youtube-nocookie.com/embed/Pk7Ox-0b_0Y?rel=0"
            title="The Pyramid Principle — Cori Close endorsement"
            loading="lazy"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen></iframe>
        </div>
        <hr class="cori-divider" aria-hidden="true" />
      </div>

      <div class="cori-text-col" data-anim="slideInRight">
        <h2 class="cori-h2">{CORI_H2}</h2>
        <blockquote class="cori-quote">
          <em>{CORI_QUOTE}</em>
        </blockquote>
        <p class="cori-cite"><cite>{CORI_ATTRIBUTION}</cite></p>
        <a class="pill-cta" href="/#pre-order-now">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" style="margin-right: 8px;"><path d="M7 18c-1.1 0-1.99.9-1.99 2S5.9 22 7 22s2-.9 2-2-.9-2-2-2zM1 2v2h2l3.6 7.59-1.35 2.45c-.16.28-.25.61-.25.96 0 1.1.9 2 2 2h12v-2H7.42c-.14 0-.25-.11-.25-.25l.03-.12L8.1 13h7.45c.75 0 1.41-.41 1.75-1.03l3.58-6.49A1.003 1.003 0 0 0 20 4H5.21l-.94-2H1zm16 16c-1.1 0-1.99.9-1.99 2s.89 2 1.99 2 2-.9 2-2-.9-2-2-2z"/></svg>
          {ORDER_CTA.text}
        </a>
      </div>
    </div>
  </section>

  <!-- ── Blocks 49-67 — "Highlights from The Book" three-column section.
       Verified DOM walk of #brxe-oidcwt:
       - Section bg transparent (white shows through)
       - Container is a flex row with wrap, padding 80px 0, gap 50px column
       - Row 1: full-width block with H2 + 100x2 divider (left-aligned)
       - Row 2: 3 cols ~375px each
         · Col 1: 7 icon-boxes + Order Today button (fadeInLeft)
         · Col 2: 8 icon-boxes + Order Today button (DOM has 0x0; spec asks for both, rendering it)
         · Col 3: decorative book image (fadeIn)
       - Icon-box: book glyph (color rgb(33,150,243), ~25px) + content P (DM Sans 18px, color #616161)
       Verbatim: 'John Valley' (sic) typo preserved on items 5+6 of col 2. -->
  <section class="highlights-section">
    <div class="highlights-container">
      <div class="highlights-head">
        <h2 class="highlights-h2">{HIGHLIGHTS_H2}</h2>
        <div class="highlights-divider" aria-hidden="true"></div>
      </div>

      <div class="highlights-grid">
        <div class="highlights-col" data-anim="fadeInLeft">
          {HIGHLIGHTS_COL1.map(text => (
            <div class="icon-box">
              <svg class="icon-book" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20"/></svg>
              <p class="icon-box-text">{text}</p>
            </div>
          ))}
          <a class="pill-cta highlights-cta" href="/#pre-order-now">
