    gap: 20px;
    padding: 30px 0;
    min-width: 0; /* allow text to wrap inside grid column instead of overflowing */
  }
  /* Verified live DOM: Libre Baskerville 55px italic, color #1D1D1F.
     max-width:100% + overflow-wrap keep the heading wrapping inside its
     grid column instead of overflowing the card. */
  .wooden-quote {
    margin: 0;
    padding: 0;
    border: 0;
    font-family: 'Libre Baskerville', Georgia, 'Times New Roman', serif;
    font-weight: 400;
