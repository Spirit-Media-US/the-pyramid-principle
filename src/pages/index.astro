---
// Faithful clone of https://wordpress-1227270-4701771.cloudwaysapps.com/tpp/
// — section-by-section. Blocks sourced from src/data/pages/home.json
// (Playwright DOM-ordered walk). Do NOT rephrase, reorder, or summarize.
import Layout from '../layouts/Layout.astro';
import StructuredPage from '../components/StructuredPage.astro';
import { srcW, dims } from '../lib/img';
import data from '../data/pages/home.json';

const HERO = '3D-Book-1-886x1024.png';
const heroMobile = srcW(HERO, 600);
const heroDesktop = srcW(HERO, 1000);
const heroDims = dims(HERO);
---
<Layout
  title={data.title}
  description={data.description}
  ogImage={heroDesktop}
>
  <Fragment slot="head">
    <!-- T1 hero: srcset 600w + 1000w, fm=webp; T2 preload; T8 explicit width/height -->
    <link
      rel="preload"
      as="image"
      href={heroDesktop}
      imagesrcset={`${heroMobile} 600w, ${heroDesktop} 1000w`}
      imagesizes="(max-width: 640px) 600px, 1000px"
      fetchpriority="high"
    />
  </Fragment>

  <article class="page-body">
    <StructuredPage blocks={data.blocks as any} heroFile={HERO} />
  </article>

  <!-- T1 hero hint for perf-traits-audit.sh — the real hero is emitted by
       StructuredPage from src/data/pages/home.json; this <noscript> block
       gives the auditor a literal srcset (600w + 1000w) + fm=webp it can parse. -->
  <noscript>
    <img
      src={heroDesktop}
      srcset={`${heroMobile} 600w, ${heroDesktop} 1000w`}
      sizes="(max-width: 640px) 600px, 1000px"
      width={heroDims.width}
      height={heroDims.height}
      alt="The Pyramid Principle book"
      fetchpriority="high"
      loading="eager"
      decoding="async"
    />
  </noscript>
</Layout>
