---
// Blog index — lists all published blogPost documents.
// Card style mirrors the homepage Latest Blog cards.
import Layout from '../../layouts/Layout.astro';
import { sanityClient, urlFor } from '../../lib/sanity';

const posts = await sanityClient.fetch(`
  *[_type == "blogPost" && defined(publishDate)]
    | order(publishDate desc) {
      title,
      "slug": slug.current,
      publishDate,
      excerpt,
      cardImage,
      heroImage
    }
`);

const MONTHS = ['January','February','March','April','May','June','July','August','September','October','November','December'];
function fmtDate(d: string): string {
  if (!d) return '';
  const dt = new Date(d);
  return `${MONTHS[dt.getUTCMonth()]} ${dt.getUTCDate()}, ${dt.getUTCFullYear()}`;
}
---
<Layout title="Blog | The Pyramid Principle"
        description="Articles, updates, and insights from The Pyramid Principle.">
  <div class="blog-index">
    <section class="blog-index-hero">
      <div class="blog-index-eyebrow">
        <span class="blog-index-divider" aria-hidden="true"></span>
        <span class="blog-index-eyebrow-label">Blogs</span>
        <span class="blog-index-divider" aria-hidden="true"></span>
      </div>
      <h1 class="blog-index-h1">The Pyramid Principle Blog</h1>
    </section>

    {posts.length === 0 ? (
      <p class="blog-index-empty">No posts yet.</p>
    ) : (
      <section class="blog-index-grid-wrap">
        <div class="blog-index-grid">
          {posts.map((p: any) => {
            const img = p.cardImage || p.heroImage;
            const imgUrl = img ? urlFor(img).width(700).format('webp').quality(80).url() : null;
            return (
              <article class="blog-card">
                {imgUrl && (
                  <img class="blog-card-img"
                       src={imgUrl}
                       width="600" height="400"
                       alt={(img as any)?.alt || p.title}
                       loading="lazy" decoding="async" />
                )}
                <p class="blog-card-date">{fmtDate(p.publishDate)}</p>
                <h2 class="blog-card-h3"><a href={`/blog/${p.slug}/`}>{p.title}</a></h2>
                {p.excerpt && <p class="blog-card-excerpt">{p.excerpt}</p>}
                <a class="blog-card-cta" href={`/blog/${p.slug}/`}>Read full article</a>
              </article>
            );
          })}
        </div>
      </section>
    )}
  </div>
</Layout>

<style is:global>
  .blog-index { background: #fff; padding: 0 20px 60px; }
  @media (min-width: 768px) { .blog-index { padding: 0 var(--section-padding-x-desktop, 40px) 80px; } }

  .blog-index-hero { max-width: var(--container-max, 1200px); margin-inline: auto; padding: 60px 0 30px; display: flex; flex-direction: column; align-items: center; gap: 12px; }
  .blog-index-eyebrow { display: flex; align-items: center; gap: 10px; color: #424242; }
  .blog-index-divider { width: 40px; height: 0; border-top: 1px solid #616161; flex-shrink: 0; }
  .blog-index-eyebrow-label { font-family: 'Montserrat', system-ui, sans-serif; font-weight: 700; font-size: 15px; color: #696969; text-transform: uppercase; letter-spacing: 0.06em; }
  .blog-index-h1 { margin: 0; font-family: var(--font-display); font-weight: 400; font-size: 50px; line-height: 1; color: #000; text-align: center; text-transform: uppercase; letter-spacing: 0.01em; }
  @media (min-width: 768px) { .blog-index-h1 { font-size: 60px; } }

  .blog-index-grid-wrap { max-width: var(--container-max, 1200px); margin-inline: auto; }
  .blog-index-grid { display: grid; grid-template-columns: 1fr; gap: 32px; }
  @media (min-width: 768px) { .blog-index-grid { grid-template-columns: repeat(2, 1fr); gap: 40px; } }
  @media (min-width: 1024px) { .blog-index-grid { grid-template-columns: repeat(3, 1fr); } }

  .blog-card { display: flex; flex-direction: column; gap: 12px; }
  .blog-card-img { width: 100%; aspect-ratio: 3 / 2; object-fit: cover; border-radius: 8px; display: block; }
  .blog-card-date { margin: 0; font-family: var(--font-heading); font-size: 13px; color: #888; letter-spacing: 0.04em; text-transform: uppercase; }
  .blog-card-h3 { margin: 0; font-family: var(--font-heading); font-weight: 700; font-size: 18px; line-height: 1.3; color: var(--color-ink, #1D1D1F); }
  .blog-card-h3 a { color: inherit; text-decoration: none; }
  .blog-card-h3 a:hover { text-decoration: underline; }
  .blog-card-excerpt { margin: 0; font-family: var(--font-heading); font-size: 14px; line-height: 1.5; color: #555; }
  .blog-index .blog-card-cta {
    align-self: flex-start;
    display: inline-flex; align-items: center;
    background: var(--color-brand-yellow, #FFD100);
    color: var(--color-ink, #1D1D1F);
    font-family: var(--font-heading);
    font-weight: 700; font-size: 0.875rem; letter-spacing: 0.02em;
    padding: 8px 16px;
    border: 1px solid rgba(33, 33, 33, 0.26);
    border-radius: 10px;
    box-shadow: rgba(112, 94, 0, 0.47) 0px 2px 3px 1px;
    text-decoration: none;
    transition: background 0.15s ease, box-shadow 0.15s ease;
  }
  .blog-index .blog-card-cta:hover { background: #e6bd00; box-shadow: rgba(112, 94, 0, 0.6) 0px 3px 5px 1px; }
  .blog-index-empty { max-width: 600px; margin: 60px auto; text-align: center; font-family: var(--font-heading); color: #555; }
</style>
