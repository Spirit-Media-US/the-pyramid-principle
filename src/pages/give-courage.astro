---
import Layout from '../layouts/Layout.astro';
import StructuredPage from '../components/StructuredPage.astro';
import { srcW, dims } from '../lib/img';
import data from '../data/pages/give-courage.json';

const HERO = '58e232679973e0ada741fbaf881dcad8-transformed-1024x537.jpeg';
const heroMobile = srcW(HERO, 600);
const heroDesktop = srcW(HERO, 1200);
---
<Layout title={data.title} description={data.description} ogImage={heroDesktop}>
  <Fragment slot="head">
    <link rel="preload" as="image" href={heroDesktop} imagesrcset={`${heroMobile} 600w, ${heroDesktop} 1200w`} imagesizes="(max-width: 640px) 600px, 1200px" fetchpriority="high" />
  </Fragment>
  <article class="page-body">
    <StructuredPage blocks={data.blocks as any} heroFile={HERO} />
  </article>
</Layout>
