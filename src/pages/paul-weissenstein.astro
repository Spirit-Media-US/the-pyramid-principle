---
// Paul Weissenstein bio page — programmatic typed-block rebuild,
// mirroring the john-vallely.astro pattern.
// Data:    src/data/pages/paul-weissenstein.json (typed blocks)
// Renderer: src/components/TypedPage.astro (block-type dispatcher)
import Layout from '../layouts/Layout.astro';
import TypedPage from '../components/TypedPage.astro';
import { srcW, dims } from '../lib/img';
import blocks from '../data/pages/paul-weissenstein.json';

const meta = (blocks as any[]).find(b => b.type === '_meta') || {};

// LCP hero: image-1.png — also referenced by /paul-weissenstein/* Link
// preload header in public/_headers (must stay in sync).
const HERO = 'image-1.png';
const heroMobile = srcW(HERO, 600);
const heroDesktop = srcW(HERO, 900);
const heroDims = dims(HERO);
---
<Layout title={meta.title || 'Paul Weissenstein | The Pyramid Principle'}
        description={meta.description || ''}
        ogImage={heroDesktop}>
  <Fragment slot="head">
    <link rel="preload" as="image" href={heroDesktop}
          imagesrcset={`${heroMobile} 600w, ${heroDesktop} 900w`}
          imagesizes="(max-width: 1024px) 100vw, 480px"
          fetchpriority="high" />
  </Fragment>

  <TypedPage blocks={blocks as any[]} />
</Layout>
