---
import Layout from '../layouts/Layout.astro';
import StructuredPage from '../components/StructuredPage.astro';
import { srcW, dims } from '../lib/img';
import data from '../data/pages/paul-weissenstein.json';

const HERO = 'image-1.png';
const heroMobile = srcW(HERO, 600);
const heroDesktop = srcW(HERO, 900);
const heroDims = dims(HERO);
---
<Layout title={data.title} description={data.description} ogImage={heroDesktop}>
  <Fragment slot="head">
    <link rel="preload" as="image" href={heroDesktop} imagesrcset={`${heroMobile} 600w, ${heroDesktop} 900w`} imagesizes="(max-width: 640px) 600px, 900px" fetchpriority="high" />
  </Fragment>
  <article class="page-body">
    <StructuredPage blocks={data.blocks as any} heroFile={HERO} />
  </article>
</Layout>
