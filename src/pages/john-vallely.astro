---
import Layout from '../layouts/Layout.astro';
import { srcW, heroSrcset, dims } from '../lib/img';

const HERO = 'valley_109.jpg';
const hero = heroSrcset(HERO, { mobile: 600, desktop: 1000 });
const heroDims = dims(HERO);

const DEDICATION = [
  'My son Eric is a powerful force of courage and commitment and was a cornerstone of stability when it felt like my world was falling apart. When his nine-year-old younger sister was diagnosed with cancer, Eric became a special teammate and champion of hers.',
  'It was hard for me to even see straight after we lost Erin at age twelve, but Eric remained steadfast and kept me grounded by saying, "Dad, we are still a family." Eric would go off to school at UCLA, play on two NCAA championship volleyball teams, graduate on time, and start his adult life.',
  'He has always been the special glue that helps keep us together. He married his wife Suzanne, and they have our talented granddaughter Vivian, who attends Pepperdine University and competes on the swim and dive team.',
  'It is with great joy that Karen and I honor and dedicate our family story to our son, Eric Vallely.',
];
const TEAMMATES = ['Kareem Abdul-Jabbar', 'Sidney Wicks', 'Curtis Rowe', 'Steve Patterson', 'Henry Bibby'];
const INTERVIEW_QUESTIONS = [
  'A legendary coach\'s wisdom is needed most when a man is about to lose everything — how does that play out in your life?',
  'How does a sports champion win at life off the court when the opponent is cancer?',
  'Why did Coach John Wooden later say he wished he had put LOVE at the top of the Pyramid of Success?',
  'Your exposure to racism impacting your friend and teammate, Kareem Abdul-Jabbar — what did you witness?',
  'Wisdom and leadership through Coach Wooden\'s Pyramid of Success.',
  'Your romantic love story with Karen and Coach Wooden telling you, "You marry that girl."',
  'Your daughter Erin\'s heroic courage to fight cancer 3 times.',
  'Erin asking you, "Daddy, will I live to see Christmas?"',
  'Your victory over cancer two times.',
  'Your involvement in Pediatric Cancer Research Foundation.',
];
---
<Layout
  title="John Vallely | The Pyramid Principle"
  description="The never before told story of John Vallely. UCLA National Champion 1969–1970, Hall-of-Famer, and survivor — discovers UCLA Coach John Wooden's true meaning of success."
  ogImage={hero.desktop}
>
  <Fragment slot="head">
    <link rel="preload" as="image" href={hero.desktop} imagesrcset={hero.srcset} imagesizes={hero.sizes} fetchpriority="high" />
  </Fragment>

  <section class="page-hero">
    <div class="container-site page-hero-grid">
      <div>
        <p class="eyebrow">UCLA National Champ 69–70</p>
        <h1 class="display-heading">John Vallely</h1>
        <p class="page-hero-lede">"Money Man" — starting guard for UCLA under Coach John Wooden, two-time NCAA champion, All-American, and warrior in cancer's toughest fight.</p>
      </div>
      <img
        src={hero.desktop}
        srcset={hero.srcset}
        sizes={hero.sizes}
        width={heroDims.width}
        height={heroDims.height}
        alt="John Vallely"
        fetchpriority="high"
        loading="eager"
        decoding="async"
        class="page-hero-img"
      />
    </div>
  </section>

  <section class="section">
    <div class="container-site prose-block">
      <p>John Vallely was a starting guard for UCLA from 1968 to 1970, playing for Coach John Wooden. Known as "Money Man" for his clutch performances, he helped secure two NCAA championships. In 1970, he was named an All-American, was drafted in the first round by the Atlanta Hawks, and married his wife Karen. Following their daughter's death from cancer, John and Karen have been heavily invested in the Pediatric Cancer Research Foundation.</p>
      <h2>A heart-gripping story of championship resilience</h2>
      <p><strong>John Vallely battled the best</strong> — 2× NCAA champion at UCLA.<br /><strong>John Vallely battled the biggest fight</strong> against Bank of America.<br /><strong>John battled the most brutal cancer</strong> as a survivor and warrior.</p>
      <p>His coach's proven life principles guided him and gave him the strength to fight with undying faith.</p>
    </div>
  </section>

  <section class="section" style="background: var(--color-bg-section);">
    <div class="container-site prose-block">
      <h2>Dedication</h2>
      {DEDICATION.map(p => (<p>{p}</p>))}
    </div>
  </section>

  <section class="section">
    <div class="container-site prose-block">
      <h2>Played beside college basketball greats…</h2>
      <ul class="plain-list">{TEAMMATES.map(t => (<li>{t}</li>))}</ul>
    </div>
  </section>

  <section class="section" style="background: var(--color-bg-section);">
    <div class="container-site prose-block">
      <h2>Schedule John Vallely as a guest on your show</h2>
      <p>An interview with John Vallely will bring value to your audience.</p>
      <h3>Interview questions</h3>
      <ol class="numbered-list">
        {INTERVIEW_QUESTIONS.map(q => (<li>{q}</li>))}
      </ol>
      <h3>Media Contact</h3>
      <p>Jeremy Lorin · Spirit Media Inc · <a href="tel:+18888003744">1-888-800-3744</a> · <a href="mailto:jeremy@spiritmediapublishing.com">jeremy@spiritmediapublishing.com</a></p>
    </div>
  </section>

  <section class="give-courage-banner">
    <div class="container-site">
      <h2>Give the Gift of Courage</h2>
      <p>to 400,000 families fighting cancer</p>
      <a class="btn-outline" href="/give-courage/">Give Courage</a>
    </div>
  </section>
</Layout>

<style>
  .page-hero { background: var(--color-bg-section); padding: 56px 0; }
  .page-hero-grid { display: grid; gap: 32px; align-items: center; grid-template-columns: 1fr; }
  .page-hero .eyebrow { color: var(--color-author-blue); margin: 0 0 12px; }
  .page-hero-lede { margin: 16px 0 0; max-width: 560px; color: var(--color-ink-muted); font-size: 1.05rem; }
  .page-hero-img { width: 100%; max-width: 420px; height: auto; justify-self: center; }
  @media (min-width: 768px) { .page-hero-grid { grid-template-columns: 1fr 1fr; } }

  .prose-block { max-width: 800px; margin-inline: auto; }
  .prose-block h2 { font-family: var(--font-display); font-size: clamp(1.75rem, 3.5vw, 2.25rem); color: var(--color-ink); margin: 32px 0 16px; text-transform: uppercase; line-height: 1.1; }
  .prose-block h3 { font-family: var(--font-heading); font-size: 1.15rem; color: var(--color-ink-soft); margin: 24px 0 12px; }
  .prose-block p { margin: 0 0 16px; }
  .plain-list { list-style: none; padding: 0; margin: 0 0 16px; display: grid; gap: 8px; }
  .plain-list li { padding: 12px 16px; background: var(--color-bg-section); border-left: 3px solid var(--color-brand-yellow); }
  .numbered-list { padding-left: 24px; margin: 0 0 16px; }
  .numbered-list li { margin-bottom: 12px; }
</style>
