---
// Faithful clone of /tpp/john-vallely/. Blocks from src/data/pages/john-vallely.json.
import Layout from '../layouts/Layout.astro';
import StructuredPage from '../components/StructuredPage.astro';
import { srcW, dims } from '../lib/img';
import data from '../data/pages/john-vallely.json';

const HERO = 'valley_109.jpg';
const heroMobile = srcW(HERO, 600);
const heroDesktop = srcW(HERO, 1000);
const heroDims = dims(HERO);
---
<Layout
  title={data.title}
  description={data.description}
  ogImage={heroDesktop}
>
  <Fragment slot="head">
    <link
      rel="preload"
      as="image"
      href={heroDesktop}
      imagesrcset={`${heroMobile} 600w, ${heroDesktop} 1000w`}
      imagesizes="(max-width: 640px) 600px, 1000px"
      fetchpriority="high"
    />
  </Fragment>

  <article class="page-body">
    <StructuredPage blocks={data.blocks as any} heroFile={HERO} />
  </article>
</Layout>
