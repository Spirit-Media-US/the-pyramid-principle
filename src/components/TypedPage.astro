  .jv-photo-carousel { position: relative; width: 100%; margin: 0; overflow: hidden; }
  .jv-photo-carousel .swiper { position: relative; overflow: hidden; display: block; padding: 0; z-index: 1; }
  .jv-photo-carousel .swiper-wrapper { position: relative; width: 100%; height: 100%; display: flex; box-sizing: content-box; }
  .jv-photo-carousel .swiper-slide { flex-shrink: 0; width: 100%; height: 100%; position: relative; }
  .jv-photo-carousel .jv-photo-slide { height: 150px; overflow: hidden; }
