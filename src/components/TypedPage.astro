---
// Typed-block page renderer. Each block in the array has a `type` field
// that dispatches to a section-specific layout. Powers programmatically
// rebuilt pages (john-vallely first; pattern reusable for others).
//
// Block types handled:
//   _meta                — page title/description (no markup)
//   title-card           — centered hero: eyebrow row (— text —) + H1
//   centered-image       — single centered image with optional download CTA
//   quote-card-grid      — 2-col responsive grid of quote cards
//   person-profile-card  — alternating 2-col card (text + image stack)
//   give-courage-banner  — 2-line H2 banner + pink CTA + tax-deductible note
//   smg-banner           — 3-col H3 banner (Spirit Media Gives + Tax ID + tax-note)
//   pcrf-section         — 2-col: eyebrow + H1 + body, image + caption
//   centered-h3-banner   — single centered uppercase H3 with optional pink span
//   join-movement        — 2-col: image left + H2 + body right (Give Courage Section 6)
//   donation-section     — 2-col: inline YouTube + multi-block copy + Givebutter
//   hero-intro           — eyebrow + H1 + body + sidebar image
//   highlight-cards      — 4 callout cards with left-border accent
//   featured-podcasts    — 2 square card links
//   video-popup-grid     — 3x3 YouTube tiles with play-icon overlay
//   dedication-and-players — H2 + body + 2nd H2 + player profile cards
//   media-contact-card   — H2 + H3 + contact text + bg image
//   interview-questions  — H2 + numbered list + image collage
//   download-hero        — 2-col hero for /download/ (eyebrow + H1 + body + stats + book img)
//   audio-section        — H2 + native <audio controls> + Download Now link
//   share-review-cta     — Reviews page top: eyebrow + H1 + subtitle + 2 logos + CTA
//   pull-quote-row       — Reviews page 3-up colored quote cards (Libre Baskerville italic)
//   review-card-list     — Reviews page alternating image+text testimonial rows
//   pr-release-card      — Media Center: 2-col PR card (H2 + body + CTA + YT facade / MP4 video)
//   press-logo-grid      — Media Center: responsive grid of clickable press-logo cards
import { srcW, dims } from '../lib/img';

interface Props { blocks: any[]; }
const { blocks } = Astro.props;

function imgUrl(image: any, w = 600): string {
  if (!image) return '';
  if (image.file) return srcW(image.file, w);
  if (image.sanityUrl) return image.sanityUrl;
  return '';
}

// Decode HTML entities (em-dash, curly quotes) that survived parsing
function decodeText(s: string): string {
  return (s || '')
    .replace(/&amp;/g, '&').replace(/&quot;/g, '"').replace(/&apos;|&#39;/g, "'")
    .replace(/&#8217;|&rsquo;/g, '’').replace(/&#8220;|&ldquo;/g, '“').replace(/&#8221;|&rdquo;/g, '”')
    .replace(/&#8211;|&ndash;/g, '–').replace(/&#8212;|&mdash;/g, '—')
    .replace(/&hellip;|&#8230;/g, '…');
}
---
{blocks.map(b => {
  if (b.type === '_meta') return null;

  // ── shape-divider — decorative SVG triangle (full width, ~200px) ──
  // Bricks uses this as a slanted edge at the top of a section. Reusable.
  if (b.type === 'shape-divider') {
    const fill = b.fill || '#fafafa';
    return (
      <svg class="jv-shape-divider"
           xmlns="http://www.w3.org/2000/svg"
           preserveAspectRatio="none"
           viewBox="0 0 1200 200"
           aria-hidden="true"
           style={`fill: ${fill};`}>
        <polygon fill-rule="evenodd" points="0 200 1200 0 1200 200"></polygon>
      </svg>
    );
  }

  // ── hero-intro — verified 2-col hero matching live #brxe-63667e ──
  // Left col: eyebrow row + H1 + mobile-only image + body + 4 highlight cards
  // Right col: desktop-only sidebar image
  if (b.type === 'hero-intro') {
    const heroImg = imgUrl(b.image, 700);
    const heroMobile = imgUrl(b.image, 400);
    const imgWidth = b.image?.dims?.width || 562;
    const imgHeight = b.image?.dims?.height || 700;
    const cards = (b.highlightCards || []) as { lines: string[] }[];
    return (
      <section class="jv-hero" id={b.id}>
        <div class="jv-hero-grid">
          <div class="jv-hero-left">
            <div class="jv-eyebrow-row">
              <span class="jv-eyebrow-divider" aria-hidden="true"></span>
              <h6 class="jv-eyebrow">{b.eyebrow}</h6>
            </div>
            <h1 class="jv-h1">{b.h1}</h1>
            {b.image && b.image.sanityUrl && (
              <img class="jv-hero-img-mobile"
                   src={heroMobile}
                   width={imgWidth} height={imgHeight}
                   alt={b.eyebrow}
                   loading="lazy" decoding="async" />
            )}
            {b.bodyHtml
              ? <p class="jv-body" set:html={b.bodyHtml} />
              : <p class="jv-body">{decodeText(b.body)}</p>
            }
            {cards.length > 0 && (
              <div class="jv-highlight-stack">
                {cards.map(c => (
                  <div class="jv-highlight-card">
                    {c.lines.map((line, i) => (
                      <>
                        {i > 0 && <br />}
                        {line}
                      </>
                    ))}
                  </div>
                ))}
              </div>
            )}
          </div>
          {b.image && b.image.sanityUrl && (
            <div class="jv-hero-right">
              <img class="jv-hero-img-desktop"
                   src={heroImg}
                   srcset={`${heroMobile} 400w, ${heroImg} 700w`}
                   sizes="(max-width: 1024px) 100vw, 562px"
                   width={imgWidth} height={imgHeight}
                   alt={b.eyebrow}
                   loading="lazy" decoding="async" />
            </div>
          )}
        </div>
      </section>
    );
  }

  // ── section-h2 — standalone H2 banner used as a section break ──
  // Verified live #brxe-vflqgb: Bebas Neue 55px weight 700, color #000,
  // text-align left, margin 40px 0 20px, full container width.
  // Optional `align: 'center'` for variants like #brxe-najbcz (Retailers).
  if (b.type === 'section-h2') {
    const styleStr = b.align ? `text-align: ${b.align};` : '';
    return (
      <section class="jv-section-h2-banner" id={b.id}>
        <h2 class="jv-section-h2-banner-text" style={styleStr}>{b.text}</h2>
      </section>
    );
  }

  // ── quote-card-grid — 2-col responsive grid of quote cards.
  // Verified live #brxe-emdmmr (the-pyramid-success Section 3).
  //   Section #brxe-emdmmr: padding-top 40px, padding-bottom 80px desktop;
  //     40px / 40px mobile.
  //   Grid (#brxe-odfknv): flex-row, flex-wrap, justify-between, row-gap 20px.
  //   Card (#brxe-axixep): width 48% desktop.
  //     Desktop: bg #fff, border-left 5px UCLA-blue (#2774AE), padding-left 40px,
  //       box-shadow 1px 1px 2px 1px #e0e0e0.
  //     Mobile: width 100%, bg #f5f5f5, border 1px #e0e0e0, asymmetric border-
  //       radius (top-left + bottom-right 25px), no shadow.
  //   Quote body (#brxe-yaqrkn): Libre Baskerville italic 20px,
  //     color #212121 desktop / #424242 mobile. (Source declares
  //     font-weight 700; only the 400-italic woff2 is hosted in R2.)
  //   Attribution span: font-style: normal, font-weight: 400, font-size: 16px
  //     (source inline style preserved verbatim).
  //
  // Source pillars (#brxe-oooaaw, #brxe-tfckos) — Untitled-design-2.png and
  // Untitled-design-3-1.png — were position:absolute decorative bg layers
  // (z-index -60, width 35%, hidden on mobile). Dropped from the rebuild
  // per user direction; may return as Phase 6 polish.
  if (b.type === 'quote-card-grid') {
    return (
      <section class="qcg-section" id={b.id}>
        <div class="qcg-grid">
          {(b.quotes || []).map((q: any) => (
            <blockquote class="qcg-card">
              {q.attributionPosition === 'prefix' ? (
                <p>
                  <span class="qcg-attribution">{decodeText(q.attribution)}:</span>{' '}
                  {decodeText(q.body)}
                </p>
              ) : q.attributionPosition === 'suffix' ? (
                <p>
                  {decodeText(q.body)}{' '}
                  <span class="qcg-attribution">— {decodeText(q.attribution)}</span>
                </p>
              ) : (
                <p>{decodeText(q.body)}</p>
              )}
            </blockquote>
          ))}
        </div>
      </section>
    );
  }

  // ── person-profile-card — alternating 2-col card with text on one side
  // and a vertical image stack on the other. Verified live #brxe-ycmynm /
  // #brxe-yipzzu (text col) / #brxe-ppyezc (image col) on Section 4 of
  // the-pyramid-success.
  //   Outer (#brxe-ycmynm): flex-row, column-gap 40px, align-items center,
  //     margin-bottom 40px.
  //   Text col (#brxe-yipzzu): width 50% desktop / 100% mobile, padding-top
  //     50px desktop (visually centers the text against image height).
  //     Contains H3 name + bio P + yellow "Learn More" pill with chevron.
  //   Image col (#brxe-ppyezc): width 50% desktop / 100% mobile, padding-top
  //     40px mobile (spacing between text and stacked images).
  //   Images stack vertically with 15px gap (source row-gap on image col).
  //   Bio (#brxe-mmdtmm): DM Sans 18px desktop / Roboto mobile.
  //   "Learn More" pill: bg #FFD100, color #000, Raleway 700, 1px solid #f5f5f5
  //     border, border-radius 10px. Source uses `ion-ios-arrow-forward` icon
  //     font — rebuild uses inline SVG chevron to avoid the dependency.
  //   Animation: data-anim="fadeInLeft" or "fadeInRight" per imageSide
  //     (text-on-left card fades in from left; text-on-right fades from right).
  //     IO observer + CSS keyframes defined in this file's global style block.
  if (b.type === 'person-profile-card') {
    const side = b.imageSide === 'left' ? 'left' : 'right';
    const layout = b.layout === 'collage' ? 'collage' : 'stack';
    const images = (b.images || []) as { file?: string; sanityUrl?: string; alt?: string; dims?: any }[];
    const geometry = (b.collageGeometry || []) as any[];
    const textAnim = side === 'right' ? 'fadeInLeft' : 'fadeInRight';
    const imageAnim = side === 'right' ? 'fadeInRight' : 'fadeInLeft';
    // For collage: pre-compute CSS-var inline style strings for each image
    // (one entry per image, indexed by position). The .ppc-media-collage CSS
    // reads these vars at desktop sizes; mobile rules reset to vertical stack.
    const collageStyles = (b.images || []).map((_: any, i: number) => {
      if (layout !== 'collage') return '';
      const g = geometry[i] || {};
      const parts: string[] = [];
      if (g.width) parts.push('--cg-w: ' + g.width);
      if (g.height) parts.push('--cg-h: ' + g.height);
      if (g.marginTop) parts.push('--cg-mt: ' + g.marginTop);
      if (g.marginLeft) parts.push('--cg-ml: ' + g.marginLeft);
      if (g.paddingRight) parts.push('--cg-pr: ' + g.paddingRight);
      if (g.borderTop != null) parts.push('--cg-bt: ' + g.borderTop + 'px');
      if (g.borderRight != null) parts.push('--cg-br: ' + g.borderRight + 'px');
      if (g.borderBottom != null) parts.push('--cg-bb: ' + g.borderBottom + 'px');
      if (g.borderLeft != null) parts.push('--cg-bl: ' + g.borderLeft + 'px');
      if (g.objectPosition) parts.push('--cg-op: ' + g.objectPosition);
      return parts.join('; ');
    });
    // Bio accepts: string (single para text), string[] (multi-para text),
    // or {html: string} / { html: string }[] for paragraphs that need inline
    // markup (e.g. <i>Sports Illustrated</i>). HTML strings are checked-in
    // content, not user input, so set:html is safe here.
    const rawBio = b.bio;
    const bioParagraphs: any[] = Array.isArray(rawBio)
      ? rawBio
      : (rawBio ? [rawBio] : []);
    const textCol = (
      <div class="ppc-text" data-anim={textAnim}>
        <h3 class="ppc-name">{decodeText(b.name)}</h3>
        {bioParagraphs.map((p: any) => (
          p && typeof p === 'object' && p.html
            ? <p class="ppc-bio" set:html={p.html} />
            : <p class="ppc-bio">{decodeText(p)}</p>
        ))}
        {b.learnMoreHref && (
          <a class="ppc-cta" href={b.learnMoreHref} target="_blank" rel="noopener noreferrer">
            Learn More
            <svg class="ppc-cta-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
          </a>
        )}
      </div>
    );
    const mediaClass = layout === 'collage' ? 'ppc-media ppc-media-collage' : 'ppc-media';
    const imageCol = (
      <div class={mediaClass} data-anim={imageAnim}>
        {images.map((img: any, i: number) => {
          const inlineStyle = collageStyles[i] || '';
          if (img.caption) {
            return (
              <figure class="ppc-media-figure" style={inlineStyle}>
                <img src={imgUrl(img, 800)}
                     width={img.dims?.width || 600} height={img.dims?.height || 600}
                     alt={img.alt || ''}
                     loading="lazy" decoding="async" />
                <figcaption class="ppc-media-caption">{decodeText(img.caption)}</figcaption>
              </figure>
            );
          }
          return (
            <img src={imgUrl(img, 800)}
                 style={inlineStyle}
                 width={img.dims?.width || 600} height={img.dims?.height || 600}
                 alt={img.alt || ''}
                 loading="lazy" decoding="async" />
          );
        })}
      </div>
    );
    return (
      <div class={`ppc-card ppc-${side}`} id={b.id}>
        {side === 'right' ? <>{textCol}{imageCol}</> : <>{imageCol}{textCol}</>}
      </div>
    );
  }

  // ── centered-image — single centered image with optional download CTA.
  // Replaces source's WordPress 3D Flip Book plugin (#brxe-wvkmbg /
  // #brxe-icfhke) at the Pyramid of Success section. A static PNG
  // (rendered from the source PDF) carries the visual; the original
  // PDF is served from R2 via the yellow-pill Download CTA below.
  // Section padding follows SMP standard: 40px top mobile / 80px top +
  // 60px bottom desktop.
  if (b.type === 'centered-image') {
    const file = b.image?.file || b.image?.sanityUrl;
    const dims = b.image?.dims || { width: 1200, height: 900 };
    const maxW = b.maxWidth || 800;
    const srcMobile = srcW(file, Math.min(800, maxW));
    const srcDesktop = srcW(file, Math.min(1600, maxW * 2));
    return (
      <section class="ci-section" id={b.id}>
        <div class="ci-inner">
          {b.h2 && <h2 class="ci-h2">{decodeText(b.h2)}</h2>}
          <img class="ci-image"
               src={srcDesktop}
               srcset={`${srcMobile} 800w, ${srcDesktop} 1600w`}
               sizes={`(max-width: 768px) 100vw, ${maxW}px`}
               width={dims.width} height={dims.height}
               style={`max-width: ${maxW}px;`}
               alt={b.image?.alt || b.alt || ''}
               loading="lazy" decoding="async" />
          {b.downloadHref && (
            <a class="ci-download" href={b.downloadHref}
               target="_blank" rel="noopener noreferrer"
               download={b.downloadFilename || true}>
              {b.downloadLabel || 'Download PDF'}
            </a>
          )}
          {b.meta && <p class="ci-meta">{decodeText(b.meta)}</p>}
        </div>
      </section>
    );
  }

  // ── download-hero — two-column hero for /download/, modelled on the
  // homepage hero (index.astro #pre-order-now) but simplified — no
  // ribbon-badge, no retailer grid, no Limited-Time CTA, no pill row.
  // Verified live #brxe-0d4466 (download page):
  //   LEFT col: eyebrow row (divider + H6) + H1 + body + 3 stat columns.
  //   RIGHT col: 3D book cover (same fd3d2aa3 Sanity asset as homepage).
  //   White-triangle shape-divider at the bottom of the section.
  // The H1 source casing "the pyramid Principle" (lowercase 't', lowercase
  // 'p' on word #2) is preserved verbatim per Phase 3 — display CSS keeps
  // it readable in Bebas Neue without uppercase transform.
  if (b.type === 'download-hero') {
    const imgFile = b.image?.file;
    let imgMobile = '';
    let imgDesktop = '';
    let imgDims = { width: 886, height: 1024 };
    if (imgFile) {
      imgMobile = srcW(imgFile, 600);
      imgDesktop = srcW(imgFile, 1000);
      try { imgDims = dims(imgFile); } catch {}
    }
    const stats = (b.stats || []) as any[];
    // Three icon path strings matched to the live source's icons-mind glyphs.
    const ICON_PATHS: any = {
      language: 'M4 2v20h2v-8h13l-2-4 2-4H6V2H4z',
      ratings: 'M12 2l2.39 7.36H22l-6.18 4.49L18.21 22 12 17.27 5.79 22l2.39-8.15L2 9.36h7.61L12 2z',
      pages: 'M3 5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v2a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5zm0 6a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v2a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-2zm2 4a2 2 0 0 0-2 2v2a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-2a2 2 0 0 0-2-2H5z',
    };
    return (
      <section class="dl-hero" id={b.id}>
        <div class="dl-hero-grid">
          <div class="dl-hero-left">
            <div class="dl-hero-eyebrow-row">
              <span class="dl-hero-eyebrow-divider" aria-hidden="true"></span>
              <h6 class="dl-hero-eyebrow">{decodeText(b.eyebrow)}</h6>
            </div>
            <h1 class="dl-hero-h1">{decodeText(b.h1)}</h1>
            <p class="dl-hero-body">{decodeText(b.body)}</p>
            {stats.length > 0 && (
              <div class="dl-hero-stats">
                {stats.map(s => (
                  <div class="dl-hero-stat">
                    <svg class="dl-hero-stat-icon" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                      <path d={ICON_PATHS[s.icon || 'pages'] || ICON_PATHS.pages}></path>
                    </svg>
                    <div>
                      <h3>{s.label}</h3>
                      <h3>{s.value}</h3>
                    </div>
                  </div>
                ))}
              </div>
            )}
          </div>
          <div class="dl-hero-right">
            {imgFile && (
              <img
                class="dl-hero-book-img"
                src={imgDesktop}
                srcset={`${imgMobile} 600w, ${imgDesktop} 1000w`}
                sizes="(max-width: 1023px) 600px, 1000px"
                width={imgDims.width}
                height={imgDims.height}
                alt={b.image?.alt || ''}
                loading="eager"
                decoding="async"
              />
            )}
          </div>
        </div>
        {b.shapeDivider && (
          <svg class="dl-hero-shape" xmlns="http://www.w3.org/2000/svg"
               preserveAspectRatio="none" viewBox="0 0 1200 200"
               aria-hidden="true">
            <polygon fill-rule="evenodd" points="0 200 1200 0 1200 200"></polygon>
          </svg>
        )}
      </section>
    );
  }

  // ── audio-section — H2 + native HTML5 <audio controls> + Download Now link.
  // Replaces the WP h5ap-audioplayer / Plyr-styled player from #brxe-goqykk
  // (download page). Trait 5: <audio preload="none"> so the MP3 doesn't
  // download until the user clicks play. Browser-native controls are
  // accessible (keyboard, screen reader) and render consistently in
  // Chrome / Firefox / Safari without the 50KB+ of plugin CSS.
  if (b.type === 'audio-section') {
    return (
      <section class="dl-audio" id={b.id}>
        <div class="dl-audio-inner">
          {b.h2 && <h2 class="dl-audio-h2">{decodeText(b.h2)}</h2>}
          <audio class="dl-audio-player" controls preload="none">
            <source src={b.audioHref} type={b.audioMime || 'audio/mpeg'} />
            Your browser does not support the audio element. <a href={b.audioHref}>Download the audio file</a>.
          </audio>
          <a class="dl-audio-download" href={b.audioHref}
             target="_blank" rel="noopener noreferrer"
             download={b.downloadFilename || true}>
            <strong>{b.downloadLabel || 'Download Now'}</strong>
          </a>
        </div>
      </section>
    );
  }

  // ── title-card — centered hero: eyebrow row (—  TEXT  —) + H1.
  // Verified live #brxe-7d2e09 (the-pyramid-success page):
  //   Section: white bg, padding 40/20/0 mobile, 80/0/40/0 desktop.
  //   Eyebrow row: flex-row, justify-center, dividers flank H3 on both sides.
  //   Dividers: 1px top-border #616161, width 6% mobile / 10% desktop.
  //   Eyebrow text: H3 tag (semantic), styled small — Montserrat
  //   10px mobile / 15px desktop, color #696969, uppercase, margin-left 10px.
  //   H1: Bebas Neue 55px mobile / 60px desktop, color #000, line-height 1,
  //   text-align center, width 100%.
  // CAR: H3 used as a small eyebrow is unusual semantically — preserved
  // for Phase 3 fidelity, flagged for Phase 6 review.
  if (b.type === 'title-card') {
    return (
      <section class="tc-section" id={b.id}>
        <div class="tc-inner">
          <div class="tc-eyebrow-row">
            <span class="tc-eyebrow-divider" aria-hidden="true"></span>
            <h3 class="tc-eyebrow">{b.eyebrow}</h3>
            <span class="tc-eyebrow-divider" aria-hidden="true"></span>
          </div>
          <h1 class="tc-h1">{b.h1}</h1>
        </div>
      </section>
    );
  }

  // ── share-review-cta — Reviews Section 1 (#brxe-zuufjz).
  // Eyebrow row (— THE PYRAMID PRINCIPLE —) + H1 + subtitle + 2-col logo
  // row (Goodreads + Amazon) + yellow CTA pill below. Reuses title-card's
  // eyebrow + H1 styling so the page-top brand block is consistent across
  // /the-pyramid-success/, /free-resources/, and /reviews/.
  if (b.type === 'share-review-cta') {
    const logos = (b.logos || []) as any[];
    return (
      <section class="srv-section" id={b.id}>
        <div class="srv-inner">
          {b.eyebrow && (
            <div class="tc-eyebrow-row">
              <span class="tc-eyebrow-divider" aria-hidden="true"></span>
              <h3 class="tc-eyebrow">{b.eyebrow}</h3>
              <span class="tc-eyebrow-divider" aria-hidden="true"></span>
            </div>
          )}
          {b.h1 && <h1 class="srv-h1">{b.h1}</h1>}
          {b.subtitle && <p class="srv-subtitle">{decodeText(b.subtitle)}</p>}
          {logos.length > 0 && (
            <div class="srv-logo-row">
              {logos.map((l: any) => (
                <a class="srv-logo-link" href={l.href}
                   target="_blank" rel="noopener noreferrer"
                   aria-label={l.image?.alt || ''}>
                  <img src={srcW(l.image.file, 400)}
                       srcset={`${srcW(l.image.file, 240)} 240w, ${srcW(l.image.file, 400)} 400w, ${srcW(l.image.file, 600)} 600w`}
                       sizes="(max-width: 768px) 45vw, 220px"
                       width={l.image?.dims?.width || 800}
                       height={l.image?.dims?.height || 353}
                       alt={l.image?.alt || ''}
                       loading="lazy" decoding="async" />
                </a>
              ))}
            </div>
          )}
          {b.ctaHref && (
            <a class="srv-cta" href={b.ctaHref}
               target="_blank" rel="noopener noreferrer">
              {b.ctaLabel || 'Add Your Review'}
            </a>
          )}
        </div>
      </section>
    );
  }

  // ── pull-quote-row — Reviews Section 2 (#brxe-msqmva).
  // Three colored quote cards in a row (yellow / light blue / gray) per
  // live source. Each card: rounded-corner shape (40px top-left + bottom-
  // right), padding 40px, box-shadow, Libre Baskerville italic bold 32px
  // body color #1d1d1f. Source has 3 quotes; block supports N≥1.
  if (b.type === 'pull-quote-row') {
    const quotes = (b.quotes || []) as any[];
    const colors = ['srv-card-yellow', 'srv-card-blue', 'srv-card-gray'];
    return (
      <section class="srv-pull-section" id={b.id}>
        <div class="srv-pull-inner">
          {quotes.map((q: any, i: number) => (
            <div class={`srv-pull-card ${colors[i % colors.length]}`}>
              <p class="srv-pull-quote">{decodeText(q.text || q)}</p>
            </div>
          ))}
        </div>
      </section>
    );
  }

  // ── review-card-list — Reviews Section 3 (#brxe-cqjdpp).
  // Long list of alternating image/text rows. When the review has a
  // personal photo (image.file present), that photo renders in the image
  // column. Otherwise the Amazon-review banner renders, wrapped in the
  // same Amazon attribution link. imagePosition: 'left' | 'right' drives
  // which side the photo sits on (matches live alternation pattern).
  if (b.type === 'review-card-list') {
    const reviews = (b.reviews || []) as any[];
    const bannerFile = b.bannerImage?.file || 'how-to-get-amazon-reviews1-1.png';
    const bannerAlt = b.bannerImage?.alt || 'Leave a review on Amazon';
    return (
      <section class="rev-list-section" id={b.id}>
        <div class="rev-list-inner">
          {reviews.map((r: any) => {
            const personal = r.image?.file;
            const imgFile = personal || bannerFile;
            const imgAlt = personal ? (r.image?.alt || '') : bannerAlt;
            const imgDims = (personal ? r.image?.dims : null) || { width: 512, height: 275 };
            const isAmazon = !!r.sourceUrl && /amazon\.com/.test(r.sourceUrl);
            const side = r.imagePosition === 'left' ? 'left' : 'right';
            const ImgEl = (
              <img class={personal ? 'rev-photo' : 'rev-banner'}
                   src={srcW(imgFile, personal ? 800 : 600)}
                   srcset={`${srcW(imgFile, 400)} 400w, ${srcW(imgFile, 800)} 800w`}
                   sizes="(max-width: 1023px) 90vw, 480px"
                   width={imgDims.width} height={imgDims.height}
                   alt={imgAlt}
                   loading="lazy" decoding="async" />
            );
            const imgCol = (
              <div class="rev-img-col">
                {r.sourceUrl
                  ? <a href={r.sourceUrl} target="_blank" rel="noopener noreferrer" aria-label={imgAlt}>{ImgEl}</a>
                  : ImgEl}
              </div>
            );
            const bodyParas = Array.isArray(r.body) ? r.body : (r.body ? [r.body] : []);
            const textCol = (
              <div class="rev-text-col">
                {r.title && <h3 class="rev-title" set:html={r.title}></h3>}
                {bodyParas.map((para: string) => (
                  <p class="rev-body" set:html={para}></p>
                ))}
                <p class="rev-attrib">
                  {r.sourceUrl
                    ? (
                        <a href={r.sourceUrl} target="_blank" rel="noopener noreferrer">
                          - {r.reviewer}{r.source ? <> (From <span class="rev-source">{r.source}</span>)</> : null}
                        </a>
                      )
                    : <>- {r.reviewer}{r.source ? <> (From <span class="rev-source">{r.source}</span>)</> : null}</>}
                </p>
              </div>
            );
            return (
              <div class={`rev-row rev-img-${side}`}>
                {side === 'left' ? <>{imgCol}{textCol}</> : <>{textCol}{imgCol}</>}
              </div>
            );
          })}
        </div>
      </section>
    );
  }

  // ── pr-release-card — Media Center 2-column PR card.
  // Live source has 3 instances (#brxe-isnmrj / #brxe-rgtsli / #brxe-rtvxki),
  // each with: H2 + body text + yellow "Learn More" CTA + media (either a
  // YouTube facade — click-to-load — or an autoplay/loop/muted MP4).
  // imagePosition: 'left' | 'right' drives which side the media sits on
  // (Section 2 = right; Sections 4 + 6 = left).
  //
  // The live source wraps the media in <a href="…pacdora.com…"> on all 3
  // cards — Bricks editor leftover (the link is to a packaging-design
  // template, not a real destination). Dropped per Phase 3 editorial.
  if (b.type === 'pr-release-card') {
    const side = b.imagePosition === 'left' ? 'left' : 'right';
    let mediaEl: any = null;
    if (b.mediaType === 'youtube' && b.mediaSrc) {
      mediaEl = (
        <button
          type="button"
          class="yt-facade prc-yt-facade"
          data-yt-id={b.mediaSrc}
          data-yt-title={b.h2 || 'YouTube video'}
          aria-label={`Play video: ${b.h2 || 'YouTube video'}`}>
          <img class="yt-facade-poster"
               src={`https://i.ytimg.com/vi/${b.mediaSrc}/hqdefault.jpg`}
               width="480" height="360"
               alt={b.h2 || ''}
               loading="lazy" decoding="async" />
          <span class="yt-facade-play" aria-hidden="true">
            <svg width="68" height="48" viewBox="0 0 68 48"><path d="M66.52 7.74c-.78-2.93-2.49-5.41-5.42-6.19C55.79.13 34 0 34 0S12.21.13 6.9 1.55c-2.93.78-4.63 3.26-5.41 6.19C.08 13.05 0 24 0 24s.08 10.95 1.49 16.26c.78 2.93 2.48 5.41 5.41 6.19C12.21 47.87 34 48 34 48s21.79-.13 27.1-1.55c2.93-.78 4.64-3.26 5.42-6.19C67.92 34.95 68 24 68 24s-.08-10.95-1.48-16.26z" fill="#f00"/><path d="M45 24 27 14v20" fill="#fff"/></svg>
          </span>
        </button>
      );
    } else if (b.mediaType === 'mp4' && b.mediaSrc) {
      mediaEl = (
        <video
          class="prc-mp4"
          src={b.mediaSrc}
          autoplay
          loop
          muted
          playsinline
          preload="metadata"
          aria-label={b.h2 || ''}
        ></video>
      );
    }
    const mediaCol = (
      <div class="prc-media-col">
        <div class="prc-media-wrap">{mediaEl}</div>
      </div>
    );
    const textCol = (
      <div class="prc-text-col">
        {b.h2 && <h2 class="prc-h2">{decodeText(b.h2)}</h2>}
        {b.body && <div class="prc-body" set:html={b.body}></div>}
        {b.ctaHref && (
          <a class="prc-cta" href={b.ctaHref} target="_blank" rel="noopener noreferrer">
            {b.ctaLabel || 'Learn More'}
          </a>
        )}
      </div>
    );
    return (
      <section class={`prc-section prc-media-${side}`} id={b.id}>
        <div class="prc-inner">
          {side === 'left' ? <>{mediaCol}{textCol}</> : <>{textCol}{mediaCol}</>}
        </div>
      </section>
    );
  }

  // ── press-logo-grid — Media Center responsive grid of clickable
  // press-logo cards. Live source has 2 instances (#brxe-clphik = 26 logos,
  // Generosity Campaign placements; #brxe-recpnz = 16 logos, Cori Close
  // placements). Each cell: link with logo image, hover lift. Images use
  // object-fit: contain so the varied aspect-ratios center cleanly within
  // a uniform card. CAR: items 1–16 are generic PR Newswire screenshots
  // (recycled between the two grids) — flagged for proper outlet logos
  // in Phase 6 polish.
  if (b.type === 'press-logo-grid') {
    const logos = (b.logos || []) as any[];
    return (
      <section class="plg-section" id={b.id}>
        <div class="plg-grid">
          {logos.map((l: any) => {
            const file = l.image?.file;
            if (!file || !l.href) return null;
            const dimsX = l.image?.dims || { width: 1024, height: 726 };
            return (
              <a class="plg-card" href={l.href} target="_blank" rel="noopener noreferrer"
                 aria-label={l.image?.alt || 'Press coverage'}>
                <img src={srcW(file, 400)}
                     srcset={`${srcW(file, 240)} 240w, ${srcW(file, 400)} 400w, ${srcW(file, 600)} 600w`}
                     sizes="(max-width: 640px) 90vw, (max-width: 1023px) 45vw, 320px"
                     width={dimsX.width} height={dimsX.height}
                     alt={l.image?.alt || ''}
                     loading="lazy" decoding="async" />
              </a>
            );
          })}
        </div>
      </section>
    );
  }

  // ── languages-callout — verified live #brxe-lsgkhj (Retailers
  // Section 12, "Top 20 Languages of the World"). Side-by-side
  // (NOT stacked as user spec implied — verified flex-row desktop)
  // layout: image left, H5 + 20-item language list right. Bold
  // editorial markers on items 1-4 + 13 correspond to the book's
  // current/planned editions (English, Mandarin, Hindi, Spanish,
  // Japanese).
  if (b.type === 'languages-callout') {
    const img = b.image || {};
    const langs = (b.languages || []) as any[];
    return (
      <section class="jv-langs" id={b.id}>
        <div class="jv-langs-container">
          <div class="jv-langs-image-wrap">
            {img.sanityUrl && (
              <img class="jv-langs-img"
                   src={imgUrl(img, 1024)}
                   width={img?.dims?.width || 640}
                   height={img?.dims?.height || 427}
                   alt={img.alt || ''}
                   loading="lazy" decoding="async" />
            )}
          </div>
          <div class="jv-langs-text-wrap">
            {b.heading && <h5 class="jv-langs-h5">{decodeText(b.heading)}</h5>}
            {langs.length > 0 && (
              <ul class="jv-langs-list">
                {langs.map((l: any) => (
                  <li>
                    {l.bold
                      ? <strong>{decodeText(l.text)}</strong>
                      : decodeText(l.text)}
                  </li>
                ))}
              </ul>
            )}
          </div>
        </div>
      </section>
    );
  }

  // ── populations-block — verified live #brxe-qpgplg (Retailers
  // Section 11, "Populations"). H2 + 2-col bullet list (split into
  // two <ul>s for a clean 4-left / 5-right desktop split, stacking
  // on mobile) + below-list image. Source has the list duplicated
  // for responsive purposes (single-col mobile, 2-col desktop both
  // present in markup with display:none toggling); rebuilt as a
  // single semantic structure with CSS-driven layout.
  if (b.type === 'populations-block') {
    const left = (b.itemsLeft || []) as any[];
    const right = (b.itemsRight || []) as any[];
    const renderItems = (items: any[]) => (
      <ul>
        {items.map((it: any) => (
          <li>
            {decodeText(it.text)}
            {it.subitems && it.subitems.length > 0 && (
              <ul>
                {it.subitems.map((s: string) => (<li>{decodeText(s)}</li>))}
              </ul>
            )}
          </li>
        ))}
      </ul>
    );
    const img = b.image || null;
    return (
      <section class="jv-pop" id={b.id}>
        <div class="jv-pop-container">
          <div class="jv-pop-text">
            {b.heading && <h2 class="jv-pop-h2">{decodeText(b.heading)}</h2>}
            <div class="jv-pop-list-grid">
              {renderItems(left)}
              {renderItems(right)}
            </div>
          </div>
          {img && img.sanityUrl && (
            <div class="jv-pop-image-wrap">
              <img class="jv-pop-image"
                   src={imgUrl(img, 1024)}
                   width={img?.dims?.width || 640}
                   height={img?.dims?.height || 480}
                   alt={img.alt || ''}
                   loading="lazy" decoding="async" />
            </div>
          )}
        </div>
      </section>
    );
  }

  // ── stats-card-grid — verified live #brxe-asxjua (Retailers Section 9,
  // "NBA"). H2 + intro paragraph + N-card grid where each card is a
  // light-gray rounded box with image / colored title / body. Designed
  // to be reused for follow-up "stats / pitch" sections that share
  // this card style.
  if (b.type === 'stats-card-grid') {
    const cards = (b.cards || []) as { image: any; title: string; body: string }[];
    return (
      <section class="jv-stats" id={b.id}>
        <div class="jv-stats-container">
          {b.heading && <h2 class="jv-stats-h2">{decodeText(b.heading)}</h2>}
          {b.intro && <p class="jv-stats-intro">{decodeText(b.intro)}</p>}
          <div class="jv-stats-grid">
            {cards.map(c => {
              const im = c.image || {};
              const d = im.dims || (() => { try { return dims(im.file); } catch { return { width: 612, height: 459 }; } })();
              return (
                <div class="jv-stats-card">
                  {im.sanityUrl && (
                    <img class="jv-stats-img"
                         src={imgUrl(im, 800)}
                         width={d.width} height={d.height}
                         alt={im.alt || c.title || ''}
                         loading="lazy" decoding="async" />
                  )}
                  <h3 class="jv-stats-title">{decodeText(c.title)}</h3>
                  <p class="jv-stats-body">{decodeText(c.body)}</p>
                </div>
              );
            })}
          </div>
        </div>
      </section>
    );
  }

  // ── themed-list-callout — verified live #brxe-wehpoc (Retailers
  // Section 8, "Global Interest"). Three-part section: H2 + ordered
  // list on the left, 3-image staggered collage on the right, then a
  // full-width italic stat callout below both columns. The collage
  // markup mirrors the image-collage-card 3-image pattern but with
  // NO borders on the staggered images (verified). The stat callout
  // (#brxe-hrznsc) is markup-as-H3 in source but semantically a
  // long-form stat paragraph — re-rendered as <p>.
  if (b.type === 'themed-list-callout') {
    const items = (b.listItems || []) as string[];
    const images = (b.images || []) as any[];
    return (
      <section class="jv-gi" id={b.id}>
        <div class="jv-gi-container">
          <div class="jv-gi-grid">
            <div class="jv-gi-left">
              {b.heading && <h2 class="jv-gi-h2">{decodeText(b.heading)}</h2>}
              {items.length > 0 && (
                <ol class="jv-gi-list">
                  {items.map(i => (<li>{decodeText(i)}</li>))}
                </ol>
              )}
            </div>
            <div class="jv-gi-right">
              {images.slice(0, 3).map((im, i) => {
                if (!im || !im.file) return null;
                const d = im.dims || (() => { try { return dims(im.file); } catch { return { width: 1024, height: 600 }; } })();
                return (
                  <img class={`jv-gi-img jv-gi-img-${i + 1}`}
                       src={imgUrl(im, 1024)}
                       width={d.width} height={d.height}
                       alt={im.alt || ''}
                       loading="lazy" decoding="async" />
                );
              })}
            </div>
          </div>
          {b.statCallout && (
            <p class="jv-gi-stat">{decodeText(b.statCallout)}</p>
          )}
        </div>
      </section>
    );
  }

  // ── centered-callout — verified live #brxe-qfoozj (Retailers Section 7,
  // "A Heart-Gripping Story of Championship Resilience"). Centered H2 +
  // body subtitle above a 2-column image strip. Two images sit side-by-side
  // at 50% each on both viewports (verified). Pattern is reusable for any
  // "H2 + lede + side-by-side image pair" section.
  if (b.type === 'centered-callout') {
    const images = (b.images || []) as any[];
    return (
      <section class="jv-cc" id={b.id}>
        <div class="jv-cc-container">
          {b.heading && <h2 class="jv-cc-h2">{decodeText(b.heading)}</h2>}
          {b.body && <p class="jv-cc-body">{decodeText(b.body)}</p>}
          {images.length > 0 && (
            <div class="jv-cc-images">
              {images.map(im => {
                if (!im || !im.file) return null;
                const d = im.dims || (() => { try { return dims(im.file); } catch { return { width: 1250, height: 750 }; } })();
                return (
                  <img class="jv-cc-img"
                       src={imgUrl(im, 1200)}
                       width={d.width} height={d.height}
                       alt={im.alt || ''}
                       loading="lazy" decoding="async" />
                );
              })}
            </div>
          )}
        </div>
      </section>
    );
  }

  // ── translation-grid — verified live #brxe-qwjjpw (Retailers Section 6,
  // "Translation Editions — Coming Soon"). Centered Libre-Baskerville
  // header followed by a 4-card grid (book cover + language label).
  // Each card optionally has a sublabel rendered smaller below the
  // main label (used by the Chinese card for "(Mandarin)" qualifier).
  if (b.type === 'translation-grid') {
    const cards = (b.cards || []) as { label: string; sublabel?: string; image: any }[];
    return (
      <section class="jv-tg" id={b.id}>
        <div class="jv-tg-header">
          {b.heading && <h3 class="jv-tg-heading">{decodeText(b.heading)}</h3>}
        </div>
        <div class="jv-tg-grid">
          {cards.map(c => {
            const im = c.image || {};
            const d = im.dims || (() => { try { return dims(im.file); } catch { return { width: 480, height: 720 }; } })();
            return (
              <div class="jv-tg-card">
                {im.sanityUrl && (
                  <img class="jv-tg-img"
                       src={imgUrl(im, 600)}
                       width={d.width} height={d.height}
                       alt={im.alt || c.label}
                       loading="lazy" decoding="async" />
                )}
                <h3 class="jv-tg-label">{decodeText(c.label)}</h3>
                {c.sublabel && (
                  <p class="jv-tg-sublabel">{decodeText(c.sublabel)}</p>
                )}
              </div>
            );
          })}
        </div>
      </section>
    );
  }

  // ── amazon-marketplaces — verified live #brxe-xodthq / #brxe-dunvhj /
  // #brxe-yqloaa / #brxe-eaupau / #brxe-spkuhj. Retailers section 4.
  // Outer section: full-width white background with a centered outer H2.
  // Inner yellow card (#FFD100, border-radius 10px, padding 25px) holds
  // an inner H2 (Montserrat 20px wt 700 UCLA blue uppercase) and a
  // flex-wrap grid of country buttons. Each button is a .pill-cta-gray
  // (light-gray pill on yellow card — the same component already used
  // for the homepage Free Resources banner).
  if (b.type === 'amazon-marketplaces') {
    const stores = (b.stores || []) as { label: string; href: string }[];
    // Optional per-instance overrides routed through CSS vars so a
    // single block type covers both color palettes used on Retailers:
    //   - Amazon Marketplaces: yellow card, UCLA-blue centered H2
    //   - Other International Retailers: UCLA-blue card, yellow LEFT H2
    const cardBg = b.cardBg || 'var(--color-brand-yellow, #ffd100)';
    const headingColor = b.headingColor || 'var(--color-author-blue, #2774AE)';
    const headingAlign = b.headingAlign || 'center';
    const styleVars = [
      `--amzn-card-bg: ${cardBg}`,
      `--amzn-h-color: ${headingColor}`,
      `--amzn-h-align: ${headingAlign}`,
    ].join('; ');
    return (
      <section class="jv-amzn" id={b.id} style={styleVars}>
        <div class="jv-amzn-container">
          {b.outerHeading && (
            <h2 class="jv-section-h2-banner-text jv-amzn-outer-h2">{decodeText(b.outerHeading)}</h2>
          )}
          <div class="jv-amzn-card">
            {b.innerHeading && (
              <h2 class="jv-amzn-inner-h2">{decodeText(b.innerHeading)}</h2>
            )}
            <div class="jv-amzn-grid">
              {stores.map(s => (
                <a class="pill-cta-gray jv-amzn-btn"
                   href={s.href}
                   target="_blank"
                   rel="noopener noreferrer">{decodeText(s.label)}</a>
              ))}
            </div>
          </div>
        </div>
      </section>
    );
  }

  // ── metadata-list — verified live #brxe-txqwye (Retailers ISBN list).
  // Rows of label/value pairs. Source uses double-H3 markup (Bricks
  // editor quirk); re-rendered here as a semantic <dl>/<dt>/<dd> for
  // accessibility. Label: Montserrat 15px wt 700 uppercase #212121.
  // Value: Montserrat 14-15px wt 400 #424242.
  if (b.type === 'metadata-list') {
    const items = (b.items || []) as { label: string; value: string }[];
    return (
      <section class="jv-meta-list" id={b.id}>
        <dl class="jv-meta-list-inner">
          {items.map(it => (
            <div class="jv-meta-row">
              <dt class="jv-meta-label">{decodeText(it.label)}</dt>
              <dd class="jv-meta-value">{decodeText(it.value)}</dd>
            </div>
          ))}
        </dl>
      </section>
    );
  }

  // ── categories-publisher — verified live #brxe-bgdzcm (Retailers).
  // Two-column on desktop, stacked on mobile.
  // LEFT  : H3 "Look for it under:" + 1-N breadcrumb rows of strings.
  //         Source rendered each crumb as an H3 with an Ion arrow icon
  //         between them. Re-semanticized as <nav><ol> breadcrumbs with
  //         a literal "›" character between crumbs.
  // RIGHT : Publisher logo image + multi-line address/contact block.
  //         Phone line auto-rendered as <a href="tel:…"> for mobile
  //         click-to-call.
  if (b.type === 'categories-publisher') {
    const cats = (b.categories || []) as string[][];
    const pub = b.publisher || {};
    return (
      <section class="jv-cp" id={b.id}>
        <div class="jv-cp-container">
          <div class="jv-cp-left">
            {b.categoriesHeading && (
              <h3 class="jv-cp-heading">{decodeText(b.categoriesHeading)}</h3>
            )}
            {cats.map(crumbs => (
              <nav class="jv-cp-crumbs" aria-label="Book category">
                <ol class="jv-cp-crumbs-ol">
                  {crumbs.map((c, i) => (
                    <>
                      <li class="jv-cp-crumb">{decodeText(c)}</li>
                      {i < crumbs.length - 1 && (
                        <li class="jv-cp-sep" aria-hidden="true">›</li>
                      )}
                    </>
                  ))}
                </ol>
              </nav>
            ))}
          </div>
          <div class="jv-cp-right">
            {pub.logo && pub.logo.sanityUrl && (
              <img class="jv-cp-logo"
                   src={imgUrl(pub.logo, 600)}
                   width={pub.logo?.dims?.width || 300}
                   height={pub.logo?.dims?.height || 51}
                   alt={pub.logo.alt || 'Spirit Media Publishing'}
                   loading="lazy" decoding="async" />
            )}
            {pub.lines && (
              <div class="jv-cp-pubtext">
                {(pub.lines as any[]).map((line, i) => (
                  <>
                    {i > 0 && <br />}
                    {line.type === 'link'
                      ? <a href={line.href} target="_blank" rel="noopener noreferrer">{line.text}</a>
                      : line.type === 'tel'
                        ? <a href={line.href}>{line.text}</a>
                        : line.text}
                  </>
                ))}
              </div>
            )}
          </div>
        </div>
      </section>
    );
  }

  // ── standalone highlight-card (reusable block; can appear at top level) ──
  if (b.type === 'highlight-card') {
    const lines = b.lines || (b.text ? [b.text] : []);
    return (
      <div class="jv-highlight-card jv-highlight-card-standalone">
        {lines.map((line: string, i: number) => (
          <>{i > 0 && <br />}{line}</>
        ))}
      </div>
    );
  }

  // ── legacy block: highlight-cards (array form, kept for back-compat) ──
  if (b.type === 'highlight-cards') {
    return (
      <section class="jv-highlights">
        <div class="jv-highlights-grid">
          {b.items.map((text: string) => (
            <div class="jv-highlight-card">{decodeText(text)}</div>
          ))}
        </div>
      </section>
    );
  }

  if (b.type === 'featured-podcasts') {
    return (
      <section class="jv-podcasts">
        <div class="jv-podcasts-container">
          <h2 class="jv-section-h2">{b.heading}</h2>
          <div class="jv-podcast-grid">
            {b.cards.map((c: any) => (
              <a class="jv-podcast-card" href={c.href} target="_blank" rel="noopener noreferrer">
                <img src={imgUrl(c.image, 500)}
                     width={c.image?.dims?.width || 1024}
                     height={c.image?.dims?.height || 1024}
                     alt="Podcast episode" loading="lazy" decoding="async" />
              </a>
            ))}
          </div>
        </div>
      </section>
    );
  }

  // ── join-movement — final section of /give-courage/. 2-col layout:
  // image on left, H2 + body paragraphs on right. Verified live
  // #brxe-2894dc (section) / #brxe-gfwebg (row) / #brxe-nvpwle (image,
  // 40% width) / #brxe-ifyquf (text, 60% width + 40px left padding).
  //
  //   Section: padding 40px 40px 100px desktop / 0 20px 40px mobile.
  //   H2 (#brxe-2fa826): color #212121, line-height 1em, text-align left,
  //     pink span (#F999CB) on "Join".
  //   Body (#brxe-tgjhzf): DM Sans 18px desktop / Roboto 16px mobile,
  //     mt 10px, mb 20px.
  //
  // bodyParagraphs accepts strings (plain text) or {html: "..."} objects
  // (for paragraphs with inline markup like the pink-bold closing line +
  // italic attribution).
  //
  // Mobile order: image on top, text below per user direction (source
  // had order:1 on image col putting it BELOW text on mobile; rebuild
  // overrides to image-first which reads better as a poster-style hero).
  if (b.type === 'join-movement') {
    const rawBody = b.bodyParagraphs || (b.bodyHtml ? [b.bodyHtml] : []);
    const paras: any[] = Array.isArray(rawBody) ? rawBody : [rawBody];
    return (
      <section class="jm-section" id={b.id}>
        <div class="jm-row">
          <div class="jm-col-image">
            <img class="jm-image"
                 src={imgUrl(b.image, 1200)}
                 srcset={`${imgUrl(b.image, 600)} 600w, ${imgUrl(b.image, 1200)} 1200w`}
                 sizes="(max-width: 1024px) 100vw, 480px"
                 width={b.image?.dims?.width || 1070}
                 height={b.image?.dims?.height || 998}
                 alt={b.image?.alt || ''}
                 loading="lazy" decoding="async" />
          </div>
          <div class="jm-col-content">
            <h2 class="jm-h2" set:html={b.headingHtml} />
            {paras.map((p: any) => (
              p && typeof p === 'object' && p.html
                ? <p class="jm-p" set:html={p.html} />
                : <p class="jm-p">{decodeText(p)}</p>
            ))}
          </div>
        </div>
      </section>
    );
  }

  // ── centered-h3-banner — single centered uppercase H3 with optional
  // pink spans. Verified live #brxe-tnuoce on /give-courage/ Section 4.
  //   H3 inherits global Bebas Neue (40px desktop / 30px mobile), color
  //   #1d1d1f (--bricks-color-gbinls), text-align center, text-transform
  //   uppercase, margin-bottom 20px. Mobile adds padding 20px sides.
  //   Pink spans (#F999CB) on emphasized phrases.
  if (b.type === 'centered-h3-banner') {
    return (
      <section class="ch3-section" id={b.id}>
        <h3 class="ch3-heading" set:html={b.heading} />
      </section>
    );
  }

  // ── smg-banner — 3-column H3 banner (Spirit Media Gives + Tax ID +
  // tax-note). Structurally identical to give-courage-banner but with
  // H3 sizing across all 3 columns. Verified live #brxe-jzdroj /
  // #brxe-sjanxy / #brxe-nwfbmd / #brxe-jiokqo on /give-courage/.
  // Same UCLA-blue 5px left border + light gray bg on col 2 desktop;
  // mobile rounded gray card. Pink span (#F999CB) on "GIVES" in col 1.
  if (b.type === 'smg-banner') {
    return (
      <section class="smg-section" id={b.id}>
        <div class="smg-inner">
          <div class="smg-col smg-col-1">
            <h3 class="smg-h3" set:html={b.heading1} />
          </div>
          <div class="smg-col smg-col-2">
            <h3 class="smg-h3" set:html={b.heading2} />
          </div>
          <div class="smg-col smg-col-3">
            <h3 class="smg-h3" set:html={b.heading3} />
          </div>
        </div>
      </section>
    );
  }

  // ── pcrf-section — 2-column section: text (eyebrow + H1 + body) on
  // left, image with caption on right. Verified live #brxe-0ee7ef
  // (container) + #brxe-653495 (text) + #brxe-b7be77 (image) on
  // /give-courage/ Section 3.
  //   Container: flex-row wrap, justify-between, align-flex-start,
  //     padding 60px 0 80px desktop, 40px 20 0 mobile.
  //   Text col: width 48% desktop / 100% mobile.
  //   Image col: width 48% desktop / 100% mobile, align-items center.
  //   Eyebrow: short divider + H6 inline (same pattern as bio hero).
  //   H1: color #000, pink (#F999CB) span on "cancer research".
  //   Body: DM Sans 18px / Roboto 16px mobile, color #424242 inferred.
  //   Caption: margin 10/0/30, color #696969, center, font-size 13px
  //     mobile (inherits global p mobile size desktop).
  if (b.type === 'pcrf-section') {
    return (
      <section class="pcrf-section" id={b.id}>
        <div class="pcrf-grid">
          <div class="pcrf-text">
            <div class="pcrf-eyebrow-row">
              <span class="pcrf-eyebrow-divider" aria-hidden="true"></span>
              <h6 class="pcrf-eyebrow">{decodeText(b.eyebrow)}</h6>
            </div>
            <h1 class="pcrf-h1" set:html={b.heading} />
            <p class="pcrf-body" set:html={b.bodyHtml} />
          </div>
          <div class="pcrf-media">
            <img class="pcrf-image"
                 src={imgUrl(b.image, 1200)}
                 srcset={`${imgUrl(b.image, 600)} 600w, ${imgUrl(b.image, 1200)} 1200w`}
                 sizes="(max-width: 1024px) 100vw, 580px"
                 width={b.image?.dims?.width || 1024}
                 height={b.image?.dims?.height || 537}
                 alt={b.image?.alt || ''}
                 loading="lazy" decoding="async" />
            {b.caption && <p class="pcrf-caption">{decodeText(b.caption)}</p>}
          </div>
        </div>
      </section>
    );
  }

  // ── donation-section — 2-column section with inline YouTube video on
  // left and stacked text blocks + Givebutter widget on right. Verified
  // live #brxe-npnnxp on /give-courage/ Section 2.
  //
  //   Section (#brxe-npnnxp): margin 60px 0 desktop / 40px 0 mobile,
  //     padding 0 20px mobile.
  //   Inner card (#brxe-fdblis): bg #fff, 1px border rgba(158,158,158,.44),
  //     border-radius 25px, padding 25px 80px 40px (top/x/bottom) desktop,
  //     padding-x 20px mobile.
  //   Left col (#brxe-adavwp): video wrapper, padding 40px 0 desktop /
  //     20px 0 mobile, border-radius 25px.
  //   Right col (#brxe-ubarsx): flex-row wrap, holds all text blocks.
  //   Text blocks separated by margin-top 15px each.
  //   CTA heading id="brxe-fwyksz" — Section 1 banner's CTA anchors here.
  //
  // YouTube embed: youtube-nocookie.com (already in CSP), loading="lazy"
  // for perf (this is below the fold). User direction: no autoplay,
  // keep loop=1 for when user clicks play.
  //
  // Givebutter widget: <givebutter-widget id="..."></givebutter-widget>.
  // Script loaded on the page (added in give-courage.astro Layout head
  // slot). CSP already updated.
  if (b.type === 'donation-section') {
    const tiers = b.tiers || [];
    return (
      <section class="ds-section" id={b.id}>
        <div class="ds-card">
          <div class="ds-row">
            <div class="ds-col-video">
              <div class="ds-video-wrap">
                <iframe class="ds-video"
                        src={`https://www.youtube-nocookie.com/embed/${b.videoId}?loop=1&playlist=${b.videoId}&rel=0`}
                        title={b.videoTitle || 'YouTube video'}
                        loading="lazy"
                        allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                        allowfullscreen></iframe>
              </div>
            </div>
            <div class="ds-col-content">
              {b.intro && (
                <div class="ds-block ds-intro">
                  {(b.intro.paragraphs || []).map((p: string) => (
                    <p class="ds-p">{decodeText(p)}</p>
                  ))}
                  {b.intro.quote && (
                    <p class="ds-pink-quote">{decodeText(b.intro.quote)}</p>
                  )}
                  {b.intro.attribution && (
                    <p class="ds-attribution">{decodeText(b.intro.attribution)}</p>
                  )}
                </div>
              )}
              {b.cancerTouches && (
                <div class="ds-block">
                  <p class="ds-p">
                    <strong class="ds-pink-label">{decodeText(b.cancerTouches.label)}</strong>{' '}
                    {decodeText(b.cancerTouches.body)}
                  </p>
                </div>
              )}
              {b.joinPartners && (
                <div class="ds-block">
                  <p class="ds-p">{decodeText(b.joinPartners)}</p>
                </div>
              )}
              {tiers.length > 0 && (
                <ul class="ds-block ds-tiers">
                  {tiers.map((t: any) => (
                    <li><strong>{t.amount}</strong> impacts <strong>{t.impact}</strong></li>
                  ))}
                </ul>
              )}
              {b.shellyQuote && (
                <div class="ds-block ds-testimonial">
                  <p class="ds-pink-quote">{decodeText(b.shellyQuote.quote)}</p>
                  <p class="ds-attribution">{decodeText(b.shellyQuote.attribution)}</p>
                </div>
              )}
              {b.ctaHeading && (
                <h3 class="ds-cta-heading" id={b.ctaHeadingId || 'brxe-fwyksz'}>
                  {decodeText(b.ctaHeading)}
                </h3>
              )}
              {b.givebutterId && (
                <div class="ds-widget">
                  <givebutter-widget id={b.givebutterId}></givebutter-widget>
                </div>
              )}
              {b.footerNote && (
                <p class="ds-footer-note">{decodeText(b.footerNote)}</p>
              )}
            </div>
          </div>
        </div>
      </section>
    );
  }

  // ── give-courage-banner — 3-column horizontal row banner.
  // Verified live #brxe-vccsio (container) + #brxe-zrcwzw / #brxe-esvzkt /
  // #brxe-hygaos (3 columns) on /give-courage/ Section 1.
  //
  //   Container (#brxe-vccsio): flex-row wrap + justify-between + align-
  //     stretch desktop (padding-top 40px). Flex-column + centered mobile.
  //   Col 1 (#brxe-zrcwzw) — H2-1 wrapper: width 32% desktop / 100% mobile,
  //     justify-content center. H2-1 inside is text-align RIGHT desktop /
  //     CENTER mobile, color #212121, line-height 1em. Pink spans (#F999CB)
  //     on "GIVE" and "COURAGE".
  //   Col 2 (#brxe-esvzkt) — H2-2 wrapper: width 32% desktop / 100% mobile.
  //     Distinctive accent: 5px UCLA-blue left border (#2196f3) + light gray
  //     bg #f5f5f5 + padding 10px/10/10/20. Mobile: no border, rounded card
  //     (border-radius 15px), padding 30px 20px, margin 20px 0.
  //     H2-2 inside is text-align LEFT desktop / CENTER mobile. Pink span
  //     on "400,000".
  //   Col 3 (#brxe-hygaos) — CTA + tax note: width 32% desktop / 100% mobile,
  //     justify-content + align-items center, align-self center.
  //   CTA (#brxe-tyylvt): bg pink #F999CB, border 1px rgba(33,33,33,.26),
  //     box-shadow 0 2px 3px 1px rgba(112,94,0,.47), padding-right 10px,
  //     margin-top 10px desktop / 0 mobile.
  //   Tax note: source uses H3 (#brxe-onssmv) but user wants small grey
  //     text — rebuild renders as <p class="gcb-tax"> (semantic + visual
  //     downgrade); CAR item logged.
  if (b.type === 'give-courage-banner') {
    return (
      <section class="gcb-section" id={b.id}>
        <div class="gcb-inner">
          <div class="gcb-col gcb-col-1">
            <h2 class="gcb-h2 gcb-h2-1" set:html={b.heading1} />
          </div>
          <div class="gcb-col gcb-col-2">
            <h2 class="gcb-h2 gcb-h2-2" set:html={b.heading2} />
          </div>
          <div class="gcb-col gcb-col-3">
            <a class="gcb-cta" href={b.ctaHref}>{b.ctaLabel || 'Give Courage'}</a>
            {b.taxNote && <p class="gcb-tax">{b.taxNote}</p>}
          </div>
        </div>
      </section>
    );
  }

  // ── photo-carousel — verified live #brxe-rboxpg ──
  // Swiper.js horizontal carousel: 5/2 slidesPerView desktop/mobile,
  // spaceBetween 5px, loop+autoplay 3s, speed 300ms. Slides are bg-image
  // tiles 250px desktop / 150px mobile. Wrapper <a> opens a PhotoSwipe
  // lightbox with full-res 2560w sources. Section margin -80px top desktop
  // / -50px mobile (pulls into the H2 section above). Arrows: #2196f3,
  // prev left:50px / next right:50px. Init deferred per Trait 5.
  if (b.type === 'photo-carousel') {
    const slides = (b.slides || []).map((s: any) => {
      const thumb = srcW(s.file, 1024);
      const full = srcW(s.file, 2560);
      const d = dims(s.file);
      return { thumb, full, w: d.width, h: d.height, alt: s.alt || '' };
    });
    const cfg = b.config || {};
    return (
      <section class="jv-photo-carousel" id={b.id}
               data-slides-desktop={cfg.slidesPerViewDesktop ?? 5}
               data-slides-mobile={cfg.slidesPerViewMobile ?? 2}
               data-space-between={cfg.spaceBetween ?? 5}
               data-loop={cfg.loop === false ? 'false' : 'true'}
               data-autoplay-delay={cfg.autoplayDelay ?? 3000}
               data-speed={cfg.speed ?? 300}
               data-breakpoint={cfg.breakpoint ?? 991}>
        <div class="swiper jv-photo-swiper">
          <div class="swiper-wrapper">
            {slides.map((s) => (
              <div class="swiper-slide jv-photo-slide">
                <a class="jv-photo-link"
                   href={s.full}
                   data-pswp-src={s.full}
                   data-pswp-width={s.w}
                   data-pswp-height={s.h}
                   target="_blank"
                   rel="noopener noreferrer">
                  <img src={s.thumb}
                       width={s.w} height={s.h}
                       alt={s.alt}
                       loading="lazy" decoding="async" />
                </a>
              </div>
            ))}
          </div>
        </div>
        <button type="button" class="jv-photo-prev" aria-label="Previous photo">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
        </button>
        <button type="button" class="jv-photo-next" aria-label="Next photo">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
        </button>
      </section>
    );
  }

  // ── video-popup-grid — verified live #brxe-glibgo ──
  // 9 tiles, 4-per-row desktop (24% wide), 2-per-row mobile (49% wide).
  // Tile is a <button> (not <a>) with full-bleed YouTube poster as bg-image,
  // play icon centered. Click opens a shared <dialog> modal with autoplay iframe.
  // Modal JS deferred per Trait 5.
  if (b.type === 'video-popup-grid') {
    return (
      <section class="jv-videos" id={b.id}>
        <div class="jv-videos-container">
          {b.heading && <h2 class="jv-section-h2 jv-videos-h2">{b.heading}</h2>}
          <div class="jv-video-grid">
            {b.tiles.map((t: any, i: number) => (
              <div class="jv-video-tile-wrap">
                <button
                  type="button"
                  class="jv-video-tile"
                  data-youtube-id={t.videoId}
                  aria-label={`Play ${t.label || `video ${i + 1}`} of ${b.tiles.length}`}
                  style={`background-image: url(${t.poster});`}
                >
                  <span class="jv-play-icon" aria-hidden="true">
                    <svg width="60" height="60" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 14.5v-9l6 4.5-6 4.5z"/></svg>
                  </span>
                </button>
              </div>
            ))}
          </div>
        </div>
      </section>
    );
  }

  // ── dedication — verified live #brxe-zzvjem ──
  // Standalone section: H2 "DEDICATION" + 4-paragraph body. Single centered
  // flex column. Desktop: margin-top 80px, padding 40px 0, inner container
  // padding 40px 0, body width 900px. Mobile: margin-top 40px, padding 0,
  // inner padding 20px, body width auto. H2: Bebas Neue 55/40px, weight 700,
  // color #1d1d1f. Body: DM Sans 18px desktop / Roboto 16px mobile, color
  // rgb(97,97,97). Body margin: 10px 0 30px desktop, 15px 0 0 mobile.
  if (b.type === 'dedication') {
    const paragraphs = b.paragraphs && b.paragraphs.length
      ? b.paragraphs
      : (b.body ? [b.body] : []);
    return (
      <section class="jv-dedication" id={b.id}>
        <div class="jv-dedication-container">
          <h2 class="jv-dedication-h2">{b.heading || 'DEDICATION'}</h2>
          <div class="jv-dedication-body">
            {paragraphs.map((p: string) => (
              <p>{decodeText(p)}</p>
            ))}
          </div>
        </div>
      </section>
    );
  }

  // ── player-grid — reuses the existing player-card layout ──
  // Split out from the legacy dedication-and-players block.
  if (b.type === 'player-grid') {
    return (
      <section class="jv-players">
        <div class="jv-players-container">
          {b.heading && <h2 class="jv-section-h2 jv-center jv-players-h2">{decodeText(b.heading)}</h2>}
          <div class="jv-player-grid">
            {(b.cards || []).map((p: any) => (
              <a class="jv-player-card" href={p.href} target="_blank" rel="noopener noreferrer">
                {p.image && p.image.sanityUrl && (
                  <img src={imgUrl(p.image, 300)}
                       width={p.image?.dims?.width || 220}
                       height={p.image?.dims?.height || 220}
                       alt={p.name} loading="lazy" decoding="async" />
                )}
                <span class="jv-player-name">{p.name}</span>
              </a>
            ))}
          </div>
        </div>
      </section>
    );
  }

  // ── legacy combined dedication+players (kept for back-compat only) ──
  if (b.type === 'dedication-and-players') {
    return (
      <section class="jv-dedication">
        <div class="jv-dedication-container">
          <h2 class="jv-section-h2 jv-center">{b.dedicationHeading}</h2>
          <p class="jv-dedication-body">{decodeText(b.dedicationBody)}</p>
          <h2 class="jv-section-h2 jv-center jv-players-h2">{b.playersHeading}</h2>
          <div class="jv-player-grid">
            {b.playerCards.map((p: any) => (
              <a class="jv-player-card" href={p.href} target="_blank" rel="noopener noreferrer">
                {p.image && p.image.sanityUrl && (
                  <img src={imgUrl(p.image, 300)}
                       width={p.image?.dims?.width || 220}
                       height={p.image?.dims?.height || 220}
                       alt={p.name} loading="lazy" decoding="async" />
                )}
                <span class="jv-player-name">{p.name}</span>
              </a>
            ))}
          </div>
        </div>
      </section>
    );
  }

  // ── media-contact-card — verified live #brxe-nglrme / #brxe-vwpszl ──
  // Outer section: bg #fff, no special chrome.
  // Inner card (the 2-col grid container #brxe-vwpszl): bg #f5f5f5,
  // border 1px solid #e0e0e0, border-radius 15px, padding 80px 40px
  // desktop / 20px mobile, display:grid 1fr 1fr desktop / 1fr mobile.
  // LEFT col: photo (650×432, rounded). RIGHT col: H2 + H3 + body.
  // H2: Bebas Neue 55px weight 400, color #1d1d1f, text-align left.
  // H3: DM Sans 28px weight 500, color #212121, margin-top 15px.
  // Body: per-line breaks (Jeremy Lorin / Spirit Media Inc / phone / email).
  if (b.type === 'media-contact-card') {
    const bodyLines = (b.body || '').split('\n').filter(Boolean);
    const emailIdx = bodyLines.findIndex((l: string) => /@/.test(l));
    return (
      <section class="jv-media-contact">
        <div class="jv-media-contact-card">
          <div class="jv-media-contact-photo">
            {b.image && b.image.sanityUrl && (
              <img src={imgUrl(b.image, 800)}
                   width={b.image?.dims?.width || 650}
                   height={b.image?.dims?.height || 432}
                   alt="" loading="lazy" decoding="async" />
            )}
          </div>
          <div class="jv-media-contact-text">
            <h2 class="jv-media-contact-h2">{decodeText(b.heading)}</h2>
            {b.sub && <h3 class="jv-media-contact-h3">{decodeText(b.sub)}</h3>}
            {bodyLines.length > 0 && (
              <p class="jv-media-contact-body">
                {bodyLines.map((line: string, i: number) => (
                  <>
                    {i > 0 && <br />}
                    {i === emailIdx
                      ? <a href={`mailto:${line.trim()}`}>{line}</a>
                      : line}
                  </>
                ))}
              </p>
            )}
          </div>
        </div>
      </section>
    );
  }

  // ── retailer-hero — used for /retailers/ landing hero #brxe-zqgdua.
  // Two-column layout: LEFT = eyebrow + H1 + (desktop-only) book card,
  // RIGHT = book image + (mobile-only) book card + copyright. The "book
  // card" (H3 subtitle + 3-line description) is duplicated in both
  // columns; CSS hides whichever isn't appropriate for the viewport.
  // Source uses the same responsive duplication pattern via Bricks.
  if (b.type === 'retailer-hero') {
    const lines = (b.bodyLines || []) as string[];
    return (
      <section class="rt-hero" id={b.id}>
        <div class="rt-hero-container">
          <div class="rt-hero-left">
            <div class="jv-eyebrow-row">
              <span class="jv-eyebrow-divider" aria-hidden="true"></span>
              <h6 class="jv-eyebrow">{b.eyebrow}</h6>
            </div>
            <h1 class="jv-h1">{decodeText(b.h1)}</h1>
            <div class="rt-hero-card rt-hero-card-desktop" aria-hidden="false">
              {b.subtitle && <h3 class="rt-card-h3">{decodeText(b.subtitle)}</h3>}
              <p class="rt-card-lines">
                {lines.map((line, i) => (
                  <>{i > 0 && <br />}{decodeText(line)}</>
                ))}
              </p>
            </div>
          </div>
          <div class="rt-hero-right">
            {b.image && b.image.sanityUrl && (
              <img class="rt-hero-img"
                   src={imgUrl(b.image, 720)}
                   width={b.image?.dims?.width || 309}
                   height={b.image?.dims?.height || 438}
                   alt={b.image.alt || ''}
                   loading="eager" fetchpriority="high" decoding="async" />
            )}
            <div class="rt-hero-card rt-hero-card-mobile" aria-hidden="true">
              {b.subtitle && <h3 class="rt-card-h3">{decodeText(b.subtitle)}</h3>}
              <p class="rt-card-lines">
                {lines.map((line, i) => (
                  <>{i > 0 && <br />}{decodeText(line)}</>
                ))}
              </p>
            </div>
            {b.copyright && (
              <div class="rt-hero-copyright">
                {b.copyright.split('\n').map((line: string, i: number) => (
                  <>{i > 0 && <br />}{decodeText(line)}</>
                ))}
              </div>
            )}
          </div>
        </div>
      </section>
    );
  }

  // ── image-collage-card — used for "About UCLA" #brxe-c14394 on the
  // Coach Wooden bio page. Mirror of the John Vallely interview-questions
  // collage (3-image staggered overlap, but images LEFT instead of RIGHT
  // and accompanied by an H2 + body rather than a list).
  // Configurable via b.borderColor (CSS var --collage-border) so the
  // staggered white-frame look from interview-questions can ride the
  // same component with UCLA blue here.
  if (b.type === 'image-collage-card') {
    const images = (b.images || []) as any[];
    const borderColor = b.borderColor || '#ffffff';
    const bg = b.bg || '#fafafa';
    // Optional per-instance alignment overrides. `verticalAlign` =
    // align-items on the row container. `headingAlign` = text-align
    // on the H2 at mobile widths (desktop stays left).
    const vAlign = b.verticalAlign || 'flex-start';
    const hAlignMobile = b.headingAlignMobile || b.headingAlign || 'left';
    const styleVars = [
      `--collage-border: ${borderColor}`,
      `--collage-bg: ${bg}`,
      `--collage-align: ${vAlign}`,
      `--collage-h-align-mobile: ${hAlignMobile}`,
    ].join('; ');
    return (
      <section class="jv-collage" id={b.id} style={styleVars}>
        <div class="jv-collage-container">
          <div class="jv-collage-left">
            {images.slice(0, 3).map((im: any, i: number) => {
              if (!im || !im.file) return null;
              const d = im.dims || (() => { try { return dims(im.file); } catch { return { width: 1024, height: 800 }; } })();
              return (
                <img class={`jv-collage-img jv-collage-img-${i + 1}`}
                     src={imgUrl(im, 1024)}
                     width={d.width} height={d.height}
                     alt={im.alt || ''}
                     loading="lazy" decoding="async" />
              );
            })}
          </div>
          <div class="jv-collage-right">
            {b.headingHtml
              ? <h2 class="jv-collage-h2" set:html={b.headingHtml} />
              : (b.heading && <h2 class="jv-collage-h2">{decodeText(b.heading)}</h2>)
            }
            {b.bodyHtml
              ? <div class="jv-collage-body" set:html={b.bodyHtml} />
              : (b.body && <div class="jv-collage-body"><p>{decodeText(b.body)}</p></div>)
            }
          </div>
        </div>
      </section>
    );
  }

  // ── acknowledgements-card — verified live #brxe-ozjayj / #brxe-klreld ──
  // Centered card: 3D book image + italic-serif H2 + verbatim paragraph
  // body. Reuses self-hosted Libre Baskerville italic font that was
  // loaded for the homepage Wooden quote. Card pulses once on first
  // intersection with the viewport (deferred init, IntersectionObserver).
  // Paragraphs come through with literal "<br>" markers preserved from
  // the source (P12, P15, P18, P20 have intra-paragraph line breaks).
  // They render via set:html so the <br>s emit as real breaks; content
  // is static and trusted (no user-supplied HTML).
  if (b.type === 'acknowledgements-card') {
    const paragraphs = (b.paragraphs || []) as string[];
    const img = b.image || null;
    return (
      <section class="jv-ack" id={b.id}>
        <div class="jv-ack-card">
          {img && img.sanityUrl && (
            <img class="jv-ack-book"
                 src={imgUrl(img, 600)}
                 width={img?.dims?.width || 886}
                 height={img?.dims?.height || 1024}
                 alt={img.alt || ''}
                 loading="lazy" decoding="async" />
          )}
          <h2 class="jv-ack-h2">{decodeText(b.heading || 'Acknowledgements')}</h2>
          <div class="jv-ack-body">
            {paragraphs.map((p) => (<p set:html={p} />))}
          </div>
        </div>
      </section>
    );
  }

  // ── interview-questions — verified live #brxe-ferycf ──
  // Layout: centered H2 across the top, then two-column body below.
  // LEFT col (#brxe-pyqwwq) — H3 + numbered list.
  // RIGHT col (#brxe-tpdzmk) — 3 layered images:
  //   img1 (valley_110.jpg) full column width, no margins, no borders
  //   img2 (VipsCafe_24-9) 50% width, margin-top -13px,
  //         border-top/bottom 5px white
  //   img3 (VipsCafe_24-2) 50% width, margin-top -53px,
  //         border-top/bottom 10px white, border-left 10px white
  // Mobile per user spec: drop negative margins + the 50% widths;
  //                        stack full-width with normal gap.
  if (b.type === 'interview-questions') {
    const images = (b.images || []) as any[];
    return (
      <section class="jv-interview" id={b.id}>
        <div class="jv-interview-container">
          <h2 class="jv-interview-h2">{decodeText(b.heading)}</h2>
          <div class="jv-interview-body">
            <div class="jv-interview-left">
              {b.sub && <h3 class="jv-interview-h3">{decodeText(b.sub)}</h3>}
              <ol class="jv-interview-list">
                {b.items.map((q: string) => (<li>{decodeText(q)}</li>))}
              </ol>
            </div>
            <div class="jv-interview-right">
              {images.slice(0, 3).map((im: any, i: number) => {
                if (!im || !im.file) return null;
                const d = im.dims || (() => { try { return dims(im.file); } catch { return { width: 1024, height: 800 }; } })();
                return (
                  <img class={`jv-interview-img jv-interview-img-${i + 1}`}
                       src={imgUrl(im, 1024)}
                       width={d.width} height={d.height}
                       alt={im.alt || ''}
                       loading="lazy" decoding="async" />
                );
              })}
            </div>
          </div>
        </div>
      </section>
    );
  }

  return null;
})}

