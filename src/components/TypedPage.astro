    .jv-collage-h2 { font-size: 55px; line-height: 1; text-align: left; }
  }
  .jv-collage-body {
    margin: 10px 0 20px;
    font-family: 'Roboto', system-ui, sans-serif;
    font-size: 18px;
    line-height: 1.7;
    color: #616161;
  }
  @media (min-width: 768px) {
