  }
  .jv-video-grid {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    flex-wrap: wrap;
    column-gap: 0;
    row-gap: 20px;
  }
  /* Desktop: switch to flex-start so partial last rows (4+2 on Paul,
     4+4+1 on Vallely) stay left-aligned instead of stretching to fill. */
  @media (min-width: 768px) {
    .jv-video-grid { justify-content: flex-start; column-gap: 15px; }
  }
  .jv-video-tile-wrap {
    width: 49%;
  }
  @media (min-width: 768px) {
    /* 4 columns: 24% × 4 + 15px × 3 gaps ≈ 100% */
    .jv-video-tile-wrap { width: 24%; }
  }

  .jv-video-tile {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 300px;
    border: 0;
    border-radius: 20px;
    background-color: #000;
    background-size: cover;
    background-position: bottom center;
    box-shadow: rgba(66, 66, 66, 0.67) 0 0 20px 0;
    cursor: pointer;
    overflow: hidden;
    transition: transform 0.2s ease;
  }
  @media (min-width: 768px) {
    .jv-video-tile { height: 380px; }
  }
  .jv-video-tile:hover {
    transform: translateY(-2px);
  }
  .jv-video-tile:focus-visible {
