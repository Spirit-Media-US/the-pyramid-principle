---
// Typed-block page renderer. Each block in the array has a `type` field
// that dispatches to a section-specific layout. Powers programmatically
// rebuilt pages (john-vallely first; pattern reusable for others).
//
// Block types handled:
//   _meta                — page title/description (no markup)
//   hero-intro           — eyebrow + H1 + body + sidebar image
//   highlight-cards      — 4 callout cards with left-border accent
//   featured-podcasts    — 2 square card links
//   video-popup-grid     — 3x3 YouTube tiles with play-icon overlay
//   dedication-and-players — H2 + body + 2nd H2 + player profile cards
//   media-contact-card   — H2 + H3 + contact text + bg image
//   interview-questions  — H2 + numbered list + image collage
import { srcW } from '../lib/img';

interface Props { blocks: any[]; }
const { blocks } = Astro.props;

function imgUrl(image: any, w = 600): string {
  if (!image) return '';
  if (image.file) return srcW(image.file, w);
  if (image.sanityUrl) return image.sanityUrl;
  return '';
}

// Decode HTML entities (em-dash, curly quotes) that survived parsing
function decodeText(s: string): string {
  return (s || '')
    .replace(/&amp;/g, '&').replace(/&quot;/g, '"').replace(/&apos;|&#39;/g, "'")
    .replace(/&#8217;|&rsquo;/g, '’').replace(/&#8220;|&ldquo;/g, '“').replace(/&#8221;|&rdquo;/g, '”')
    .replace(/&#8211;|&ndash;/g, '–').replace(/&#8212;|&mdash;/g, '—')
    .replace(/&hellip;|&#8230;/g, '…');
}
---
{blocks.map(b => {
  if (b.type === '_meta') return null;

  if (b.type === 'hero-intro') {
    const heroImg = imgUrl(b.image, 700);
    const heroMobile = imgUrl(b.image, 400);
    return (
      <section class="jv-hero">
        <div class="jv-hero-grid">
          <div class="jv-hero-content">
            <p class="jv-eyebrow">{b.eyebrow}</p>
            <h1 class="jv-h1">{b.h1}</h1>
            <p class="jv-body">{decodeText(b.body)}</p>
          </div>
          {b.image && b.image.sanityUrl && (
            <img class="jv-hero-img"
                 src={heroImg}
                 srcset={`${heroMobile} 400w, ${heroImg} 700w`}
                 sizes="(max-width: 768px) 100vw, 500px"
                 width={b.image.dims?.width || 562}
                 height={b.image.dims?.height || 700}
                 alt={b.eyebrow}
                 loading="lazy" decoding="async" />
          )}
        </div>
      </section>
    );
  }

  if (b.type === 'highlight-cards') {
    return (
      <section class="jv-highlights">
        <div class="jv-highlights-grid">
          {b.items.map((text: string) => (
            <div class="jv-highlight-card">{decodeText(text)}</div>
          ))}
        </div>
      </section>
    );
  }

  if (b.type === 'featured-podcasts') {
    return (
      <section class="jv-podcasts">
        <div class="jv-podcasts-container">
          <h2 class="jv-section-h2">{b.heading}</h2>
          <div class="jv-podcast-grid">
            {b.cards.map((c: any) => (
              <a class="jv-podcast-card" href={c.href} target="_blank" rel="noopener noreferrer">
                <img src={imgUrl(c.image, 500)}
                     width={c.image?.dims?.width || 1024}
                     height={c.image?.dims?.height || 1024}
                     alt="Podcast episode" loading="lazy" decoding="async" />
              </a>
            ))}
          </div>
        </div>
      </section>
    );
  }

  if (b.type === 'video-popup-grid') {
    return (
      <section class="jv-videos">
        <div class="jv-videos-container">
          <h2 class="jv-section-h2 jv-videos-h2">{b.heading}</h2>
          <div class="jv-video-grid">
            {b.tiles.map((t: any) => (
              <a class="jv-video-tile"
                 href={`https://www.youtube-nocookie.com/embed/${t.youtubeId}?rel=0&autoplay=1`}
                 data-youtube-id={t.youtubeId}
                 target="_blank" rel="noopener noreferrer"
                 aria-label="Play video">
                <img class="jv-video-poster"
                     src={t.posterCdn}
                     width="640" height="360"
                     alt="" loading="lazy" decoding="async" />
                <span class="jv-play-icon" aria-hidden="true">
                  <svg width="60" height="60" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 14.5v-9l6 4.5-6 4.5z"/></svg>
                </span>
              </a>
            ))}
          </div>
        </div>
      </section>
    );
  }

  if (b.type === 'dedication-and-players') {
    return (
      <section class="jv-dedication">
        <div class="jv-dedication-container">
          <h2 class="jv-section-h2 jv-center">{b.dedicationHeading}</h2>
          <p class="jv-dedication-body">{decodeText(b.dedicationBody)}</p>
          <h2 class="jv-section-h2 jv-center jv-players-h2">{b.playersHeading}</h2>
          <div class="jv-player-grid">
            {b.playerCards.map((p: any) => (
              <a class="jv-player-card" href={p.href} target="_blank" rel="noopener noreferrer">
                {p.image && p.image.sanityUrl && (
                  <img src={imgUrl(p.image, 300)}
                       width={p.image?.dims?.width || 220}
                       height={p.image?.dims?.height || 220}
                       alt={p.name} loading="lazy" decoding="async" />
                )}
                <span class="jv-player-name">{p.name}</span>
              </a>
            ))}
          </div>
        </div>
      </section>
    );
  }

  if (b.type === 'media-contact-card') {
    return (
      <section class="jv-media-contact">
        <div class="jv-media-contact-container">
          {b.image && b.image.sanityUrl && (
            <img class="jv-media-contact-bg" src={imgUrl(b.image, 1200)} alt=""
                 loading="lazy" decoding="async" aria-hidden="true" />
          )}
          <div class="jv-media-contact-card">
            <h2 class="jv-section-h2">{b.heading}</h2>
            {b.sub && <h3 class="jv-section-h3">{b.sub}</h3>}
            <p class="jv-media-contact-body">{decodeText(b.body)}</p>
          </div>
        </div>
      </section>
    );
  }

  if (b.type === 'interview-questions') {
    return (
      <section class="jv-interview">
        <div class="jv-interview-container">
          <div class="jv-interview-text">
            <h2 class="jv-section-h2">{b.heading}</h2>
            {b.sub && <h3 class="jv-section-h3">{b.sub}</h3>}
            <ol class="jv-interview-list">
              {b.items.map((q: string) => (<li>{decodeText(q)}</li>))}
            </ol>
          </div>
          {b.images && b.images.length > 0 && (
            <div class="jv-interview-images">
              {b.images.slice(0, 3).map((im: any) => (
                im && im.sanityUrl ? (
                  <img src={imgUrl(im, 500)} width="400" height="300" alt="" loading="lazy" decoding="async" />
                ) : null
              ))}
            </div>
          )}
        </div>
      </section>
    );
  }

  return null;
})}

<!-- Deferred YouTube lightbox — click .jv-video-tile opens an inline modal -->
<dialog id="yt-lightbox" class="yt-lightbox" aria-label="Video player">
  <button type="button" class="yt-lightbox-close" aria-label="Close">&times;</button>
  <div class="yt-lightbox-frame" id="yt-lightbox-frame"></div>
</dialog>

<script>
  // YouTube lightbox — deferred until first interaction (no above-the-fold cost)
  function initLightbox() {
    if ((window as any)._ytLightbox) return;
    (window as any)._ytLightbox = true;
    const dialog = document.getElementById('yt-lightbox') as HTMLDialogElement | null;
    const frame = document.getElementById('yt-lightbox-frame');
    const closeBtn = dialog?.querySelector('.yt-lightbox-close');
    if (!dialog || !frame) return;
    document.querySelectorAll<HTMLAnchorElement>('.jv-video-tile').forEach(tile => {
      tile.addEventListener('click', (e) => {
        const id = tile.dataset.youtubeId;
        if (!id) return;
        e.preventDefault();
        frame.innerHTML = `<iframe src="https://www.youtube-nocookie.com/embed/${id}?rel=0&autoplay=1" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen style="width:100%;height:100%;border:0;"></iframe>`;
        if (typeof dialog.showModal === 'function') dialog.showModal();
        else dialog.setAttribute('open', '');
      });
    });
    closeBtn?.addEventListener('click', () => {
      frame.innerHTML = '';
      if (typeof dialog.close === 'function') dialog.close();
      else dialog.removeAttribute('open');
    });
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) {
        frame.innerHTML = '';
        if (typeof dialog.close === 'function') dialog.close();
        else dialog.removeAttribute('open');
      }
    });
  }
  ['scroll', 'click', 'touchstart', 'keydown', 'mousemove'].forEach(e =>
    window.addEventListener(e, initLightbox, { once: true, passive: true })
  );
  window.setTimeout(initLightbox, 8000);
</script>

<style is:global>
  /* ── John Vallely page typed-block styles ── */
  /* Hero intro */
  .jv-hero { background: var(--color-bg-section); padding: 48px 0; }
  .jv-hero-grid {
    max-width: var(--container-max);
    margin-inline: auto;
    padding: 0 var(--section-padding-x-mobile);
    display: grid; grid-template-columns: 1fr; gap: 32px; align-items: center;
  }
  @media (min-width: 768px) { .jv-hero-grid { padding: 0 var(--section-padding-x-desktop); } }
  @media (min-width: 1024px) { .jv-hero-grid { grid-template-columns: 1.5fr 1fr; gap: 48px; } }
  .jv-eyebrow {
    font-family: var(--font-heading); font-weight: 700; text-transform: uppercase;
    letter-spacing: 0.04em; font-size: 0.875rem; color: var(--color-author-blue); margin: 0 0 12px;
  }
  .jv-h1 {
    font-family: var(--font-display); font-weight: 400;
    font-size: clamp(2.5rem, 6vw, 4rem); line-height: 1; letter-spacing: 0.01em;
    text-transform: uppercase; color: var(--color-ink); margin: 0 0 24px;
  }
  .jv-body { margin: 0 0 16px; font-size: 1rem; line-height: 1.65; color: var(--color-text); }
  .jv-hero-img {
    width: 100%; max-width: 500px; height: auto; display: block; justify-self: center; border-radius: 8px;
  }

  /* Highlight cards (left-border callouts) */
  .jv-highlights { background: #fff; padding: 48px 0; }
  .jv-highlights-grid {
    max-width: var(--container-max); margin-inline: auto;
    padding: 0 var(--section-padding-x-mobile);
    display: grid; grid-template-columns: 1fr; gap: 16px;
  }
  @media (min-width: 768px) {
    .jv-highlights-grid { padding: 0 var(--section-padding-x-desktop); grid-template-columns: 1fr 1fr; gap: 20px; }
  }
  .jv-highlight-card {
    background: var(--color-bg-section); border-left: 4px solid var(--color-author-blue);
    padding: 20px 24px; font-family: var(--font-heading); font-weight: 700;
    font-size: 0.95rem; line-height: 1.4; color: var(--color-ink);
    text-transform: uppercase; letter-spacing: 0.02em;
  }

  /* Common */
  .jv-section-h2 {
    font-family: var(--font-display); font-weight: 400;
    font-size: clamp(2rem, 4.5vw, 3.4rem); line-height: 1.05;
    letter-spacing: 0.01em; color: var(--color-ink); margin: 0 0 24px;
    text-transform: none;
  }
  .jv-section-h3 {
    font-family: var(--font-heading); font-weight: 700; font-size: 1.1rem;
    color: var(--color-ink-soft); margin: 16px 0 12px;
    text-transform: uppercase; letter-spacing: 0.05em;
  }
  .jv-center { text-align: center; }

  /* Featured Podcasts */
  .jv-podcasts { background: #fff; padding: 48px 0; }
  .jv-podcasts-container {
    max-width: var(--container-max); margin-inline: auto;
    padding: 0 var(--section-padding-x-mobile); text-align: center;
  }
  @media (min-width: 768px) { .jv-podcasts-container { padding: 0 var(--section-padding-x-desktop); } }
  .jv-podcast-grid {
    display: grid; grid-template-columns: 1fr; gap: 24px;
    max-width: 800px; margin: 0 auto;
  }
  @media (min-width: 640px) { .jv-podcast-grid { grid-template-columns: 1fr 1fr; } }
  .jv-podcast-card { display: block; transition: transform 0.2s ease; }
  .jv-podcast-card:hover { transform: translateY(-2px); }
  .jv-podcast-card img {
    width: 100%; height: auto; aspect-ratio: 1 / 1; object-fit: cover;
    border-radius: 8px; display: block;
  }

  /* Video popup grid */
  .jv-videos { background: var(--color-bg-section); padding: 64px 0; }
  .jv-videos-container {
    max-width: var(--container-max); margin-inline: auto;
    padding: 0 var(--section-padding-x-mobile);
  }
  @media (min-width: 768px) { .jv-videos-container { padding: 0 var(--section-padding-x-desktop); } }
  .jv-videos-h2 { text-align: center; }
  .jv-video-grid {
    display: grid; grid-template-columns: 1fr; gap: 16px; margin-top: 32px;
  }
  @media (min-width: 640px) { .jv-video-grid { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1024px) { .jv-video-grid { grid-template-columns: 1fr 1fr 1fr; gap: 20px; } }
  .jv-video-tile {
    position: relative; display: block; background: #000; border-radius: 8px;
    overflow: hidden; aspect-ratio: 16 / 9; cursor: pointer;
  }
  .jv-video-poster {
    width: 100%; height: 100%; object-fit: cover; display: block;
    transition: opacity 0.2s ease, transform 0.3s ease;
  }
  .jv-video-tile:hover .jv-video-poster { opacity: 0.7; transform: scale(1.04); }
  .jv-play-icon {
    position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);
    color: #fff; pointer-events: none;
    filter: drop-shadow(0 2px 6px rgba(0, 0, 0, 0.5));
    transition: transform 0.2s ease;
  }
  .jv-video-tile:hover .jv-play-icon { transform: translate(-50%, -50%) scale(1.1); color: var(--color-brand-yellow); }

  /* Dedication + players */
  .jv-dedication { background: #fff; padding: 64px 0; }
  .jv-dedication-container {
    max-width: 900px; margin-inline: auto;
    padding: 0 var(--section-padding-x-mobile); text-align: center;
  }
  @media (min-width: 768px) { .jv-dedication-container { padding: 0 var(--section-padding-x-desktop); } }
  .jv-dedication-body {
    margin: 0 auto 40px; max-width: 720px; font-size: 1rem; line-height: 1.7; color: var(--color-text);
    text-align: left;
  }
  .jv-players-h2 { font-size: clamp(1.5rem, 3.5vw, 2.25rem); margin-top: 24px; }
  .jv-player-grid {
    display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; margin-top: 32px;
  }
  @media (min-width: 768px) { .jv-player-grid { grid-template-columns: repeat(5, 1fr); } }
  .jv-player-card {
    display: flex; flex-direction: column; align-items: center; gap: 8px;
    text-decoration: none; color: var(--color-ink); transition: transform 0.2s ease;
  }
  .jv-player-card:hover { transform: translateY(-2px); text-decoration: none; }
  .jv-player-card img {
    width: 100%; aspect-ratio: 1 / 1; object-fit: cover; border-radius: 50%; background: var(--color-bg-section);
  }
  .jv-player-name { font-family: var(--font-heading); font-weight: 700; font-size: 0.85rem; text-align: center; }

  /* Media contact card */
  .jv-media-contact { background: var(--color-bg-section); padding: 64px 0; }
  .jv-media-contact-container {
    position: relative; max-width: var(--container-max); margin-inline: auto;
    padding: 0 var(--section-padding-x-mobile);
  }
  @media (min-width: 768px) { .jv-media-contact-container { padding: 0 var(--section-padding-x-desktop); } }
  .jv-media-contact-bg {
    width: 100%; max-height: 360px; object-fit: cover; border-radius: 8px;
    display: block;
  }
  .jv-media-contact-card {
    background: #fff; padding: 32px; border-radius: 8px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
    max-width: 600px; margin: -80px auto 0; position: relative; z-index: 2;
  }
  @media (max-width: 640px) {
    .jv-media-contact-card { margin: 16px auto 0; padding: 24px; }
  }
  .jv-media-contact-body { margin: 0; font-size: 0.95rem; line-height: 1.6; color: var(--color-text); white-space: pre-line; }

  /* Interview questions */
  .jv-interview { background: #fff; padding: 64px 0; }
  .jv-interview-container {
    max-width: var(--container-max); margin-inline: auto;
    padding: 0 var(--section-padding-x-mobile);
    display: grid; grid-template-columns: 1fr; gap: 32px; align-items: start;
  }
  @media (min-width: 768px) { .jv-interview-container { padding: 0 var(--section-padding-x-desktop); } }
  @media (min-width: 1024px) { .jv-interview-container { grid-template-columns: 1.5fr 1fr; gap: 48px; } }
  .jv-interview-list { padding-left: 24px; margin: 16px 0 0; }
  .jv-interview-list li { margin-bottom: 12px; color: var(--color-text); line-height: 1.55; }
  .jv-interview-images { display: flex; flex-direction: column; gap: 16px; }
  .jv-interview-images img {
    width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: cover; border-radius: 8px;
  }

  /* YouTube lightbox */
  .yt-lightbox {
    border: 0; padding: 0; max-width: 95vw; width: 1000px; max-height: 95vh;
    background: #000; border-radius: 8px;
    position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%);
  }
  .yt-lightbox::backdrop { background: rgba(0, 0, 0, 0.85); }
  .yt-lightbox-close {
    position: absolute; top: -40px; right: 0; background: none; border: 0;
    color: #fff; font-size: 36px; cursor: pointer; line-height: 1; padding: 0;
  }
  .yt-lightbox-frame {
    width: 100%; aspect-ratio: 16 / 9; background: #000;
  }
</style>
