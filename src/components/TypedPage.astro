    color: #000;
    text-align: left;
    text-transform: none;
  }

  /* ── Video popup grid (verified #brxe-glibgo + #brxe-ztzinx + #brxe-wdrhlk) ──
     Container: flex-wrap row, column-gap 15px (none on mobile), row-gap 20px.
     Section margin-top 100px desktop / -40px mobile (overlaps prior section).
     Tile: 24% wide desktop / 49% mobile, 380px desktop / 300px mobile tall,
     border-radius 20px, box-shadow rgba(66,66,66,.67) 0 0 20px 0,
     full-bleed YouTube poster as bg-image, play icon centered. */
  .jv-videos {
    background: #fff;
    /* Section owns its own top spacing (Option A pattern). Was
       margin: -40px 0 40px / 100px 0 0 — the negative mobile margin
       pulled the grid into the hero by 40px on every bio page,
       creating the flush look on Wooden. Now: padding-top 40 mobile
       / 80 desktop. Bottom padding preserves the prior 40px gap
       toward the next section on mobile. */
    margin: 0;
    padding: 40px var(--section-padding-x-mobile);
  }
  @media (min-width: 768px) {
    .jv-videos { padding: 80px var(--section-padding-x-desktop) 0; }
  }
  .jv-videos-container {
    max-width: var(--container-max);
    margin-inline: auto;
  }
  .jv-videos-h2 {
