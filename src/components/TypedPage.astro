  /* ── Photo carousel (verified live #brxe-rboxpg) ──
     Live source has margin: -80px 0 0 desktop / -50px mobile, but that's
     closing a Bricks-generated 80px gap that doesn't exist in our Astro
     build. With my H2 banner's 20px margin-bottom as the natural gap,
     margin-top: 0 on the carousel reproduces the live visual spacing.
     Slides 250px tall desktop / 150px mobile, real <img> per slide.
     Arrows 50×50 absolute, color #2196f3, prev left:50px / next right:50px. */
  .jv-photo-carousel {
    position: relative;
    width: 100%;
    margin: 0;
    overflow: hidden;
  }
  .jv-photo-swiper {
    width: 100%;
    overflow: hidden;
  }
  .jv-photo-slide {
    height: 150px;
    overflow: hidden;
  }
  @media (min-width: 768px) {
    .jv-photo-slide { height: 250px; }
  }
  .jv-photo-link {
    display: block;
    width: 100%;
    height: 100%;
    overflow: hidden;
    cursor: zoom-in;
  }
  .jv-photo-link img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
    display: block;
    transition: transform 0.3s ease;
  }
  .jv-photo-link:hover img {
    transform: scale(1.05);
  }
  /* Navigation arrows — vertically centered on slide, Material blue */
  .jv-photo-prev,
  .jv-photo-next {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 10;
    width: 50px;
    height: 50px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 0;
    background: transparent;
    color: rgb(33, 150, 243); /* #2196f3 — Material blue per live DOM */
    cursor: pointer;
    padding: 0;
    transition: opacity 0.2s ease, color 0.2s ease;
  }
  .jv-photo-prev { left: 10px; }
  .jv-photo-next { right: 10px; }
  @media (min-width: 768px) {
    .jv-photo-prev { left: 50px; }
    .jv-photo-next { right: 50px; }
  }
  .jv-photo-prev:hover,
  .jv-photo-next:hover { color: rgb(13, 117, 207); }
  .jv-photo-prev:focus-visible,
  .jv-photo-next:focus-visible {
    outline: 3px solid var(--color-brand-yellow);
    outline-offset: 2px;
    border-radius: 4px;
  }
  .jv-photo-prev svg,
  .jv-photo-next svg { display: block; }
  /* Hide arrows until Swiper has initialized (avoids un-bound clicks) */
  .jv-photo-carousel:not(:has(.swiper-initialized)) .jv-photo-prev,
  .jv-photo-carousel:not(:has(.swiper-initialized)) .jv-photo-next {
    opacity: 0;
    pointer-events: none;
  }

  /* ── stats-card-grid (verified live #brxe-asxjua / #brxe-vizxhf /
