---
// Typed-block page renderer. Each block in the array has a `type` field
// that dispatches to a section-specific layout. Powers programmatically
// rebuilt pages (john-vallely first; pattern reusable for others).
//
// Block types handled:
//   _meta                — page title/description (no markup)
//   hero-intro           — eyebrow + H1 + body + sidebar image
//   highlight-cards      — 4 callout cards with left-border accent
//   featured-podcasts    — 2 square card links
//   video-popup-grid     — 3x3 YouTube tiles with play-icon overlay
//   dedication-and-players — H2 + body + 2nd H2 + player profile cards
//   media-contact-card   — H2 + H3 + contact text + bg image
//   interview-questions  — H2 + numbered list + image collage
import { srcW, dims } from '../lib/img';

interface Props { blocks: any[]; }
const { blocks } = Astro.props;

function imgUrl(image: any, w = 600): string {
  if (!image) return '';
  if (image.file) return srcW(image.file, w);
  if (image.sanityUrl) return image.sanityUrl;
  return '';
}

// Decode HTML entities (em-dash, curly quotes) that survived parsing
function decodeText(s: string): string {
  return (s || '')
    .replace(/&amp;/g, '&').replace(/&quot;/g, '"').replace(/&apos;|&#39;/g, "'")
    .replace(/&#8217;|&rsquo;/g, '’').replace(/&#8220;|&ldquo;/g, '“').replace(/&#8221;|&rdquo;/g, '”')
    .replace(/&#8211;|&ndash;/g, '–').replace(/&#8212;|&mdash;/g, '—')
    .replace(/&hellip;|&#8230;/g, '…');
}
---
{blocks.map(b => {
  if (b.type === '_meta') return null;

  // ── shape-divider — decorative SVG triangle (full width, ~200px) ──
  // Bricks uses this as a slanted edge at the top of a section. Reusable.
  if (b.type === 'shape-divider') {
    const fill = b.fill || '#fafafa';
    return (
      <svg class="jv-shape-divider"
           xmlns="http://www.w3.org/2000/svg"
           preserveAspectRatio="none"
           viewBox="0 0 1200 200"
           aria-hidden="true"
           style={`fill: ${fill};`}>
        <polygon fill-rule="evenodd" points="0 200 1200 0 1200 200"></polygon>
      </svg>
    );
  }

  // ── hero-intro — verified 2-col hero matching live #brxe-63667e ──
  // Left col: eyebrow row + H1 + mobile-only image + body + 4 highlight cards
  // Right col: desktop-only sidebar image
  if (b.type === 'hero-intro') {
    const heroImg = imgUrl(b.image, 700);
    const heroMobile = imgUrl(b.image, 400);
    const imgWidth = b.image?.dims?.width || 562;
    const imgHeight = b.image?.dims?.height || 700;
    const cards = (b.highlightCards || []) as { lines: string[] }[];
    return (
      <section class="jv-hero" id={b.id}>
        <div class="jv-hero-grid">
          <div class="jv-hero-left">
            <div class="jv-eyebrow-row">
              <span class="jv-eyebrow-divider" aria-hidden="true"></span>
              <h6 class="jv-eyebrow">{b.eyebrow}</h6>
            </div>
            <h1 class="jv-h1">{b.h1}</h1>
            {b.image && b.image.sanityUrl && (
              <img class="jv-hero-img-mobile"
                   src={heroMobile}
                   width={imgWidth} height={imgHeight}
                   alt={b.eyebrow}
                   loading="lazy" decoding="async" />
            )}
            {b.bodyHtml
              ? <p class="jv-body" set:html={b.bodyHtml} />
              : <p class="jv-body">{decodeText(b.body)}</p>
            }
            {cards.length > 0 && (
              <div class="jv-highlight-stack">
                {cards.map(c => (
                  <div class="jv-highlight-card">
                    {c.lines.map((line, i) => (
                      <>
                        {i > 0 && <br />}
                        {line}
                      </>
                    ))}
                  </div>
                ))}
              </div>
            )}
          </div>
          {b.image && b.image.sanityUrl && (
            <div class="jv-hero-right">
              <img class="jv-hero-img-desktop"
                   src={heroImg}
                   srcset={`${heroMobile} 400w, ${heroImg} 700w`}
                   sizes="(max-width: 1024px) 100vw, 562px"
                   width={imgWidth} height={imgHeight}
                   alt={b.eyebrow}
                   loading="lazy" decoding="async" />
            </div>
          )}
        </div>
      </section>
    );
  }

  // ── section-h2 — standalone H2 banner used as a section break ──
  // Verified live #brxe-vflqgb: Bebas Neue 55px weight 700, color #000,
  // text-align left, margin 40px 0 20px, full container width.
  // Optional `align: 'center'` for variants like #brxe-najbcz (Retailers).
  if (b.type === 'section-h2') {
    const styleStr = b.align ? `text-align: ${b.align};` : '';
    return (
      <section class="jv-section-h2-banner" id={b.id}>
        <h2 class="jv-section-h2-banner-text" style={styleStr}>{b.text}</h2>
      </section>
    );
  }

  // ── stats-card-grid — verified live #brxe-asxjua (Retailers Section 9,
  // "NBA"). H2 + intro paragraph + N-card grid where each card is a
  // light-gray rounded box with image / colored title / body. Designed
  // to be reused for follow-up "stats / pitch" sections that share
  // this card style.
  if (b.type === 'stats-card-grid') {
    const cards = (b.cards || []) as { image: any; title: string; body: string }[];
    return (
      <section class="jv-stats" id={b.id}>
        <div class="jv-stats-container">
          {b.heading && <h2 class="jv-stats-h2">{decodeText(b.heading)}</h2>}
          {b.intro && <p class="jv-stats-intro">{decodeText(b.intro)}</p>}
          <div class="jv-stats-grid">
            {cards.map(c => {
              const im = c.image || {};
              const d = im.dims || (() => { try { return dims(im.file); } catch { return { width: 612, height: 459 }; } })();
              return (
                <div class="jv-stats-card">
                  {im.sanityUrl && (
                    <img class="jv-stats-img"
                         src={imgUrl(im, 800)}
                         width={d.width} height={d.height}
                         alt={im.alt || c.title || ''}
                         loading="lazy" decoding="async" />
                  )}
                  <h3 class="jv-stats-title">{decodeText(c.title)}</h3>
                  <p class="jv-stats-body">{decodeText(c.body)}</p>
                </div>
              );
            })}
          </div>
        </div>
      </section>
    );
  }

  // ── themed-list-callout — verified live #brxe-wehpoc (Retailers
  // Section 8, "Global Interest"). Three-part section: H2 + ordered
  // list on the left, 3-image staggered collage on the right, then a
  // full-width italic stat callout below both columns. The collage
  // markup mirrors the image-collage-card 3-image pattern but with
  // NO borders on the staggered images (verified). The stat callout
  // (#brxe-hrznsc) is markup-as-H3 in source but semantically a
  // long-form stat paragraph — re-rendered as <p>.
  if (b.type === 'themed-list-callout') {
    const items = (b.listItems || []) as string[];
    const images = (b.images || []) as any[];
    return (
      <section class="jv-gi" id={b.id}>
        <div class="jv-gi-container">
          <div class="jv-gi-grid">
            <div class="jv-gi-left">
              {b.heading && <h2 class="jv-gi-h2">{decodeText(b.heading)}</h2>}
              {items.length > 0 && (
                <ol class="jv-gi-list">
                  {items.map(i => (<li>{decodeText(i)}</li>))}
                </ol>
              )}
            </div>
            <div class="jv-gi-right">
              {images.slice(0, 3).map((im, i) => {
                if (!im || !im.file) return null;
                const d = im.dims || (() => { try { return dims(im.file); } catch { return { width: 1024, height: 600 }; } })();
                return (
                  <img class={`jv-gi-img jv-gi-img-${i + 1}`}
                       src={imgUrl(im, 1024)}
                       width={d.width} height={d.height}
                       alt={im.alt || ''}
                       loading="lazy" decoding="async" />
                );
              })}
            </div>
          </div>
          {b.statCallout && (
            <p class="jv-gi-stat">{decodeText(b.statCallout)}</p>
          )}
        </div>
      </section>
    );
  }

  // ── centered-callout — verified live #brxe-qfoozj (Retailers Section 7,
  // "A Heart-Gripping Story of Championship Resilience"). Centered H2 +
  // body subtitle above a 2-column image strip. Two images sit side-by-side
  // at 50% each on both viewports (verified). Pattern is reusable for any
  // "H2 + lede + side-by-side image pair" section.
  if (b.type === 'centered-callout') {
    const images = (b.images || []) as any[];
    return (
      <section class="jv-cc" id={b.id}>
        <div class="jv-cc-container">
          {b.heading && <h2 class="jv-cc-h2">{decodeText(b.heading)}</h2>}
          {b.body && <p class="jv-cc-body">{decodeText(b.body)}</p>}
          {images.length > 0 && (
            <div class="jv-cc-images">
              {images.map(im => {
                if (!im || !im.file) return null;
                const d = im.dims || (() => { try { return dims(im.file); } catch { return { width: 1250, height: 750 }; } })();
                return (
                  <img class="jv-cc-img"
                       src={imgUrl(im, 1200)}
                       width={d.width} height={d.height}
                       alt={im.alt || ''}
                       loading="lazy" decoding="async" />
                );
              })}
            </div>
          )}
        </div>
      </section>
    );
  }

  // ── translation-grid — verified live #brxe-qwjjpw (Retailers Section 6,
  // "Translation Editions — Coming Soon"). Centered Libre-Baskerville
  // header followed by a 4-card grid (book cover + language label).
  // Each card optionally has a sublabel rendered smaller below the
  // main label (used by the Chinese card for "(Mandarin)" qualifier).
  if (b.type === 'translation-grid') {
    const cards = (b.cards || []) as { label: string; sublabel?: string; image: any }[];
    return (
      <section class="jv-tg" id={b.id}>
        <div class="jv-tg-header">
          {b.heading && <h3 class="jv-tg-heading">{decodeText(b.heading)}</h3>}
        </div>
        <div class="jv-tg-grid">
          {cards.map(c => {
            const im = c.image || {};
            const d = im.dims || (() => { try { return dims(im.file); } catch { return { width: 480, height: 720 }; } })();
            return (
              <div class="jv-tg-card">
                {im.sanityUrl && (
                  <img class="jv-tg-img"
                       src={imgUrl(im, 600)}
                       width={d.width} height={d.height}
                       alt={im.alt || c.label}
                       loading="lazy" decoding="async" />
                )}
                <h3 class="jv-tg-label">{decodeText(c.label)}</h3>
                {c.sublabel && (
                  <p class="jv-tg-sublabel">{decodeText(c.sublabel)}</p>
                )}
              </div>
            );
          })}
        </div>
      </section>
    );
  }

  // ── amazon-marketplaces — verified live #brxe-xodthq / #brxe-dunvhj /
  // #brxe-yqloaa / #brxe-eaupau / #brxe-spkuhj. Retailers section 4.
  // Outer section: full-width white background with a centered outer H2.
  // Inner yellow card (#FFD100, border-radius 10px, padding 25px) holds
  // an inner H2 (Montserrat 20px wt 700 UCLA blue uppercase) and a
  // flex-wrap grid of country buttons. Each button is a .pill-cta-gray
  // (light-gray pill on yellow card — the same component already used
  // for the homepage Free Resources banner).
  if (b.type === 'amazon-marketplaces') {
    const stores = (b.stores || []) as { label: string; href: string }[];
    // Optional per-instance overrides routed through CSS vars so a
    // single block type covers both color palettes used on Retailers:
    //   - Amazon Marketplaces: yellow card, UCLA-blue centered H2
    //   - Other International Retailers: UCLA-blue card, yellow LEFT H2
    const cardBg = b.cardBg || 'var(--color-brand-yellow, #ffd100)';
    const headingColor = b.headingColor || 'var(--color-author-blue, #2774AE)';
    const headingAlign = b.headingAlign || 'center';
    const styleVars = [
      `--amzn-card-bg: ${cardBg}`,
      `--amzn-h-color: ${headingColor}`,
      `--amzn-h-align: ${headingAlign}`,
    ].join('; ');
    return (
      <section class="jv-amzn" id={b.id} style={styleVars}>
        <div class="jv-amzn-container">
          {b.outerHeading && (
            <h2 class="jv-section-h2-banner-text jv-amzn-outer-h2">{decodeText(b.outerHeading)}</h2>
          )}
          <div class="jv-amzn-card">
            {b.innerHeading && (
              <h2 class="jv-amzn-inner-h2">{decodeText(b.innerHeading)}</h2>
            )}
            <div class="jv-amzn-grid">
              {stores.map(s => (
                <a class="pill-cta-gray jv-amzn-btn"
                   href={s.href}
                   target="_blank"
                   rel="noopener noreferrer">{decodeText(s.label)}</a>
              ))}
            </div>
          </div>
        </div>
      </section>
    );
  }

  // ── metadata-list — verified live #brxe-txqwye (Retailers ISBN list).
  // Rows of label/value pairs. Source uses double-H3 markup (Bricks
  // editor quirk); re-rendered here as a semantic <dl>/<dt>/<dd> for
  // accessibility. Label: Montserrat 15px wt 700 uppercase #212121.
  // Value: Montserrat 14-15px wt 400 #424242.
  if (b.type === 'metadata-list') {
    const items = (b.items || []) as { label: string; value: string }[];
    return (
      <section class="jv-meta-list" id={b.id}>
        <dl class="jv-meta-list-inner">
          {items.map(it => (
            <div class="jv-meta-row">
              <dt class="jv-meta-label">{decodeText(it.label)}</dt>
              <dd class="jv-meta-value">{decodeText(it.value)}</dd>
            </div>
          ))}
        </dl>
      </section>
    );
  }

  // ── categories-publisher — verified live #brxe-bgdzcm (Retailers).
  // Two-column on desktop, stacked on mobile.
  // LEFT  : H3 "Look for it under:" + 1-N breadcrumb rows of strings.
  //         Source rendered each crumb as an H3 with an Ion arrow icon
  //         between them. Re-semanticized as <nav><ol> breadcrumbs with
  //         a literal "›" character between crumbs.
  // RIGHT : Publisher logo image + multi-line address/contact block.
  //         Phone line auto-rendered as <a href="tel:…"> for mobile
  //         click-to-call.
  if (b.type === 'categories-publisher') {
    const cats = (b.categories || []) as string[][];
    const pub = b.publisher || {};
    return (
      <section class="jv-cp" id={b.id}>
        <div class="jv-cp-container">
          <div class="jv-cp-left">
            {b.categoriesHeading && (
              <h3 class="jv-cp-heading">{decodeText(b.categoriesHeading)}</h3>
            )}
            {cats.map(crumbs => (
              <nav class="jv-cp-crumbs" aria-label="Book category">
                <ol class="jv-cp-crumbs-ol">
                  {crumbs.map((c, i) => (
                    <>
                      <li class="jv-cp-crumb">{decodeText(c)}</li>
                      {i < crumbs.length - 1 && (
                        <li class="jv-cp-sep" aria-hidden="true">›</li>
                      )}
                    </>
                  ))}
                </ol>
              </nav>
            ))}
          </div>
          <div class="jv-cp-right">
            {pub.logo && pub.logo.sanityUrl && (
              <img class="jv-cp-logo"
                   src={imgUrl(pub.logo, 600)}
                   width={pub.logo?.dims?.width || 300}
                   height={pub.logo?.dims?.height || 51}
                   alt={pub.logo.alt || 'Spirit Media Publishing'}
                   loading="lazy" decoding="async" />
            )}
            {pub.lines && (
              <div class="jv-cp-pubtext">
                {(pub.lines as any[]).map((line, i) => (
                  <>
                    {i > 0 && <br />}
                    {line.type === 'link'
                      ? <a href={line.href} target="_blank" rel="noopener noreferrer">{line.text}</a>
                      : line.type === 'tel'
                        ? <a href={line.href}>{line.text}</a>
                        : line.text}
                  </>
                ))}
              </div>
            )}
          </div>
        </div>
      </section>
    );
  }

  // ── standalone highlight-card (reusable block; can appear at top level) ──
  if (b.type === 'highlight-card') {
    const lines = b.lines || (b.text ? [b.text] : []);
    return (
      <div class="jv-highlight-card jv-highlight-card-standalone">
        {lines.map((line: string, i: number) => (
          <>{i > 0 && <br />}{line}</>
        ))}
      </div>
    );
  }

  // ── legacy block: highlight-cards (array form, kept for back-compat) ──
  if (b.type === 'highlight-cards') {
    return (
      <section class="jv-highlights">
        <div class="jv-highlights-grid">
          {b.items.map((text: string) => (
            <div class="jv-highlight-card">{decodeText(text)}</div>
          ))}
        </div>
      </section>
    );
  }

  if (b.type === 'featured-podcasts') {
    return (
      <section class="jv-podcasts">
        <div class="jv-podcasts-container">
          <h2 class="jv-section-h2">{b.heading}</h2>
          <div class="jv-podcast-grid">
            {b.cards.map((c: any) => (
              <a class="jv-podcast-card" href={c.href} target="_blank" rel="noopener noreferrer">
                <img src={imgUrl(c.image, 500)}
                     width={c.image?.dims?.width || 1024}
                     height={c.image?.dims?.height || 1024}
                     alt="Podcast episode" loading="lazy" decoding="async" />
              </a>
            ))}
          </div>
        </div>
      </section>
    );
  }

  // ── photo-carousel — verified live #brxe-rboxpg ──
  // Swiper.js horizontal carousel: 5/2 slidesPerView desktop/mobile,
  // spaceBetween 5px, loop+autoplay 3s, speed 300ms. Slides are bg-image
  // tiles 250px desktop / 150px mobile. Wrapper <a> opens a PhotoSwipe
  // lightbox with full-res 2560w sources. Section margin -80px top desktop
  // / -50px mobile (pulls into the H2 section above). Arrows: #2196f3,
  // prev left:50px / next right:50px. Init deferred per Trait 5.
  if (b.type === 'photo-carousel') {
    const slides = (b.slides || []).map((s: any) => {
      const thumb = srcW(s.file, 1024);
      const full = srcW(s.file, 2560);
      const d = dims(s.file);
      return { thumb, full, w: d.width, h: d.height, alt: s.alt || '' };
    });
    const cfg = b.config || {};
    return (
      <section class="jv-photo-carousel" id={b.id}
               data-slides-desktop={cfg.slidesPerViewDesktop ?? 5}
               data-slides-mobile={cfg.slidesPerViewMobile ?? 2}
               data-space-between={cfg.spaceBetween ?? 5}
               data-loop={cfg.loop === false ? 'false' : 'true'}
               data-autoplay-delay={cfg.autoplayDelay ?? 3000}
               data-speed={cfg.speed ?? 300}
               data-breakpoint={cfg.breakpoint ?? 991}>
        <div class="swiper jv-photo-swiper">
          <div class="swiper-wrapper">
            {slides.map((s) => (
              <div class="swiper-slide jv-photo-slide">
                <a class="jv-photo-link"
                   href={s.full}
                   data-pswp-src={s.full}
                   data-pswp-width={s.w}
                   data-pswp-height={s.h}
                   target="_blank"
                   rel="noopener noreferrer">
                  <img src={s.thumb}
                       width={s.w} height={s.h}
                       alt={s.alt}
                       loading="lazy" decoding="async" />
                </a>
              </div>
            ))}
          </div>
        </div>
        <button type="button" class="jv-photo-prev" aria-label="Previous photo">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
        </button>
        <button type="button" class="jv-photo-next" aria-label="Next photo">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
        </button>
      </section>
    );
  }

  // ── video-popup-grid — verified live #brxe-glibgo ──
  // 9 tiles, 4-per-row desktop (24% wide), 2-per-row mobile (49% wide).
  // Tile is a <button> (not <a>) with full-bleed YouTube poster as bg-image,
  // play icon centered. Click opens a shared <dialog> modal with autoplay iframe.
  // Modal JS deferred per Trait 5.
  if (b.type === 'video-popup-grid') {
    return (
      <section class="jv-videos" id={b.id}>
        <div class="jv-videos-container">
          {b.heading && <h2 class="jv-section-h2 jv-videos-h2">{b.heading}</h2>}
          <div class="jv-video-grid">
            {b.tiles.map((t: any, i: number) => (
              <div class="jv-video-tile-wrap">
                <button
                  type="button"
                  class="jv-video-tile"
                  data-youtube-id={t.videoId}
                  aria-label={`Play ${t.label || `video ${i + 1}`} of ${b.tiles.length}`}
                  style={`background-image: url(${t.poster});`}
                >
                  <span class="jv-play-icon" aria-hidden="true">
                    <svg width="60" height="60" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 14.5v-9l6 4.5-6 4.5z"/></svg>
                  </span>
                </button>
              </div>
            ))}
          </div>
        </div>
      </section>
    );
  }

  // ── dedication — verified live #brxe-zzvjem ──
  // Standalone section: H2 "DEDICATION" + 4-paragraph body. Single centered
  // flex column. Desktop: margin-top 80px, padding 40px 0, inner container
  // padding 40px 0, body width 900px. Mobile: margin-top 40px, padding 0,
  // inner padding 20px, body width auto. H2: Bebas Neue 55/40px, weight 700,
  // color #1d1d1f. Body: DM Sans 18px desktop / Roboto 16px mobile, color
  // rgb(97,97,97). Body margin: 10px 0 30px desktop, 15px 0 0 mobile.
  if (b.type === 'dedication') {
    const paragraphs = b.paragraphs && b.paragraphs.length
      ? b.paragraphs
      : (b.body ? [b.body] : []);
    return (
      <section class="jv-dedication" id={b.id}>
        <div class="jv-dedication-container">
          <h2 class="jv-dedication-h2">{b.heading || 'DEDICATION'}</h2>
          <div class="jv-dedication-body">
            {paragraphs.map((p: string) => (
              <p>{decodeText(p)}</p>
            ))}
          </div>
        </div>
      </section>
    );
  }

  // ── player-grid — reuses the existing player-card layout ──
  // Split out from the legacy dedication-and-players block.
  if (b.type === 'player-grid') {
    return (
      <section class="jv-players">
        <div class="jv-players-container">
          {b.heading && <h2 class="jv-section-h2 jv-center jv-players-h2">{decodeText(b.heading)}</h2>}
          <div class="jv-player-grid">
            {(b.cards || []).map((p: any) => (
              <a class="jv-player-card" href={p.href} target="_blank" rel="noopener noreferrer">
                {p.image && p.image.sanityUrl && (
                  <img src={imgUrl(p.image, 300)}
                       width={p.image?.dims?.width || 220}
                       height={p.image?.dims?.height || 220}
                       alt={p.name} loading="lazy" decoding="async" />
                )}
                <span class="jv-player-name">{p.name}</span>
              </a>
            ))}
          </div>
        </div>
      </section>
    );
  }

  // ── legacy combined dedication+players (kept for back-compat only) ──
  if (b.type === 'dedication-and-players') {
    return (
      <section class="jv-dedication">
        <div class="jv-dedication-container">
          <h2 class="jv-section-h2 jv-center">{b.dedicationHeading}</h2>
          <p class="jv-dedication-body">{decodeText(b.dedicationBody)}</p>
          <h2 class="jv-section-h2 jv-center jv-players-h2">{b.playersHeading}</h2>
          <div class="jv-player-grid">
            {b.playerCards.map((p: any) => (
              <a class="jv-player-card" href={p.href} target="_blank" rel="noopener noreferrer">
                {p.image && p.image.sanityUrl && (
                  <img src={imgUrl(p.image, 300)}
                       width={p.image?.dims?.width || 220}
                       height={p.image?.dims?.height || 220}
                       alt={p.name} loading="lazy" decoding="async" />
                )}
                <span class="jv-player-name">{p.name}</span>
              </a>
            ))}
          </div>
        </div>
      </section>
    );
  }

  // ── media-contact-card — verified live #brxe-nglrme / #brxe-vwpszl ──
  // Outer section: bg #fff, no special chrome.
  // Inner card (the 2-col grid container #brxe-vwpszl): bg #f5f5f5,
  // border 1px solid #e0e0e0, border-radius 15px, padding 80px 40px
  // desktop / 20px mobile, display:grid 1fr 1fr desktop / 1fr mobile.
  // LEFT col: photo (650×432, rounded). RIGHT col: H2 + H3 + body.
  // H2: Bebas Neue 55px weight 400, color #1d1d1f, text-align left.
  // H3: DM Sans 28px weight 500, color #212121, margin-top 15px.
  // Body: per-line breaks (Jeremy Lorin / Spirit Media Inc / phone / email).
  if (b.type === 'media-contact-card') {
    const bodyLines = (b.body || '').split('\n').filter(Boolean);
    const emailIdx = bodyLines.findIndex((l: string) => /@/.test(l));
    return (
      <section class="jv-media-contact">
        <div class="jv-media-contact-card">
          <div class="jv-media-contact-photo">
            {b.image && b.image.sanityUrl && (
              <img src={imgUrl(b.image, 800)}
                   width={b.image?.dims?.width || 650}
                   height={b.image?.dims?.height || 432}
                   alt="" loading="lazy" decoding="async" />
            )}
          </div>
          <div class="jv-media-contact-text">
            <h2 class="jv-media-contact-h2">{decodeText(b.heading)}</h2>
            {b.sub && <h3 class="jv-media-contact-h3">{decodeText(b.sub)}</h3>}
            {bodyLines.length > 0 && (
              <p class="jv-media-contact-body">
                {bodyLines.map((line: string, i: number) => (
                  <>
                    {i > 0 && <br />}
                    {i === emailIdx
                      ? <a href={`mailto:${line.trim()}`}>{line}</a>
                      : line}
                  </>
                ))}
              </p>
            )}
          </div>
        </div>
      </section>
    );
  }

  // ── retailer-hero — used for /retailers/ landing hero #brxe-zqgdua.
  // Two-column layout: LEFT = eyebrow + H1 + (desktop-only) book card,
  // RIGHT = book image + (mobile-only) book card + copyright. The "book
  // card" (H3 subtitle + 3-line description) is duplicated in both
  // columns; CSS hides whichever isn't appropriate for the viewport.
  // Source uses the same responsive duplication pattern via Bricks.
  if (b.type === 'retailer-hero') {
    const lines = (b.bodyLines || []) as string[];
    return (
      <section class="rt-hero" id={b.id}>
        <div class="rt-hero-container">
          <div class="rt-hero-left">
            <div class="jv-eyebrow-row">
              <span class="jv-eyebrow-divider" aria-hidden="true"></span>
              <h6 class="jv-eyebrow">{b.eyebrow}</h6>
            </div>
            <h1 class="jv-h1">{decodeText(b.h1)}</h1>
            <div class="rt-hero-card rt-hero-card-desktop" aria-hidden="false">
              {b.subtitle && <h3 class="rt-card-h3">{decodeText(b.subtitle)}</h3>}
              <p class="rt-card-lines">
                {lines.map((line, i) => (
                  <>{i > 0 && <br />}{decodeText(line)}</>
                ))}
              </p>
            </div>
          </div>
          <div class="rt-hero-right">
            {b.image && b.image.sanityUrl && (
              <img class="rt-hero-img"
                   src={imgUrl(b.image, 720)}
                   width={b.image?.dims?.width || 309}
                   height={b.image?.dims?.height || 438}
                   alt={b.image.alt || ''}
                   loading="eager" fetchpriority="high" decoding="async" />
            )}
            <div class="rt-hero-card rt-hero-card-mobile" aria-hidden="true">
              {b.subtitle && <h3 class="rt-card-h3">{decodeText(b.subtitle)}</h3>}
              <p class="rt-card-lines">
                {lines.map((line, i) => (
                  <>{i > 0 && <br />}{decodeText(line)}</>
                ))}
              </p>
            </div>
            {b.copyright && (
              <div class="rt-hero-copyright">
                {b.copyright.split('\n').map((line: string, i: number) => (
                  <>{i > 0 && <br />}{decodeText(line)}</>
                ))}
              </div>
            )}
          </div>
        </div>
      </section>
    );
  }

  // ── image-collage-card — used for "About UCLA" #brxe-c14394 on the
  // Coach Wooden bio page. Mirror of the John Vallely interview-questions
  // collage (3-image staggered overlap, but images LEFT instead of RIGHT
  // and accompanied by an H2 + body rather than a list).
  // Configurable via b.borderColor (CSS var --collage-border) so the
  // staggered white-frame look from interview-questions can ride the
  // same component with UCLA blue here.
  if (b.type === 'image-collage-card') {
    const images = (b.images || []) as any[];
    const borderColor = b.borderColor || '#ffffff';
    const bg = b.bg || '#fafafa';
    // Optional per-instance alignment overrides. `verticalAlign` =
    // align-items on the row container. `headingAlign` = text-align
    // on the H2 at mobile widths (desktop stays left).
    const vAlign = b.verticalAlign || 'flex-start';
    const hAlignMobile = b.headingAlignMobile || b.headingAlign || 'left';
    const styleVars = [
      `--collage-border: ${borderColor}`,
      `--collage-bg: ${bg}`,
      `--collage-align: ${vAlign}`,
      `--collage-h-align-mobile: ${hAlignMobile}`,
    ].join('; ');
    return (
      <section class="jv-collage" id={b.id} style={styleVars}>
        <div class="jv-collage-container">
          <div class="jv-collage-left">
            {images.slice(0, 3).map((im: any, i: number) => {
              if (!im || !im.file) return null;
              const d = im.dims || (() => { try { return dims(im.file); } catch { return { width: 1024, height: 800 }; } })();
              return (
                <img class={`jv-collage-img jv-collage-img-${i + 1}`}
                     src={imgUrl(im, 1024)}
                     width={d.width} height={d.height}
                     alt={im.alt || ''}
                     loading="lazy" decoding="async" />
              );
            })}
          </div>
          <div class="jv-collage-right">
            {b.headingHtml
              ? <h2 class="jv-collage-h2" set:html={b.headingHtml} />
              : (b.heading && <h2 class="jv-collage-h2">{decodeText(b.heading)}</h2>)
            }
            {b.bodyHtml
              ? <div class="jv-collage-body" set:html={b.bodyHtml} />
              : (b.body && <div class="jv-collage-body"><p>{decodeText(b.body)}</p></div>)
            }
          </div>
        </div>
      </section>
    );
  }

  // ── acknowledgements-card — verified live #brxe-ozjayj / #brxe-klreld ──
  // Centered card: 3D book image + italic-serif H2 + verbatim paragraph
  // body. Reuses self-hosted Libre Baskerville italic font that was
  // loaded for the homepage Wooden quote. Card pulses once on first
  // intersection with the viewport (deferred init, IntersectionObserver).
  // Paragraphs come through with literal "<br>" markers preserved from
  // the source (P12, P15, P18, P20 have intra-paragraph line breaks).
  // They render via set:html so the <br>s emit as real breaks; content
  // is static and trusted (no user-supplied HTML).
  if (b.type === 'acknowledgements-card') {
    const paragraphs = (b.paragraphs || []) as string[];
    const img = b.image || null;
    return (
      <section class="jv-ack" id={b.id}>
        <div class="jv-ack-card">
          {img && img.sanityUrl && (
            <img class="jv-ack-book"
                 src={imgUrl(img, 600)}
                 width={img?.dims?.width || 886}
                 height={img?.dims?.height || 1024}
                 alt={img.alt || ''}
                 loading="lazy" decoding="async" />
          )}
          <h2 class="jv-ack-h2">{decodeText(b.heading || 'Acknowledgements')}</h2>
          <div class="jv-ack-body">
            {paragraphs.map((p) => (<p set:html={p} />))}
          </div>
        </div>
      </section>
    );
  }

  // ── interview-questions — verified live #brxe-ferycf ──
  // Layout: centered H2 across the top, then two-column body below.
  // LEFT col (#brxe-pyqwwq) — H3 + numbered list.
  // RIGHT col (#brxe-tpdzmk) — 3 layered images:
  //   img1 (valley_110.jpg) full column width, no margins, no borders
  //   img2 (VipsCafe_24-9) 50% width, margin-top -13px,
  //         border-top/bottom 5px white
  //   img3 (VipsCafe_24-2) 50% width, margin-top -53px,
  //         border-top/bottom 10px white, border-left 10px white
  // Mobile per user spec: drop negative margins + the 50% widths;
  //                        stack full-width with normal gap.
  if (b.type === 'interview-questions') {
    const images = (b.images || []) as any[];
    return (
      <section class="jv-interview" id={b.id}>
        <div class="jv-interview-container">
          <h2 class="jv-interview-h2">{decodeText(b.heading)}</h2>
          <div class="jv-interview-body">
            <div class="jv-interview-left">
              {b.sub && <h3 class="jv-interview-h3">{decodeText(b.sub)}</h3>}
              <ol class="jv-interview-list">
                {b.items.map((q: string) => (<li>{decodeText(q)}</li>))}
              </ol>
            </div>
            <div class="jv-interview-right">
              {images.slice(0, 3).map((im: any, i: number) => {
                if (!im || !im.file) return null;
                const d = im.dims || (() => { try { return dims(im.file); } catch { return { width: 1024, height: 800 }; } })();
                return (
                  <img class={`jv-interview-img jv-interview-img-${i + 1}`}
                       src={imgUrl(im, 1024)}
                       width={d.width} height={d.height}
                       alt={im.alt || ''}
                       loading="lazy" decoding="async" />
                );
              })}
            </div>
          </div>
        </div>
      </section>
    );
  }

  return null;
})}

<!-- Minimum Swiper layout CSS — inlined verbatim (NOT routed through Vite's
     CSS pipeline or the async-css transform). Ensures the carousel renders
     correctly on first paint even before the bundled CSS finishes loading. -->
<style is:inline>
  .jv-photo-carousel { position: relative; width: 100%; margin: 0; overflow: hidden; }
  .jv-photo-carousel .swiper { position: relative; overflow: hidden; display: block; padding: 0; z-index: 1; }
  .jv-photo-carousel .swiper-wrapper { position: relative; width: 100%; height: 100%; display: flex; box-sizing: content-box; }
  .jv-photo-carousel .swiper-slide { flex-shrink: 0; width: 100%; height: 100%; position: relative; }
  .jv-photo-carousel .jv-photo-slide { height: 150px; overflow: hidden; }
  @media (min-width: 768px) {
    .jv-photo-carousel .jv-photo-slide { height: 250px; }
  }
  .jv-photo-carousel .jv-photo-link { display: block; width: 100%; height: 100%; overflow: hidden; cursor: zoom-in; }
  .jv-photo-carousel .jv-photo-link img { width: 100%; height: 100%; object-fit: cover; object-position: center; display: block; }
</style>

<!-- Shared YouTube modal — one element used by all 9 video tiles.
     <dialog> for free focus-trap + Esc-to-close + accessibility tree. -->
<dialog id="yt-modal" class="yt-modal" role="dialog" aria-modal="true" aria-label="Video player">
  <button type="button" class="yt-modal-close" aria-label="Close video">&times;</button>
  <div class="yt-modal-frame" id="yt-modal-frame"></div>
</dialog>

<script>
  // Video modal — Trait 5 deferred. Loads on first user interaction OR 8s
  // fallback. Removes the iframe from DOM on close so playback fully stops.
  function initVideoModal() {
    if ((window as any)._ytModal) return;
    (window as any)._ytModal = true;
    const modal = document.getElementById('yt-modal') as HTMLDialogElement | null;
    const frame = document.getElementById('yt-modal-frame');
    const closeBtn = modal?.querySelector('.yt-modal-close') as HTMLElement | null;
    if (!modal || !frame) return;

    function open(videoId: string) {
      if (!frame || !modal) return;
      frame.innerHTML = `<iframe src="https://www.youtube-nocookie.com/embed/${videoId}?autoplay=1&rel=0" title="YouTube video player" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>`;
      if (typeof modal.showModal === 'function') modal.showModal();
      else modal.setAttribute('open', '');
    }
    function close() {
      if (!frame || !modal) return;
      frame.innerHTML = ''; // removing the iframe fully stops playback
      if (typeof modal.close === 'function') modal.close();
      else modal.removeAttribute('open');
    }

    document.querySelectorAll<HTMLButtonElement>('.jv-video-tile').forEach(tile => {
      tile.addEventListener('click', () => {
        const id = tile.dataset.youtubeId;
        if (id) open(id);
      });
    });
    closeBtn?.addEventListener('click', close);
    // Click on backdrop (outside the modal box) closes
    modal.addEventListener('click', (e) => {
      const rect = (modal as HTMLDialogElement).getBoundingClientRect();
      if (e.clientX < rect.left || e.clientX > rect.right || e.clientY < rect.top || e.clientY > rect.bottom) close();
    });
    // Esc closes (native <dialog> behavior fires `cancel` instead of `close`)
    modal.addEventListener('cancel', (e) => { e.preventDefault(); close(); });
  }

  const evs = ['scroll', 'click', 'touchstart', 'keydown', 'mousemove'];
  for (const e of evs) window.addEventListener(e, initVideoModal, { once: true, passive: true });
  window.setTimeout(initVideoModal, 8000);
</script>

<script>
  // Photo carousel — Swiper.js + PhotoSwipe lightbox. Inits on
  // DOMContentLoaded (not deferred to first interaction) because the
  // carousel is a visual element and needs to render correctly from
  // first paint. Swiper + PhotoSwipe are bundled into the page chunk
  // via static imports (~40KB gzip combined). Their CSS is loaded by
  // the async-css build step but the minimum layout CSS is inlined in
  // the component's <style> block so the carousel works even before
  // the async stylesheets resolve.
  import Swiper from 'swiper';
  import { Navigation, Autoplay } from 'swiper/modules';
  import PhotoSwipeLightbox from 'photoswipe/lightbox';
  import 'swiper/css';
  import 'swiper/css/navigation';
  import 'photoswipe/style.css';

  function initPhotoCarousels() {
    if ((window as any)._photoCarousels) return;
    const sections = document.querySelectorAll<HTMLElement>('.jv-photo-carousel');
    if (sections.length === 0) return;
    (window as any)._photoCarousels = true;

    sections.forEach(section => {
      const slidesDesktop = Number(section.dataset.slidesDesktop || 5);
      const slidesMobile = Number(section.dataset.slidesMobile || 2);
      const spaceBetween = Number(section.dataset.spaceBetween || 5);
      const loop = section.dataset.loop !== 'false';
      const autoplayDelay = Number(section.dataset.autoplayDelay || 3000);
      const speed = Number(section.dataset.speed || 300);
      const breakpoint = Number(section.dataset.breakpoint || 991);
      const swiperEl = section.querySelector<HTMLElement>('.jv-photo-swiper');
      const prevEl = section.querySelector<HTMLElement>('.jv-photo-prev');
      const nextEl = section.querySelector<HTMLElement>('.jv-photo-next');
      if (!swiperEl) return;

      new Swiper(swiperEl, {
        modules: [Navigation, Autoplay],
        slidesPerView: slidesMobile,
        spaceBetween,
        loop,
        speed,
        autoplay: { delay: autoplayDelay, disableOnInteraction: true, pauseOnMouseEnter: false },
        navigation: prevEl && nextEl ? { prevEl, nextEl } : undefined,
        breakpoints: {
          [breakpoint]: { slidesPerView: slidesDesktop, spaceBetween },
        },
      });

      // PhotoSwipe lightbox — one instance per carousel section. The
      // lightbox attaches its own click handler via event delegation.
      const lightbox = new PhotoSwipeLightbox({
        gallery: section,
        children: 'a.jv-photo-link',
        pswpModule: () => import('photoswipe'),
      });
      lightbox.init();
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initPhotoCarousels);
  } else {
    initPhotoCarousels();
  }

  // Acknowledgements card — fire the one-shot pulse animation on first
  // viewport intersection. No-op when there's no .jv-ack-card on the page.
  function initAckPulse() {
    const cards = document.querySelectorAll<HTMLElement>('.jv-ack-card');
    if (!cards.length || typeof IntersectionObserver === 'undefined') return;
    const io = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) {
          entry.target.classList.add('jv-ack-pulse-active');
          io.unobserve(entry.target);
        }
      }
    }, { threshold: 0.1 });
    cards.forEach(c => io.observe(c));
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAckPulse);
  } else {
    initAckPulse();
  }
</script>

