  }
  .jv-play-icon svg { width: 64px; height: 64px; display: block; }
  .jv-video-tile:hover .jv-play-icon {
    transform: scale(1.1);
    color: var(--color-brand-yellow);
  }

  /* ── Dedication (verified live #brxe-zzvjem) ──
     Section: bg #fff, margin-top 40px mobile / 80px desktop, padding 0 mobile
     / 40px 0 desktop, flex column align-items center.
     Inner container (#brxe-hziqvi): padding 20px mobile / 40px 0 desktop,
     flex column align/justify center wrap.
     H2 (#brxe-ujrumo): Bebas Neue 40/55px weight 700, color #1d1d1f,
     line-height 1.
     Body (#brxe-kgamgc): width 350px mobile / 900px desktop, max 100%,
     margin-top 15px mobile / 10px desktop, margin-bottom 0 mobile / 30px
     desktop. Mobile font Roboto 16px line-height 1.3. Desktop DM Sans 18px
     line-height 1.7. Color rgb(97,97,97). */
  .jv-dedication {
    background: #fff;
    margin-top: 40px;
    padding: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  @media (min-width: 768px) {
    .jv-dedication { margin-top: 80px; padding: 40px 0; }
  }
  .jv-dedication-container {
    width: 100%;
    max-width: var(--container-max, 1250px);
    margin: 0 auto;
    padding: 20px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
  }
  @media (min-width: 768px) {
    .jv-dedication-container { padding: 40px 0; }
  }
  .jv-dedication-h2 {
    margin: 0;
