---
// Typed-block page renderer. Each block in the array has a `type` field
// that dispatches to a section-specific layout. Powers programmatically
// rebuilt pages (john-vallely first; pattern reusable for others).
//
// Block types handled:
//   _meta                — page title/description (no markup)
//   hero-intro           — eyebrow + H1 + body + sidebar image
//   highlight-cards      — 4 callout cards with left-border accent
//   featured-podcasts    — 2 square card links
//   video-popup-grid     — 3x3 YouTube tiles with play-icon overlay
//   dedication-and-players — H2 + body + 2nd H2 + player profile cards
//   media-contact-card   — H2 + H3 + contact text + bg image
//   interview-questions  — H2 + numbered list + image collage
import { srcW, dims } from '../lib/img';

interface Props { blocks: any[]; }
const { blocks } = Astro.props;

function imgUrl(image: any, w = 600): string {
  if (!image) return '';
  if (image.file) return srcW(image.file, w);
  if (image.sanityUrl) return image.sanityUrl;
  return '';
}

// Decode HTML entities (em-dash, curly quotes) that survived parsing
function decodeText(s: string): string {
  return (s || '')
    .replace(/&amp;/g, '&').replace(/&quot;/g, '"').replace(/&apos;|&#39;/g, "'")
    .replace(/&#8217;|&rsquo;/g, '’').replace(/&#8220;|&ldquo;/g, '“').replace(/&#8221;|&rdquo;/g, '”')
    .replace(/&#8211;|&ndash;/g, '–').replace(/&#8212;|&mdash;/g, '—')
    .replace(/&hellip;|&#8230;/g, '…');
}
---
{blocks.map(b => {
  if (b.type === '_meta') return null;

  // ── shape-divider — decorative SVG triangle (full width, ~200px) ──
  // Bricks uses this as a slanted edge at the top of a section. Reusable.
  if (b.type === 'shape-divider') {
    const fill = b.fill || '#fafafa';
    return (
      <svg class="jv-shape-divider"
           xmlns="http://www.w3.org/2000/svg"
           preserveAspectRatio="none"
           viewBox="0 0 1200 200"
           aria-hidden="true"
           style={`fill: ${fill};`}>
        <polygon fill-rule="evenodd" points="0 200 1200 0 1200 200"></polygon>
      </svg>
    );
  }

  // ── hero-intro — verified 2-col hero matching live #brxe-63667e ──
  // Left col: eyebrow row + H1 + mobile-only image + body + 4 highlight cards
  // Right col: desktop-only sidebar image
  if (b.type === 'hero-intro') {
    const heroImg = imgUrl(b.image, 700);
    const heroMobile = imgUrl(b.image, 400);
    const imgWidth = b.image?.dims?.width || 562;
    const imgHeight = b.image?.dims?.height || 700;
    const cards = (b.highlightCards || []) as { lines: string[] }[];
    return (
      <section class="jv-hero" id={b.id}>
        <div class="jv-hero-grid">
          <div class="jv-hero-left">
            <div class="jv-eyebrow-row">
              <span class="jv-eyebrow-divider" aria-hidden="true"></span>
              <h6 class="jv-eyebrow">{b.eyebrow}</h6>
            </div>
            <h1 class="jv-h1">{b.h1}</h1>
            {b.image && b.image.sanityUrl && (
              <img class="jv-hero-img-mobile"
                   src={heroMobile}
                   width={imgWidth} height={imgHeight}
                   alt={b.eyebrow}
                   loading="lazy" decoding="async" />
            )}
            {b.bodyHtml
              ? <p class="jv-body" set:html={b.bodyHtml} />
              : <p class="jv-body">{decodeText(b.body)}</p>
            }
            {cards.length > 0 && (
              <div class="jv-highlight-stack">
                {cards.map(c => (
                  <div class="jv-highlight-card">
                    {c.lines.map((line, i) => (
                      <>
                        {i > 0 && <br />}
                        {line}
                      </>
                    ))}
                  </div>
                ))}
              </div>
            )}
          </div>
          {b.image && b.image.sanityUrl && (
            <div class="jv-hero-right">
              <img class="jv-hero-img-desktop"
                   src={heroImg}
                   srcset={`${heroMobile} 400w, ${heroImg} 700w`}
                   sizes="(max-width: 1024px) 100vw, 562px"
                   width={imgWidth} height={imgHeight}
                   alt={b.eyebrow}
                   loading="lazy" decoding="async" />
            </div>
          )}
        </div>
      </section>
    );
  }

  // ── section-h2 — standalone H2 banner used as a section break ──
  // Verified live #brxe-vflqgb: Bebas Neue 55px weight 700, color #000,
  // text-align left, margin 40px 0 20px, full container width.
  if (b.type === 'section-h2') {
    return (
      <section class="jv-section-h2-banner" id={b.id}>
        <h2 class="jv-section-h2-banner-text">{b.text}</h2>
      </section>
    );
  }

  // ── standalone highlight-card (reusable block; can appear at top level) ──
  if (b.type === 'highlight-card') {
    const lines = b.lines || (b.text ? [b.text] : []);
    return (
      <div class="jv-highlight-card jv-highlight-card-standalone">
        {lines.map((line: string, i: number) => (
          <>{i > 0 && <br />}{line}</>
        ))}
      </div>
    );
  }

  // ── legacy block: highlight-cards (array form, kept for back-compat) ──
  if (b.type === 'highlight-cards') {
    return (
      <section class="jv-highlights">
        <div class="jv-highlights-grid">
          {b.items.map((text: string) => (
            <div class="jv-highlight-card">{decodeText(text)}</div>
          ))}
        </div>
      </section>
    );
  }

  if (b.type === 'featured-podcasts') {
    return (
      <section class="jv-podcasts">
        <div class="jv-podcasts-container">
          <h2 class="jv-section-h2">{b.heading}</h2>
          <div class="jv-podcast-grid">
            {b.cards.map((c: any) => (
              <a class="jv-podcast-card" href={c.href} target="_blank" rel="noopener noreferrer">
                <img src={imgUrl(c.image, 500)}
                     width={c.image?.dims?.width || 1024}
                     height={c.image?.dims?.height || 1024}
                     alt="Podcast episode" loading="lazy" decoding="async" />
              </a>
            ))}
          </div>
        </div>
      </section>
    );
  }

  // ── photo-carousel — verified live #brxe-rboxpg ──
  // Swiper.js horizontal carousel: 5/2 slidesPerView desktop/mobile,
  // spaceBetween 5px, loop+autoplay 3s, speed 300ms. Slides are bg-image
  // tiles 250px desktop / 150px mobile. Wrapper <a> opens a PhotoSwipe
  // lightbox with full-res 2560w sources. Section margin -80px top desktop
  // / -50px mobile (pulls into the H2 section above). Arrows: #2196f3,
  // prev left:50px / next right:50px. Init deferred per Trait 5.
  if (b.type === 'photo-carousel') {
    const slides = (b.slides || []).map((s: any) => {
      const thumb = srcW(s.file, 1024);
      const full = srcW(s.file, 2560);
      const d = dims(s.file);
      return { thumb, full, w: d.width, h: d.height, alt: s.alt || '' };
    });
    const cfg = b.config || {};
    return (
      <section class="jv-photo-carousel" id={b.id}
               data-slides-desktop={cfg.slidesPerViewDesktop ?? 5}
               data-slides-mobile={cfg.slidesPerViewMobile ?? 2}
               data-space-between={cfg.spaceBetween ?? 5}
               data-loop={cfg.loop === false ? 'false' : 'true'}
               data-autoplay-delay={cfg.autoplayDelay ?? 3000}
               data-speed={cfg.speed ?? 300}
               data-breakpoint={cfg.breakpoint ?? 991}>
        <div class="swiper jv-photo-swiper">
          <div class="swiper-wrapper">
            {slides.map((s) => (
              <div class="swiper-slide jv-photo-slide">
                <a class="jv-photo-link"
                   href={s.full}
                   data-pswp-src={s.full}
                   data-pswp-width={s.w}
                   data-pswp-height={s.h}
                   target="_blank"
                   rel="noopener noreferrer">
                  <img src={s.thumb}
                       width={s.w} height={s.h}
                       alt={s.alt}
                       loading="lazy" decoding="async" />
                </a>
              </div>
            ))}
          </div>
        </div>
        <button type="button" class="jv-photo-prev" aria-label="Previous photo">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
        </button>
        <button type="button" class="jv-photo-next" aria-label="Next photo">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
        </button>
      </section>
    );
  }

  // ── video-popup-grid — verified live #brxe-glibgo ──
  // 9 tiles, 4-per-row desktop (24% wide), 2-per-row mobile (49% wide).
  // Tile is a <button> (not <a>) with full-bleed YouTube poster as bg-image,
  // play icon centered. Click opens a shared <dialog> modal with autoplay iframe.
  // Modal JS deferred per Trait 5.
  if (b.type === 'video-popup-grid') {
    return (
      <section class="jv-videos" id={b.id}>
        <div class="jv-videos-container">
          {b.heading && <h2 class="jv-section-h2 jv-videos-h2">{b.heading}</h2>}
          <div class="jv-video-grid">
            {b.tiles.map((t: any, i: number) => (
              <div class="jv-video-tile-wrap">
                <button
                  type="button"
                  class="jv-video-tile"
                  data-youtube-id={t.videoId}
                  aria-label={`Play ${t.label || `video ${i + 1}`} of ${b.tiles.length}`}
                  style={`background-image: url(${t.poster});`}
                >
                  <span class="jv-play-icon" aria-hidden="true">
                    <svg width="60" height="60" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 14.5v-9l6 4.5-6 4.5z"/></svg>
                  </span>
                </button>
              </div>
            ))}
          </div>
        </div>
      </section>
    );
  }

  // ── dedication — verified live #brxe-zzvjem ──
  // Standalone section: H2 "DEDICATION" + 4-paragraph body. Single centered
  // flex column. Desktop: margin-top 80px, padding 40px 0, inner container
  // padding 40px 0, body width 900px. Mobile: margin-top 40px, padding 0,
  // inner padding 20px, body width auto. H2: Bebas Neue 55/40px, weight 700,
  // color #1d1d1f. Body: DM Sans 18px desktop / Roboto 16px mobile, color
  // rgb(97,97,97). Body margin: 10px 0 30px desktop, 15px 0 0 mobile.
  if (b.type === 'dedication') {
    const paragraphs = b.paragraphs && b.paragraphs.length
      ? b.paragraphs
      : (b.body ? [b.body] : []);
    return (
      <section class="jv-dedication" id={b.id}>
        <div class="jv-dedication-container">
          <h2 class="jv-dedication-h2">{b.heading || 'DEDICATION'}</h2>
          <div class="jv-dedication-body">
            {paragraphs.map((p: string) => (
              <p>{decodeText(p)}</p>
            ))}
          </div>
        </div>
      </section>
    );
  }

  // ── player-grid — reuses the existing player-card layout ──
  // Split out from the legacy dedication-and-players block.
  if (b.type === 'player-grid') {
    return (
      <section class="jv-players">
        <div class="jv-players-container">
          {b.heading && <h2 class="jv-section-h2 jv-center jv-players-h2">{decodeText(b.heading)}</h2>}
          <div class="jv-player-grid">
            {(b.cards || []).map((p: any) => (
              <a class="jv-player-card" href={p.href} target="_blank" rel="noopener noreferrer">
                {p.image && p.image.sanityUrl && (
                  <img src={imgUrl(p.image, 300)}
                       width={p.image?.dims?.width || 220}
                       height={p.image?.dims?.height || 220}
                       alt={p.name} loading="lazy" decoding="async" />
                )}
                <span class="jv-player-name">{p.name}</span>
              </a>
            ))}
          </div>
        </div>
      </section>
    );
  }

  // ── legacy combined dedication+players (kept for back-compat only) ──
  if (b.type === 'dedication-and-players') {
    return (
      <section class="jv-dedication">
        <div class="jv-dedication-container">
          <h2 class="jv-section-h2 jv-center">{b.dedicationHeading}</h2>
          <p class="jv-dedication-body">{decodeText(b.dedicationBody)}</p>
          <h2 class="jv-section-h2 jv-center jv-players-h2">{b.playersHeading}</h2>
          <div class="jv-player-grid">
            {b.playerCards.map((p: any) => (
              <a class="jv-player-card" href={p.href} target="_blank" rel="noopener noreferrer">
                {p.image && p.image.sanityUrl && (
                  <img src={imgUrl(p.image, 300)}
                       width={p.image?.dims?.width || 220}
                       height={p.image?.dims?.height || 220}
                       alt={p.name} loading="lazy" decoding="async" />
                )}
                <span class="jv-player-name">{p.name}</span>
              </a>
            ))}
          </div>
        </div>
      </section>
    );
  }

  // ── media-contact-card — verified live #brxe-nglrme / #brxe-vwpszl ──
  // Outer section: bg #fff, no special chrome.
  // Inner card (the 2-col grid container #brxe-vwpszl): bg #f5f5f5,
  // border 1px solid #e0e0e0, border-radius 15px, padding 80px 40px
  // desktop / 20px mobile, display:grid 1fr 1fr desktop / 1fr mobile.
  // LEFT col: photo (650×432, rounded). RIGHT col: H2 + H3 + body.
  // H2: Bebas Neue 55px weight 400, color #1d1d1f, text-align left.
  // H3: DM Sans 28px weight 500, color #212121, margin-top 15px.
  // Body: per-line breaks (Jeremy Lorin / Spirit Media Inc / phone / email).
  if (b.type === 'media-contact-card') {
    const bodyLines = (b.body || '').split('\n').filter(Boolean);
    const emailIdx = bodyLines.findIndex((l: string) => /@/.test(l));
    return (
      <section class="jv-media-contact">
        <div class="jv-media-contact-card">
          <div class="jv-media-contact-photo">
            {b.image && b.image.sanityUrl && (
              <img src={imgUrl(b.image, 800)}
                   width={b.image?.dims?.width || 650}
                   height={b.image?.dims?.height || 432}
                   alt="" loading="lazy" decoding="async" />
            )}
          </div>
          <div class="jv-media-contact-text">
            <h2 class="jv-media-contact-h2">{decodeText(b.heading)}</h2>
            {b.sub && <h3 class="jv-media-contact-h3">{decodeText(b.sub)}</h3>}
            {bodyLines.length > 0 && (
              <p class="jv-media-contact-body">
                {bodyLines.map((line: string, i: number) => (
                  <>
                    {i > 0 && <br />}
                    {i === emailIdx
                      ? <a href={`mailto:${line.trim()}`}>{line}</a>
                      : line}
                  </>
                ))}
              </p>
            )}
          </div>
        </div>
      </section>
    );
  }

  // ── retailer-hero — used for /retailers/ landing hero #brxe-zqgdua.
  // Two-column layout: LEFT = eyebrow + H1 + (desktop-only) book card,
  // RIGHT = book image + (mobile-only) book card + copyright. The "book
  // card" (H3 subtitle + 3-line description) is duplicated in both
  // columns; CSS hides whichever isn't appropriate for the viewport.
  // Source uses the same responsive duplication pattern via Bricks.
  if (b.type === 'retailer-hero') {
    const lines = (b.bodyLines || []) as string[];
    return (
      <section class="rt-hero" id={b.id}>
        <div class="rt-hero-container">
          <div class="rt-hero-left">
            <div class="jv-eyebrow-row">
              <span class="jv-eyebrow-divider" aria-hidden="true"></span>
              <h6 class="jv-eyebrow">{b.eyebrow}</h6>
            </div>
            <h1 class="jv-h1">{decodeText(b.h1)}</h1>
            <div class="rt-hero-card rt-hero-card-desktop" aria-hidden="false">
              {b.subtitle && <h3 class="rt-card-h3">{decodeText(b.subtitle)}</h3>}
              <p class="rt-card-lines">
                {lines.map((line, i) => (
                  <>{i > 0 && <br />}{decodeText(line)}</>
                ))}
              </p>
            </div>
          </div>
          <div class="rt-hero-right">
            {b.image && b.image.sanityUrl && (
              <img class="rt-hero-img"
                   src={imgUrl(b.image, 720)}
                   width={b.image?.dims?.width || 309}
                   height={b.image?.dims?.height || 438}
                   alt={b.image.alt || ''}
                   loading="eager" fetchpriority="high" decoding="async" />
            )}
            <div class="rt-hero-card rt-hero-card-mobile" aria-hidden="true">
              {b.subtitle && <h3 class="rt-card-h3">{decodeText(b.subtitle)}</h3>}
              <p class="rt-card-lines">
                {lines.map((line, i) => (
                  <>{i > 0 && <br />}{decodeText(line)}</>
                ))}
              </p>
            </div>
            {b.copyright && (
              <div class="rt-hero-copyright">
                {b.copyright.split('\n').map((line: string, i: number) => (
                  <>{i > 0 && <br />}{decodeText(line)}</>
                ))}
              </div>
            )}
          </div>
        </div>
      </section>
    );
  }

  // ── image-collage-card — used for "About UCLA" #brxe-c14394 on the
  // Coach Wooden bio page. Mirror of the John Vallely interview-questions
  // collage (3-image staggered overlap, but images LEFT instead of RIGHT
  // and accompanied by an H2 + body rather than a list).
  // Configurable via b.borderColor (CSS var --collage-border) so the
  // staggered white-frame look from interview-questions can ride the
  // same component with UCLA blue here.
  if (b.type === 'image-collage-card') {
    const images = (b.images || []) as any[];
    const borderColor = b.borderColor || '#ffffff';
    const bg = b.bg || '#fafafa';
    return (
      <section class="jv-collage" id={b.id}
               style={`--collage-border: ${borderColor}; --collage-bg: ${bg};`}>
        <div class="jv-collage-container">
          <div class="jv-collage-left">
            {images.slice(0, 3).map((im: any, i: number) => {
              if (!im || !im.file) return null;
              const d = im.dims || (() => { try { return dims(im.file); } catch { return { width: 1024, height: 800 }; } })();
              return (
                <img class={`jv-collage-img jv-collage-img-${i + 1}`}
                     src={imgUrl(im, 1024)}
                     width={d.width} height={d.height}
                     alt={im.alt || ''}
                     loading="lazy" decoding="async" />
              );
            })}
          </div>
          <div class="jv-collage-right">
            {b.headingHtml
              ? <h2 class="jv-collage-h2" set:html={b.headingHtml} />
              : (b.heading && <h2 class="jv-collage-h2">{decodeText(b.heading)}</h2>)
            }
            {b.bodyHtml
              ? <div class="jv-collage-body" set:html={b.bodyHtml} />
              : (b.body && <div class="jv-collage-body"><p>{decodeText(b.body)}</p></div>)
            }
          </div>
        </div>
      </section>
    );
  }

  // ── acknowledgements-card — verified live #brxe-ozjayj / #brxe-klreld ──
  // Centered card: 3D book image + italic-serif H2 + verbatim paragraph
  // body. Reuses self-hosted Libre Baskerville italic font that was
  // loaded for the homepage Wooden quote. Card pulses once on first
  // intersection with the viewport (deferred init, IntersectionObserver).
  // Paragraphs come through with literal "<br>" markers preserved from
  // the source (P12, P15, P18, P20 have intra-paragraph line breaks).
  // They render via set:html so the <br>s emit as real breaks; content
  // is static and trusted (no user-supplied HTML).
  if (b.type === 'acknowledgements-card') {
    const paragraphs = (b.paragraphs || []) as string[];
    const img = b.image || null;
    return (
      <section class="jv-ack" id={b.id}>
        <div class="jv-ack-card">
          {img && img.sanityUrl && (
            <img class="jv-ack-book"
                 src={imgUrl(img, 600)}
                 width={img?.dims?.width || 886}
                 height={img?.dims?.height || 1024}
                 alt={img.alt || ''}
                 loading="lazy" decoding="async" />
          )}
          <h2 class="jv-ack-h2">{decodeText(b.heading || 'Acknowledgements')}</h2>
          <div class="jv-ack-body">
            {paragraphs.map((p) => (<p set:html={p} />))}
          </div>
        </div>
      </section>
    );
  }

  // ── interview-questions — verified live #brxe-ferycf ──
  // Layout: centered H2 across the top, then two-column body below.
  // LEFT col (#brxe-pyqwwq) — H3 + numbered list.
  // RIGHT col (#brxe-tpdzmk) — 3 layered images:
  //   img1 (valley_110.jpg) full column width, no margins, no borders
  //   img2 (VipsCafe_24-9) 50% width, margin-top -13px,
  //         border-top/bottom 5px white
  //   img3 (VipsCafe_24-2) 50% width, margin-top -53px,
  //         border-top/bottom 10px white, border-left 10px white
  // Mobile per user spec: drop negative margins + the 50% widths;
  //                        stack full-width with normal gap.
  if (b.type === 'interview-questions') {
    const images = (b.images || []) as any[];
    return (
      <section class="jv-interview" id={b.id}>
        <div class="jv-interview-container">
          <h2 class="jv-interview-h2">{decodeText(b.heading)}</h2>
          <div class="jv-interview-body">
            <div class="jv-interview-left">
              {b.sub && <h3 class="jv-interview-h3">{decodeText(b.sub)}</h3>}
              <ol class="jv-interview-list">
                {b.items.map((q: string) => (<li>{decodeText(q)}</li>))}
              </ol>
            </div>
            <div class="jv-interview-right">
              {images.slice(0, 3).map((im: any, i: number) => {
                if (!im || !im.file) return null;
                const d = im.dims || (() => { try { return dims(im.file); } catch { return { width: 1024, height: 800 }; } })();
                return (
                  <img class={`jv-interview-img jv-interview-img-${i + 1}`}
                       src={imgUrl(im, 1024)}
                       width={d.width} height={d.height}
                       alt={im.alt || ''}
                       loading="lazy" decoding="async" />
                );
              })}
            </div>
          </div>
        </div>
      </section>
    );
  }

  return null;
})}

<!-- Minimum Swiper layout CSS — inlined verbatim (NOT routed through Vite's
     CSS pipeline or the async-css transform). Ensures the carousel renders
     correctly on first paint even before the bundled CSS finishes loading. -->
<style is:inline>
  .jv-photo-carousel { position: relative; width: 100%; margin: 0; overflow: hidden; }
  .jv-photo-carousel .swiper { position: relative; overflow: hidden; display: block; padding: 0; z-index: 1; }
  .jv-photo-carousel .swiper-wrapper { position: relative; width: 100%; height: 100%; display: flex; box-sizing: content-box; }
  .jv-photo-carousel .swiper-slide { flex-shrink: 0; width: 100%; height: 100%; position: relative; }
