    max-width: 800px; margin: 0 auto;
  }
  @media (min-width: 640px) { .jv-podcast-grid { grid-template-columns: 1fr 1fr; } }
  .jv-podcast-card { display: block; transition: transform 0.2s ease; }
  .jv-podcast-card:hover { transform: translateY(-2px); }
  .jv-podcast-card img {
    width: 100%; height: auto; aspect-ratio: 1 / 1; object-fit: cover;
    border-radius: 8px; display: block;
  }

  /* ── Section-h2 banner (verified #brxe-vflqgb / #brxe-huvxvb / #brxe-ccqjqa) ──
     Standalone H2 used as a section break. Bebas Neue 55px desktop / 40px mobile
     (40px → fluid clamp), color #000, text-align left, margin 40px 0 20px.
     Mobile container has margin-top: -34px to pull up slightly into prior section. */
  .jv-section-h2-banner {
    padding: 0 var(--section-padding-x-mobile);
    margin-top: -34px;
  }
  @media (min-width: 768px) {
    .jv-section-h2-banner {
