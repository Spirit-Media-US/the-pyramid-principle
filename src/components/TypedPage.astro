      font-family: var(--font-heading);
      font-size: 18px;
      line-height: 1.7;
    }
  }
  .jv-dedication-body p { margin: 0 0 1em; }
  .jv-dedication-body p:last-child { margin-bottom: 0; }

  /* ── Players grid (split-out #brxe-players-grid) ── */
  .jv-players { background: #fff; padding: 32px 0 64px; }
  .jv-players-container {
    max-width: var(--container-max); margin-inline: auto;
