  /* ── Interview questions (verified live #brxe-ferycf) ──
     Section: bg #fff, padding 40px top / 60px bottom mobile,
     40px top / 80px bottom desktop. Container: flex column align center
     on the H2 row, body becomes flex row 50/50 on desktop. */
  .jv-interview {
    background: #fff;
