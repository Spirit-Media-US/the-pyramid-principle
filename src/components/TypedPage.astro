---
// Typed-block page renderer. Each block in the array has a `type` field
// that dispatches to a section-specific layout. Powers programmatically
// rebuilt pages (john-vallely first; pattern reusable for others).
//
// Block types handled:
//   _meta                — page title/description (no markup)
//   hero-intro           — eyebrow + H1 + body + sidebar image
//   highlight-cards      — 4 callout cards with left-border accent
//   featured-podcasts    — 2 square card links
//   video-popup-grid     — 3x3 YouTube tiles with play-icon overlay
//   dedication-and-players — H2 + body + 2nd H2 + player profile cards
//   media-contact-card   — H2 + H3 + contact text + bg image
//   interview-questions  — H2 + numbered list + image collage
import { srcW, dims } from '../lib/img';

interface Props { blocks: any[]; }
const { blocks } = Astro.props;

function imgUrl(image: any, w = 600): string {
  if (!image) return '';
  if (image.file) return srcW(image.file, w);
  if (image.sanityUrl) return image.sanityUrl;
  return '';
}

// Decode HTML entities (em-dash, curly quotes) that survived parsing
function decodeText(s: string): string {
  return (s || '')
    .replace(/&amp;/g, '&').replace(/&quot;/g, '"').replace(/&apos;|&#39;/g, "'")
    .replace(/&#8217;|&rsquo;/g, '’').replace(/&#8220;|&ldquo;/g, '“').replace(/&#8221;|&rdquo;/g, '”')
    .replace(/&#8211;|&ndash;/g, '–').replace(/&#8212;|&mdash;/g, '—')
    .replace(/&hellip;|&#8230;/g, '…');
}
---
{blocks.map(b => {
  if (b.type === '_meta') return null;

  // ── shape-divider — decorative SVG triangle (full width, ~200px) ──
  // Bricks uses this as a slanted edge at the top of a section. Reusable.
  if (b.type === 'shape-divider') {
    const fill = b.fill || '#fafafa';
    return (
      <svg class="jv-shape-divider"
           xmlns="http://www.w3.org/2000/svg"
           preserveAspectRatio="none"
           viewBox="0 0 1200 200"
           aria-hidden="true"
           style={`fill: ${fill};`}>
        <polygon fill-rule="evenodd" points="0 200 1200 0 1200 200"></polygon>
      </svg>
    );
  }

  // ── hero-intro — verified 2-col hero matching live #brxe-63667e ──
  // Left col: eyebrow row + H1 + mobile-only image + body + 4 highlight cards
  // Right col: desktop-only sidebar image
  if (b.type === 'hero-intro') {
    const heroImg = imgUrl(b.image, 700);
    const heroMobile = imgUrl(b.image, 400);
    const imgWidth = b.image?.dims?.width || 562;
    const imgHeight = b.image?.dims?.height || 700;
    const cards = (b.highlightCards || []) as { lines: string[] }[];
    return (
      <section class="jv-hero" id={b.id}>
        <div class="jv-hero-grid">
          <div class="jv-hero-left">
            <div class="jv-eyebrow-row">
              <span class="jv-eyebrow-divider" aria-hidden="true"></span>
              <h6 class="jv-eyebrow">{b.eyebrow}</h6>
            </div>
            <h1 class="jv-h1">{b.h1}</h1>
            {b.image && b.image.sanityUrl && (
              <img class="jv-hero-img-mobile"
                   src={heroMobile}
                   width={imgWidth} height={imgHeight}
                   alt={b.eyebrow}
                   loading="lazy" decoding="async" />
            )}
            <p class="jv-body">{decodeText(b.body)}</p>
            <div class="jv-highlight-stack">
              {cards.map(c => (
                <div class="jv-highlight-card">
                  {c.lines.map((line, i) => (
                    <>
                      {i > 0 && <br />}
                      {line}
                    </>
                  ))}
                </div>
              ))}
            </div>
          </div>
          {b.image && b.image.sanityUrl && (
            <div class="jv-hero-right">
              <img class="jv-hero-img-desktop"
                   src={heroImg}
                   srcset={`${heroMobile} 400w, ${heroImg} 700w`}
                   sizes="(max-width: 1024px) 100vw, 562px"
                   width={imgWidth} height={imgHeight}
                   alt={b.eyebrow}
                   loading="lazy" decoding="async" />
            </div>
          )}
        </div>
      </section>
    );
  }

  // ── section-h2 — standalone H2 banner used as a section break ──
  // Verified live #brxe-vflqgb: Bebas Neue 55px weight 700, color #000,
  // text-align left, margin 40px 0 20px, full container width.
  if (b.type === 'section-h2') {
    return (
      <section class="jv-section-h2-banner" id={b.id}>
        <h2 class="jv-section-h2-banner-text">{b.text}</h2>
      </section>
    );
  }

  // ── standalone highlight-card (reusable block; can appear at top level) ──
  if (b.type === 'highlight-card') {
    const lines = b.lines || (b.text ? [b.text] : []);
    return (
      <div class="jv-highlight-card jv-highlight-card-standalone">
        {lines.map((line: string, i: number) => (
          <>{i > 0 && <br />}{line}</>
        ))}
      </div>
    );
  }

  // ── legacy block: highlight-cards (array form, kept for back-compat) ──
  if (b.type === 'highlight-cards') {
    return (
      <section class="jv-highlights">
        <div class="jv-highlights-grid">
          {b.items.map((text: string) => (
            <div class="jv-highlight-card">{decodeText(text)}</div>
          ))}
        </div>
      </section>
    );
  }

  if (b.type === 'featured-podcasts') {
    return (
      <section class="jv-podcasts">
        <div class="jv-podcasts-container">
          <h2 class="jv-section-h2">{b.heading}</h2>
          <div class="jv-podcast-grid">
            {b.cards.map((c: any) => (
              <a class="jv-podcast-card" href={c.href} target="_blank" rel="noopener noreferrer">
                <img src={imgUrl(c.image, 500)}
                     width={c.image?.dims?.width || 1024}
                     height={c.image?.dims?.height || 1024}
                     alt="Podcast episode" loading="lazy" decoding="async" />
              </a>
            ))}
          </div>
        </div>
      </section>
    );
  }

  // ── photo-carousel — verified live #brxe-rboxpg ──
  // Swiper.js horizontal carousel: 5/2 slidesPerView desktop/mobile,
  // spaceBetween 5px, loop+autoplay 3s, speed 300ms. Slides are bg-image
  // tiles 250px desktop / 150px mobile. Wrapper <a> opens a PhotoSwipe
  // lightbox with full-res 2560w sources. Section margin -80px top desktop
  // / -50px mobile (pulls into the H2 section above). Arrows: #2196f3,
  // prev left:50px / next right:50px. Init deferred per Trait 5.
  if (b.type === 'photo-carousel') {
    const slides = (b.slides || []).map((s: any) => {
      const thumb = srcW(s.file, 1024);
      const full = srcW(s.file, 2560);
      const d = dims(s.file);
      return { thumb, full, w: d.width, h: d.height, alt: s.alt || '' };
    });
    const cfg = b.config || {};
    return (
      <section class="jv-photo-carousel" id={b.id}
               data-slides-desktop={cfg.slidesPerViewDesktop ?? 5}
               data-slides-mobile={cfg.slidesPerViewMobile ?? 2}
               data-space-between={cfg.spaceBetween ?? 5}
               data-loop={cfg.loop === false ? 'false' : 'true'}
               data-autoplay-delay={cfg.autoplayDelay ?? 3000}
               data-speed={cfg.speed ?? 300}
               data-breakpoint={cfg.breakpoint ?? 991}>
        <div class="swiper jv-photo-swiper">
          <div class="swiper-wrapper">
            {slides.map((s) => (
              <div class="swiper-slide jv-photo-slide">
                <a class="jv-photo-link"
                   href={s.full}
                   data-pswp-src={s.full}
                   data-pswp-width={s.w}
                   data-pswp-height={s.h}
                   target="_blank"
                   rel="noopener noreferrer">
                  <img src={s.thumb}
                       width={s.w} height={s.h}
                       alt={s.alt}
                       loading="lazy" decoding="async" />
                </a>
              </div>
            ))}
          </div>
        </div>
        <button type="button" class="jv-photo-prev" aria-label="Previous photo">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
        </button>
        <button type="button" class="jv-photo-next" aria-label="Next photo">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
        </button>
      </section>
    );
  }

  // ── video-popup-grid — verified live #brxe-glibgo ──
  // 9 tiles, 4-per-row desktop (24% wide), 2-per-row mobile (49% wide).
  // Tile is a <button> (not <a>) with full-bleed YouTube poster as bg-image,
  // play icon centered. Click opens a shared <dialog> modal with autoplay iframe.
  // Modal JS deferred per Trait 5.
  if (b.type === 'video-popup-grid') {
    return (
      <section class="jv-videos">
        <div class="jv-videos-container">
          {b.heading && <h2 class="jv-section-h2 jv-videos-h2">{b.heading}</h2>}
          <div class="jv-video-grid">
            {b.tiles.map((t: any, i: number) => (
              <div class="jv-video-tile-wrap">
                <button
                  type="button"
                  class="jv-video-tile"
                  data-youtube-id={t.videoId}
                  aria-label={`Play ${t.label || `video ${i + 1}`} of ${b.tiles.length}`}
                  style={`background-image: url(${t.poster});`}
                >
                  <span class="jv-play-icon" aria-hidden="true">
                    <svg width="60" height="60" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 14.5v-9l6 4.5-6 4.5z"/></svg>
                  </span>
                </button>
              </div>
            ))}
          </div>
        </div>
      </section>
    );
  }

  if (b.type === 'dedication-and-players') {
    return (
      <section class="jv-dedication">
        <div class="jv-dedication-container">
          <h2 class="jv-section-h2 jv-center">{b.dedicationHeading}</h2>
          <p class="jv-dedication-body">{decodeText(b.dedicationBody)}</p>
          <h2 class="jv-section-h2 jv-center jv-players-h2">{b.playersHeading}</h2>
          <div class="jv-player-grid">
            {b.playerCards.map((p: any) => (
              <a class="jv-player-card" href={p.href} target="_blank" rel="noopener noreferrer">
                {p.image && p.image.sanityUrl && (
                  <img src={imgUrl(p.image, 300)}
                       width={p.image?.dims?.width || 220}
                       height={p.image?.dims?.height || 220}
                       alt={p.name} loading="lazy" decoding="async" />
                )}
                <span class="jv-player-name">{p.name}</span>
              </a>
            ))}
          </div>
        </div>
      </section>
    );
  }

  if (b.type === 'media-contact-card') {
    return (
      <section class="jv-media-contact">
        <div class="jv-media-contact-container">
          {b.image && b.image.sanityUrl && (
            <img class="jv-media-contact-bg" src={imgUrl(b.image, 1200)} alt=""
                 loading="lazy" decoding="async" aria-hidden="true" />
          )}
          <div class="jv-media-contact-card">
            <h2 class="jv-section-h2">{b.heading}</h2>
            {b.sub && <h3 class="jv-section-h3">{b.sub}</h3>}
            <p class="jv-media-contact-body">{decodeText(b.body)}</p>
          </div>
        </div>
      </section>
    );
  }

  if (b.type === 'interview-questions') {
    return (
      <section class="jv-interview">
        <div class="jv-interview-container">
          <div class="jv-interview-text">
            <h2 class="jv-section-h2">{b.heading}</h2>
            {b.sub && <h3 class="jv-section-h3">{b.sub}</h3>}
            <ol class="jv-interview-list">
              {b.items.map((q: string) => (<li>{decodeText(q)}</li>))}
            </ol>
          </div>
          {b.images && b.images.length > 0 && (
            <div class="jv-interview-images">
              {b.images.slice(0, 3).map((im: any) => (
                im && im.sanityUrl ? (
                  <img src={imgUrl(im, 500)} width="400" height="300" alt="" loading="lazy" decoding="async" />
                ) : null
              ))}
            </div>
          )}
        </div>
      </section>
    );
  }

  return null;
})}

<!-- Shared YouTube modal — one element used by all 9 video tiles.
     <dialog> for free focus-trap + Esc-to-close + accessibility tree. -->
<dialog id="yt-modal" class="yt-modal" role="dialog" aria-modal="true" aria-label="Video player">
  <button type="button" class="yt-modal-close" aria-label="Close video">&times;</button>
  <div class="yt-modal-frame" id="yt-modal-frame"></div>
</dialog>

<script>
  // Video modal — Trait 5 deferred. Loads on first user interaction OR 8s
  // fallback. Removes the iframe from DOM on close so playback fully stops.
  function initVideoModal() {
    if ((window as any)._ytModal) return;
    (window as any)._ytModal = true;
    const modal = document.getElementById('yt-modal') as HTMLDialogElement | null;
    const frame = document.getElementById('yt-modal-frame');
    const closeBtn = modal?.querySelector('.yt-modal-close') as HTMLElement | null;
    if (!modal || !frame) return;

    function open(videoId: string) {
      if (!frame || !modal) return;
      frame.innerHTML = `<iframe src="https://www.youtube-nocookie.com/embed/${videoId}?autoplay=1&rel=0" title="YouTube video player" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>`;
      if (typeof modal.showModal === 'function') modal.showModal();
      else modal.setAttribute('open', '');
    }
    function close() {
      if (!frame || !modal) return;
      frame.innerHTML = ''; // removing the iframe fully stops playback
      if (typeof modal.close === 'function') modal.close();
      else modal.removeAttribute('open');
    }

    document.querySelectorAll<HTMLButtonElement>('.jv-video-tile').forEach(tile => {
      tile.addEventListener('click', () => {
        const id = tile.dataset.youtubeId;
        if (id) open(id);
      });
    });
    closeBtn?.addEventListener('click', close);
    // Click on backdrop (outside the modal box) closes
    modal.addEventListener('click', (e) => {
      const rect = (modal as HTMLDialogElement).getBoundingClientRect();
      if (e.clientX < rect.left || e.clientX > rect.right || e.clientY < rect.top || e.clientY > rect.bottom) close();
    });
    // Esc closes (native <dialog> behavior fires `cancel` instead of `close`)
    modal.addEventListener('cancel', (e) => { e.preventDefault(); close(); });
  }

  const evs = ['scroll', 'click', 'touchstart', 'keydown', 'mousemove'];
  for (const e of evs) window.addEventListener(e, initVideoModal, { once: true, passive: true });
  window.setTimeout(initVideoModal, 8000);
</script>

<script>
  // Photo carousel — Swiper.js + PhotoSwipe lightbox. Trait 5 deferred init.
  // Imports use Vite's `?url` resolution; everything is tree-shaken to the
  // single carousel module + the lightbox module (~50KB gzip combined).
  async function initPhotoCarousels() {
    if ((window as any)._photoCarousels) return;
    const sections = document.querySelectorAll<HTMLElement>('.jv-photo-carousel');
    if (sections.length === 0) return;
    (window as any)._photoCarousels = true;

    const [{ default: Swiper }, { Navigation, Autoplay }, photoswipe, lightboxMod] = await Promise.all([
      import('swiper'),
      import('swiper/modules'),
      import('photoswipe'),
      import('photoswipe/lightbox'),
    ]);
    // Swiper bundled CSS (one of the two import-styles supported by the
    // package — `swiper/css` is the entry exposed by package.json#exports).
    await Promise.all([
      // @ts-expect-error – CSS side-effect imports are valid for Vite
      import('swiper/css'),
      // @ts-expect-error
      import('swiper/css/navigation'),
      // @ts-expect-error
      import('photoswipe/style.css'),
    ]);
    const PhotoSwipeLightbox = (lightboxMod as any).default;

    sections.forEach(section => {
      const slidesDesktop = Number(section.dataset.slidesDesktop || 5);
      const slidesMobile = Number(section.dataset.slidesMobile || 2);
      const spaceBetween = Number(section.dataset.spaceBetween || 5);
      const loop = section.dataset.loop !== 'false';
      const autoplayDelay = Number(section.dataset.autoplayDelay || 3000);
      const speed = Number(section.dataset.speed || 300);
      const breakpoint = Number(section.dataset.breakpoint || 991);
      const swiperEl = section.querySelector<HTMLElement>('.jv-photo-swiper');
      const prevEl = section.querySelector<HTMLElement>('.jv-photo-prev');
      const nextEl = section.querySelector<HTMLElement>('.jv-photo-next');
      if (!swiperEl) return;

      new Swiper(swiperEl, {
        modules: [Navigation, Autoplay],
        slidesPerView: slidesMobile,
        spaceBetween,
        loop,
        speed,
        autoplay: { delay: autoplayDelay, disableOnInteraction: true, pauseOnMouseEnter: false },
        navigation: prevEl && nextEl ? { prevEl, nextEl } : undefined,
        breakpoints: {
          [breakpoint]: { slidesPerView: slidesDesktop, spaceBetween },
        },
      });

      // PhotoSwipe lightbox — one instance per carousel section.
      const lightbox = new PhotoSwipeLightbox({
        gallery: section,
        children: 'a.jv-photo-link',
        pswpModule: () => Promise.resolve(photoswipe),
      });
      lightbox.init();
    });
  }

  const pcEvs = ['scroll', 'click', 'touchstart', 'keydown', 'mousemove'];
  for (const e of pcEvs) window.addEventListener(e, initPhotoCarousels, { once: true, passive: true });
  window.setTimeout(initPhotoCarousels, 8000);
</script>

<style is:global>
  /* ── Decorative SVG shape divider ── */
  .jv-shape-divider {
    display: block;
    width: 100%;
    height: 80px;
  }
  @media (min-width: 768px) {
    .jv-shape-divider { height: 200px; }
  }

  /* ── John Vallely hero (verified live DOM #brxe-63667e) ── */
  .jv-hero { background: #fff; padding: 40px 20px; }
  @media (min-width: 768px) { .jv-hero { padding: 80px 0; } }
  .jv-hero-grid {
    max-width: var(--container-max);
    margin-inline: auto;
    padding: 0 var(--section-padding-x-mobile);
    display: grid; grid-template-columns: 1fr;
    gap: 40px;
    align-items: flex-start;
  }
  @media (min-width: 768px) { .jv-hero-grid { padding: 0 var(--section-padding-x-desktop); } }
  @media (min-width: 1024px) { .jv-hero-grid { grid-template-columns: 1fr 1fr; gap: 65px; } }

  .jv-hero-left { display: flex; flex-direction: column; min-width: 0; }
  .jv-hero-right {
    display: none;
    align-items: center;
    justify-content: center;
  }
  @media (min-width: 1024px) { .jv-hero-right { display: flex; } }

  /* Eyebrow row: [— short divider] H6 inline, vertically centered */
  .jv-eyebrow-row {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 10px;
    margin-bottom: 20px;
  }
  .jv-eyebrow-divider {
    flex-shrink: 0;
    width: 40px;
    height: 0;
    border-top: 1px solid rgb(97, 97, 97);
  }
  .jv-eyebrow {
    margin: 0;
    font-family: 'Montserrat', system-ui, sans-serif;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-size: 15px;
    color: rgb(97, 97, 97);
    line-height: 1.3;
  }

  /* H1: Bebas Neue, 50px mobile / 60px desktop, color #000 (per source) */
  .jv-h1 {
    margin: 0 0 10px;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 50px;
    line-height: 1;
    letter-spacing: 0.01em;
    text-transform: none;
    color: #000;
  }
  @media (min-width: 768px) { .jv-h1 { font-size: 60px; } }

  /* Mobile-only hero image */
  .jv-hero-img-mobile {
    display: block;
    width: 100%;
    max-width: 460px;
    height: auto;
    margin: 20px auto;
    border-radius: 5px;
  }
  @media (min-width: 1024px) { .jv-hero-img-mobile { display: none; } }

  /* Desktop sidebar image (right column) */
  .jv-hero-img-desktop {
    width: 100%;
    max-width: 562px;
    height: auto;
    display: block;
    border-radius: 5px;
  }

  /* Body P: DM Sans 18px desktop, 16px mobile */
  .jv-body {
    margin: 10px 0 20px;
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: 16px;
    line-height: 1.7;
    color: var(--color-text);
  }
  @media (min-width: 768px) { .jv-body { font-size: 18px; line-height: 1.7; } }

  /* Highlight card stack — 4 callouts, 10px gap between */
  .jv-highlight-stack {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin: 10px 0 0;
  }
  /* Highlight card — verified live DOM #brxe-kdqabc:
     bg #fff, border-left 5px solid #2774AE (UCLA blue), padding 0 0 0 40px,
     box-shadow rgb(224,224,224) 1px 1px 2px 1px. Inner text: Montserrat,
     color #696969, font-size 16px, line-height 27.2px, margin 20px 0 (top/bot). */
  .jv-highlight-card {
    background: #fff;
    border-left: 5px solid var(--color-author-blue);
    padding: 20px 20px 20px 40px;
    box-shadow: rgb(224, 224, 224) 1px 1px 2px 1px;
    font-family: 'Montserrat', system-ui, sans-serif;
    font-weight: 400;
    font-size: 16px;
    line-height: 1.7;
    color: rgb(105, 105, 105); /* #696969 */
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }
  /* Mobile variant per source: 1px solid #e0e0e0 border all around with
     asymmetric border-radius, lighter bg, no left-only border, color #424242 */
  @media (max-width: 478px) {
    .jv-highlight-card {
      background: #f5f5f5;
      border: 1px solid #e0e0e0;
      border-left: 1px solid #e0e0e0;
      border-top-left-radius: 25px;
      border-bottom-right-radius: 25px;
      box-shadow: none;
      color: #424242;
      padding: 20px;
    }
  }

  /* Common */
  .jv-section-h2 {
    font-family: var(--font-display); font-weight: 400;
    font-size: clamp(2rem, 4.5vw, 3.4rem); line-height: 1.05;
    letter-spacing: 0.01em; color: var(--color-ink); margin: 0 0 24px;
    text-transform: none;
  }
  .jv-section-h3 {
    font-family: var(--font-heading); font-weight: 700; font-size: 1.1rem;
    color: var(--color-ink-soft); margin: 16px 0 12px;
    text-transform: uppercase; letter-spacing: 0.05em;
  }
  .jv-center { text-align: center; }

  /* Featured Podcasts */
  .jv-podcasts { background: #fff; padding: 48px 0; }
  .jv-podcasts-container {
    max-width: var(--container-max); margin-inline: auto;
    padding: 0 var(--section-padding-x-mobile); text-align: center;
