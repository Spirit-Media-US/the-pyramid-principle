---
// LogoCarousel — Splide.js carousel matching the original Bricks
// SplideExtensions config exactly. Used by StructuredPage when it encounters
// a `press-carousel` block, and reusable for future logo strips.
//
// Splide config (matches the live source):
//   type:           'loop'
//   perPage:        5  (desktop)
//   perMove:        1  (desktop)
//   gap:            '3px'
//   height:         '310px'  (desktop)
//   speed:          400  (transition ms)
//   autoplay:       true
//   interval:       3000
//   pauseOnHover:   false
//   pauseOnFocus:   false
//   arrows:         true
//   pagination:     false
//   direction:      'ltr'
//   mediaQuery:     'max'
//   breakpoints:    { 478: { perPage: 2, perMove: 2, height: '180px' } }
//
// Splide is loaded via dynamic import on first user interaction (or 8s
// fallback) — Trait 5 deferred third-party pattern. Hero paints first.
import { srcW } from '../lib/img';

interface Slide { file: string; href: string; }

interface Props {
  slides: Slide[];
  ariaLabel?: string;
  altPattern?: string;
  fullBleed?: boolean;
}
const { slides, ariaLabel = 'Logo carousel', altPattern = 'Logo', fullBleed = true } = Astro.props;
---
<section class:list={['splide', 'press-carousel-section', fullBleed && 'lc-full-bleed']} aria-roledescription="carousel" aria-label={ariaLabel}>
  <div class="splide__track">
    <ul class="splide__list">
      {slides.map((s, i) => (
        <li class="splide__slide">
          <a href={s.href} target="_blank" rel="noopener noreferrer">
            <img src={srcW(s.file, 400)} alt={`${altPattern} ${i + 1}`} width="200" height="142" loading="lazy" decoding="async" />
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  /* Full-bleed breakout — section spans 100vw regardless of parent container */
  .press-carousel-section.lc-full-bleed {
    width: 100vw;
    margin-left: calc(50% - 50vw);
    margin-right: calc(50% - 50vw);
    background: #fff;
  }

  /* Splide slide cell — generous whitespace, no borders, logos centered.
     The Bricks original uses height: 310px desktop / 180px mobile (controlled
     by Splide via inline track height). We add slide-internal padding for
     the "logo wall" breathing room. */
  .splide__slide {
    display: flex !important;
    align-items: center;
    justify-content: center;
    padding: 24px;
    background: #fff;
  }
  @media (min-width: 640px) {
    .splide__slide { padding: 32px; }
  }
  @media (min-width: 1024px) {
    .splide__slide { padding: 40px 48px; }
  }
  .splide__slide a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
  }
  .splide__slide img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
  }

  /* Splide arrows — override default look to match SMP design tokens */
  .splide__arrow {
    background: rgba(255, 255, 255, 0.95);
    width: 44px;
    height: 44px;
    border-radius: 999px;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.14);
    opacity: 1;
    transition: background 0.15s ease;
  }
  .splide__arrow:hover { background: var(--color-brand-yellow); }
  .splide__arrow svg { fill: var(--color-ink-soft); width: 18px; height: 18px; }
  .splide__arrow:hover svg { fill: var(--color-ink); }
  .splide__arrow--prev { left: 12px; }
  .splide__arrow--next { right: 12px; }
  @media (min-width: 640px) {
    .splide__arrow--prev { left: 20px; }
    .splide__arrow--next { right: 20px; }
  }
  .splide__arrow:disabled { opacity: 0.4; }
</style>

<script>
  // Deferred Splide load — Trait 5 pattern. Splide initializes on first user
  // interaction OR 8s fallback, so the hero paints before this fires.
  async function initSplide() {
    if ((window as any)._splideLoaded) return;
    (window as any)._splideLoaded = true;
    const carousels = document.querySelectorAll<HTMLElement>('.press-carousel-section');
    if (carousels.length === 0) return;
    const [{ default: Splide }] = await Promise.all([
      import('@splidejs/splide'),
      import('@splidejs/splide/css'),
    ]);
    for (const el of carousels) {
      new Splide(el, {
        type:         'loop',
        perPage:      5,
        perMove:      1,
        gap:          '3px',
        height:       '310px',
        speed:        400,
        autoplay:     true,
        interval:     3000,
        pauseOnHover: false,
        pauseOnFocus: false,
        arrows:       true,
        pagination:   false,
        direction:    'ltr',
        mediaQuery:   'max',
        breakpoints: {
          478: {
            perPage: 2,
            perMove: 2,
            height:  '180px',
          },
        },
      }).mount();
    }
  }

  // Defer until first user interaction; 8s setTimeout fallback so autoplay
  // eventually starts even on idle pages.
  const events = ['scroll', 'click', 'touchstart', 'keydown', 'mousemove'];
  for (const e of events) {
    window.addEventListener(e, initSplide, { once: true, passive: true });
  }
  window.setTimeout(initSplide, 8000);
</script>
